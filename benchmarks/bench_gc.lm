// GC 压力测试基准
func bench_many_objects(n) {
    for (i = 0; i < n; i = i + 1) {
        s = "string_" + i;
        arr = [i, i+1, i+2];
        m = {"a": i, "b": i+1}
}
    return n;
}
func bench_large_arrays(n) {
    total = 0;
    for (i = 0; i < n; i = i + 1) {
        arr = [];
        for (j = 0; j < 1000; j = j + 1) {
            append(arr, j);
}
        total += len(arr)
}
    return total;
}
func bench_large_maps(n) {
    total = 0;
    for (i = 0; i < n; i = i + 1) {
        m = {}
        for (j = 0; j < 500; j = j + 1) {
            m["k" + j] = j
}
        total += len(m)
}
    return total;
}
func bench_churn(n) {
    // 快速创建销毁对象，测试 GC 效率
    for (i = 0; i < n; i = i + 1) {
        a = [1, 2, 3];
        b = {"x": 1}
        c = "hello";
        d = a[0] + b["x"] + len(c);
}
    return n;
}
print("=== GC benchmarks ===");

t0 = timestamp_ms();
r1 = bench_many_objects(10000);
t1 = timestamp_ms();
print("many_objects 10000: " + r1 + " time: " + ((t1-t0)/1000.0) + "s");

t0 = timestamp_ms();
r2 = bench_large_arrays(100);
t1 = timestamp_ms();
print("large_arrays 100x1000: total=" + r2 + " time: " + ((t1-t0)/1000.0) + "s");

t0 = timestamp_ms();
r3 = bench_churn(50000);
t1 = timestamp_ms();
print("churn 50000: " + r3 + " time: " + ((t1-t0)/1000.0) + "s");

print("=== GC done ===");
