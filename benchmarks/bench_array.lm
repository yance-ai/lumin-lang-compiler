// ============================================================
// bench_array.lm — 小数组创建/访问基准（栈分配+标量替换收益）
// 包含两种模式：
//   A) 只读常量数组 → 标量替换完全命中（免堆分配）
//   B) 读写变量数组 → 标量替换未命中（栈分配/正常分配）
// 迭代 100 万次
// ============================================================

func bench_array(iter) {
    acc = 0;
    for (i = 0; i < iter; i = i + 1) {
        // ---- 模式 A：只读常量小数组（标量替换命中）----
        a = [1, 2, 3, 4, 5];
        v = a[0] + a[1] * i + a[2] + a[3] * (i + 1) + a[4];
        acc = acc + v + len(a);

        // ---- 模式 B：读写变量小数组（标量替换未命中）----
        b = [i, i + 1, i + 2, i + 3];
        b[0] = b[0] + 10;
        b[2] = b[2] + b[1];
        acc = acc + b[0] + b[1] + b[2] + b[3] + len(b);
    }
    return acc;
}

before = gc_count();
result = bench_array(1000000);
after = gc_count();

print("bench_array result=" + result);
print("gc_delta=" + (after - before));
