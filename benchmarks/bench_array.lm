// 数组操作基准测试
func bench_array_create(n) {
    arr = [];
    for (i = 0; i < n; i = i + 1) {
        append(arr, i);
}
    return len(arr);
}
func bench_array_iterate(n) {
    arr = [];
    for i = 0; i < n; i++ do append(arr, i) end
    sum = 0;
    for (i = 0; i < len(arr); i = i + 1) {
        sum += arr[i]
}
    return sum;
}
func bench_array_insert(n) {
    arr = [0, 1, 2, 3, 4];
    for (i = 0; i < n; i = i + 1) {
        insert(arr, 2, i);
}
    return len(arr);
}
func bench_array_sort(n) {
    arr = [];
    for (i = 0; i < n; i = i + 1) {
        append(arr, n - i);
}
    sort(arr);
    return arr[0] + arr[len(arr)-1];
}
func bench_2d_array(n) {
    matrix = [];
    for (i = 0; i < n; i = i + 1) {
        row = [];
        for (j = 0; j < n; j = j + 1) {
            append(row, i * n + j);
}
        append(matrix, row);
}
    sum = 0;
    for (i = 0; i < n; i = i + 1) {
        for (j = 0; j < n; j = j + 1) {
            sum += matrix[i][j]
}
}
    return sum;
}
print("=== array benchmarks ===");

t0 = timestamp_ms();
r1 = bench_array_create(50000);
t1 = timestamp_ms();
print("create 50000: len=" + r1 + " time: " + ((t1-t0)/1000.0) + "s");

t0 = timestamp_ms();
r2 = bench_array_iterate(100000);
t1 = timestamp_ms();
print("iterate 100000: sum=" + r2 + " time: " + ((t1-t0)/1000.0) + "s");

t0 = timestamp_ms();
r3 = bench_array_sort(10000);
t1 = timestamp_ms();
print("sort 10000: first+last=" + r3 + " time: " + ((t1-t0)/1000.0) + "s");

t0 = timestamp_ms();
r4 = bench_2d_array(100);
t1 = timestamp_ms();
print("2d 100x100: sum=" + r4 + " time: " + ((t1-t0)/1000.0) + "s");

print("=== array done ===");
