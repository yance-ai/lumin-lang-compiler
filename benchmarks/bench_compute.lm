// 计算密集型基准测试
func fib(n) { if (n < 2) { return n; } return fib(n-1) + fib(n-2); }

func is_prime(n) {
    if (n < 2) { return false; }
    if (n == 2) { return true; }
    if (n % 2 == 0) { return false; }
    for (i = 3; i * i <= n; i += 2) {
        if (n % i == 0) { return false; }
    }
    return true;
}

func count_primes(limit) {
    count = 0;
    for (i = 2; i < limit; i = i + 1) {
        if (is_prime(i)) { count++; }
    }
    return count;
}

func ackermann(m, n) {
    if (m == 0) { return n + 1; }
    if (n == 0) { return ackermann(m-1, 1); }
    return ackermann(m-1, ackermann(m, n-1));
}

print("=== compute benchmarks ===");

t0 = timestamp_ms();
r1 = fib(35);
t1 = timestamp_ms();
print("fib(35) = " + r1 + " time: " + ((t1-t0)/1000.0) + "s");

t0 = timestamp_ms();
r2 = count_primes(100000);
t1 = timestamp_ms();
print("primes below 100000: " + r2 + " time: " + ((t1-t0)/1000.0) + "s");

t0 = timestamp_ms();
r3 = ackermann(3, 8);
t1 = timestamp_ms();
print("ackermann(3,8) = " + r3 + " time: " + ((t1-t0)/1000.0) + "s");

print("=== compute done ===");
