// 映射操作基准测试
func bench_map_create(n) {
    m = {}
    for (i = 0; i < n; i = i + 1) {
        m["key_" + i] = i
}
    return len(m);
}
func bench_map_lookup(n) {
    m = {}
    for (i = 0; i < n; i = i + 1) {
        m["key_" + i] = i
}
    sum = 0;
    for (i = 0; i < n; i = i + 1) {
        sum += m["key_" + i]
}
    return sum;
}
func bench_map_iterate(n) {
    m = {}
    for (i = 0; i < n; i = i + 1) {
        m["key_" + i] = i
}
    sum = 0;
    keys = map_keys(m);
    for (i = 0; i < len(keys); i = i + 1) {
        sum += m[keys[i]]
}
    return sum;
}
func bench_map_delete(n) {
    m = {}
    for (i = 0; i < n; i = i + 1) {
        m["key_" + i] = i
}
    for (i = 0; i < n; i += 2) {
        delete(m, "key_" + i);
}
    return len(m);
}
print("=== map benchmarks ===");

t0 = timestamp_ms();
r1 = bench_map_create(20000);
t1 = timestamp_ms();
print("create 20000: len=" + r1 + " time: " + ((t1-t0)/1000.0) + "s");

t0 = timestamp_ms();
r2 = bench_map_lookup(20000);
t1 = timestamp_ms();
print("lookup 20000: sum=" + r2 + " time: " + ((t1-t0)/1000.0) + "s");

t0 = timestamp_ms();
r3 = bench_map_iterate(10000);
t1 = timestamp_ms();
print("iterate 10000: sum=" + r3 + " time: " + ((t1-t0)/1000.0) + "s");

t0 = timestamp_ms();
r4 = bench_map_delete(10000);
t1 = timestamp_ms();
print("delete half 10000: remaining=" + r4 + " time: " + ((t1-t0)/1000.0) + "s");

print("=== map done ===");
