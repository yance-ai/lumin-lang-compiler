// 数学运算基准测试
func bench_arithmetic(n) {
    sum = 0;
    for (i = 0; i < n; i = i + 1) {
        sum = sum + i * 2 - i / 3 + i % 7;
    }
    return sum;
}

func bench_float(n) {
    sum = 0.0;
    for (i = 0; i < n; i = i + 1) {
        x = i * 1.5;
        sum = sum + x * x - sqrt(x) + abs(x - 100.0);
    }
    return sum;
}

func bench_math_funcs(n) {
    sum = 0.0;
    for (i = 1; i < n; i = i + 1) {
        x = i * 1.0;
        sum += floor(x) + ceil(x / 2.0) + sqrt(x);
    }
    return sum;
}

print("=== math benchmarks ===");

t0 = timestamp_ms();
r1 = bench_arithmetic(500000);
t1 = timestamp_ms();
print("arithmetic 500K: sum=" + r1 + " time: " + ((t1-t0)/1000.0) + "s");

t0 = timestamp_ms();
r2 = bench_float(200000);
t1 = timestamp_ms();
print("float 200K: sum=" + r2 + " time: " + ((t1-t0)/1000.0) + "s");

t0 = timestamp_ms();
r3 = bench_math_funcs(100000);
t1 = timestamp_ms();
print("math_funcs 100K: sum=" + r3 + " time: " + ((t1-t0)/1000.0) + "s");

print("=== math done ===");
