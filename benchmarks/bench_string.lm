// ============================================================
// bench_string.lm — 字符串创建/拼接基准（SSO 收益场景）
// 短字符串 <=22 字节走 SSO 免堆分配；>22 字节走堆分配
// 迭代 100 万次，混合短/长字符串创建与拼接
// ============================================================

func bench_string(iter) {
    acc = 0;
    for (i = 0; i < iter; i = i + 1) {
        // 短字符串（<=22 字节，SSO 内联）
        s1 = "hello_" + i;
        // 稍长字符串（>22 字节，堆分配）
        s2 = "this_is_a_longer_string_" + i + "_tail";
        // 拼接产生新字符串
        s3 = s1 + ":" + s2;
        // 用 len() 累加，防止编译器消除死代码
        acc = acc + len(s1) + len(s2) + len(s3);
    }
    return acc;
}

before = gc_count();
result = bench_string(1000000);
after = gc_count();

print("bench_string result=" + result);
print("gc_delta=" + (after - before));
