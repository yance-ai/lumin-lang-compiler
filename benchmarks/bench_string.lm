// 字符串处理基准测试
func bench_concat(n) {
    s = "";
    for (i = 0; i < n; i = i + 1) {
        s = s + "x";
}
    return len(s);
}
func bench_template(n) {
    total = 0;
    for (i = 0; i < n; i = i + 1) {
        s = f"item-{i}-value";
        total += len(s)
}
    return total;
}
func bench_split(n) {
    s = "a,b,c,d,e,f,g,h,i,j";
    total = 0;
    for (i = 0; i < n; i = i + 1) {
        parts = split(s, ",");
        total += len(parts)
}
    return total;
}
func bench_substring(n) {
    s = "The quick brown fox jumps over the lazy dog";
    total = 0;
    for (i = 0; i < n; i = i + 1) {
        for (j = 0; j < len(s) - 5; j = j + 1) {
            sub = substring(s, j, j + 5);
            total += len(sub)
}
}
    return total;
}
print("=== string benchmarks ===");

t0 = timestamp_ms();
r1 = bench_concat(10000);
t1 = timestamp_ms();
print("concat 10000: len=" + r1 + " time: " + ((t1-t0)/1000.0) + "s");

t0 = timestamp_ms();
r2 = bench_template(10000);
t1 = timestamp_ms();
print("template 10000: total=" + r2 + " time: " + ((t1-t0)/1000.0) + "s");

t0 = timestamp_ms();
r3 = bench_split(5000);
t1 = timestamp_ms();
print("split 5000: total=" + r3 + " time: " + ((t1-t0)/1000.0) + "s");

print("=== string done ===");
