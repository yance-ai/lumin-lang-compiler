// ============================================================
// gc_stw_bench.lm — 增量标记 STW 停顿测量基准
//
// 测量内容：
//   1. major_pause：构建大存活对象图后触发 Major GC，测单次 STW 停顿
//      （增量模式：初始 STW + 并发标记 + 最终 STW；全量模式：单次大 STW）
//   2. churn_small：大量小对象 churn，测 Minor GC 停顿分布
//   3. big_array / big_map：大容器分配
//   4. multithreaded：多线程 churn
//
// 用法：
//   LUMIN_GC_STATS=1 ./bin/lumin benchmarks/gc_stw_bench.lm
//   stderr 每行 GC 停顿（us）由 run_stw_bench.sh 解析 P50/P99/max。
// ============================================================

// ---- 构建一个存活 N 个元素的对象图（挂在全局 root 上）----
func build_live_graph(n) {
    root = [];
    for (i = 0; i < n; i = i + 1) {
        // 每个元素是一个小 map，增加对象图复杂度
        m = {};
        m["id"] = i;
        m["tag"] = "node_" + i + "_pad_pad_pad_pad_pad";
        m["sibling"] = i * 2;
        root.add(m);
    }
    return root;
}

// ---- Major GC 单次停顿测量：持有大存活集，触发一次 Major ----
func measure_major_pause() {
    live = build_live_graph(20000);   // 持有 2 万个存活 map
    gc_collect();                    // 预热一次 Major，稳定阈值
    s0 = gc_stw_ns();
    t0 = timestamp_ms();
    gc_collect();                    // 测量这次 Major
    t1 = timestamp_ms();
    s1 = gc_stw_ns();
    // live 必须继续被引用，否则被回收
    print("SCENARIO major_pause live=" + len(live) + " wall_ms=" + (t1 - t0) + " stw_us=" + ((s1 - s0) / 1000));
    return live;
}

// ---- 大量小对象 churn（触发 Minor GC）----
func churn_small(iter) {
    acc = 0;
    for (i = 0; i < iter; i = i + 1) {
        s = "tmp_" + i + "_pad_pad_pad_pad_pad_pad";
        arr = [i, i + 1, i + 2, i + 3, i + 4];
        acc = acc + len(s) + arr[0] + arr[4];
    }
    return acc;
}

// ---- 大数组 churn ----
func churn_big_array(iter, n) {
    acc = 0;
    for (i = 0; i < iter; i = i + 1) {
        a = [];
        for (j = 0; j < n; j = j + 1) { a.add(j); }
        acc = acc + a[0] + a[n - 1] + len(a);
        a = null;
    }
    return acc;
}

// ---- 多线程 churn ----
func mt_worker(id) {
    keeper = [];
    for (k = 0; k < 30; k = k + 1) {
        keeper.add("keep_" + id + "_" + k + "_pad_pad_pad_pad");
    }
    acc = 0;
    for (i = 0; i < 2000; i = i + 1) {
        s = "tmp_" + id + "_" + i + "_pad_pad_pad_pad";
        a = [id, i, id + i, i * 2];
        acc = acc + len(s) + a[0] + a[3];
        if (i % 400 == 0) { gc_collect(); }
    }
    return acc;
}

func run_churn(name, iter) {
    s0 = gc_stw_ns();
    t0 = timestamp_ms();
    r = churn_small(iter);
    t1 = timestamp_ms();
    s1 = gc_stw_ns();
    print("SCENARIO " + name + " result=" + r + " wall_ms=" + (t1 - t0) + " stw_us=" + ((s1 - s0) / 1000));
}

// ---- 预热 ----
warm = 0;
for (i = 0; i < 10000; i = i + 1) { warm = warm + i; }
gc_collect();

// ---- 测量 ----
measure_major_pause();
run_churn("churn_small", 40000);

s0 = gc_stw_ns();
t0 = timestamp_ms();
ba = churn_big_array(50, 1500);
t1 = timestamp_ms();
s1 = gc_stw_ns();
print("SCENARIO big_array result=" + ba + " wall_ms=" + (t1 - t0) + " stw_us=" + ((s1 - s0) / 1000));

t0 = timestamp_ms();
s0 = gc_stw_ns();
tids = [];
for (t = 0; t < 4; t = t + 1) { tids.add(thread(mt_worker, t)); }
mt_ok = 0;
for (t = 0; t < 4; t = t + 1) { if (thread_join(tids[t]) < 0) { mt_ok = 1; } }
gc_collect();
s1 = gc_stw_ns();
t1 = timestamp_ms();
print("SCENARIO multithreaded fail=" + mt_ok + " wall_ms=" + (t1 - t0) + " stw_us=" + ((s1 - s0) / 1000));

print("BENCH DONE total_stw_us=" + (gc_stw_ns() / 1000));
