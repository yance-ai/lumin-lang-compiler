// 默认参数值测试
func greet(name, greeting="Hello") {
    print(greeting + ", " + name + "!");
}

func power(base, exp=2) {
    result = 1;
    for(i = 0; i < exp; i++) {
        result = result * base;
    }
    return result;
}

func make_point(x=0, y=0, z=0) {
    return [x, y, z];
}

// 测试1: 全部使用默认值
print("=== Test 1: all defaults ===");
greet("World");  // 应该输出 "Hello, World!"

// 测试2: 覆盖默认值
print("=== Test 2: override default ===");
greet("World", "Hi");  // 应该输出 "Hi, World!"

// 测试3: 数值默认值
print("=== Test 3: numeric default ===");
print(power(3));      // 应该输出 9 (3^2)
print(power(3, 3));   // 应该输出 27 (3^3)

// 测试4: 多个默认值
print("=== Test 4: multiple defaults ===");
print(make_point());           // 应该输出 [0, 0, 0]
print(make_point(1));          // 应该输出 [1, 0, 0]
print(make_point(1, 2));       // 应该输出 [1, 2, 0]
print(make_point(1, 2, 3));    // 应该输出 [1, 2, 3]

// 测试5: 默认值与普通参数混合
print("=== Test 5: mixed params ===");
func concat(a, b="default", c="end") {
    return a + "-" + b + "-" + c;
}
print(concat("start"));               // start-default-end
print(concat("start", "middle"));     // start-middle-end
print(concat("start", "middle", "tail")); // start-middle-tail

print("=== All default param tests passed ===");
