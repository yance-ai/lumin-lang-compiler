// ============================================
// 生成器边界测试 - 覆盖各种边界场景
// ============================================

print("=== 1. 空生成器（没有 yield）===");
gen func empty_gen() {
    print("empty gen body");
}
eg = empty_gen();
r1 = next(eg);
print("first next:", r1);
r2 = next(eg);
print("second next:", r2);
print("empty gen done");

print("");
print("=== 2. 生成器耗尽后再次 next() ===");
gen func finite_gen() {
    yield 1;
    yield 2;
}
fg = finite_gen();
print("next1:", next(fg));
print("next2:", next(fg));
print("next3 (exhausted):", next(fg));
print("next4 (exhausted):", next(fg));
print("finite gen done");

print("");
print("=== 3. 无限生成器（用条件终止）===");
gen func infinite_gen() {
    i = 0;
    while(true) {
        yield i;
        i = i + 1;
    }
}
ig = infinite_gen();
sum = 0;
for(j = 0; j < 5; j = j + 1) {
    v = next(ig);
    sum = sum + v;
    print("infinite next:", v);
}
print("infinite sum:", sum);
print("infinite gen done");

print("");
print("=== 4. 深层嵌套（3层）===");
gen func level3() {
    yield 100;
    yield 200;
}
gen func level2() {
    g3 = level3();
    v = next(g3);
    yield v;
    v = next(g3);
    yield v;
    yield 300;
}
gen func level1() {
    g2 = level2();
    v = next(g2);
    yield v;
    v = next(g2);
    yield v;
    v = next(g2);
    yield v;
    yield 400;
}
l1 = level1();
print("nest1:", next(l1));
print("nest2:", next(l1));
print("nest3:", next(l1));
print("nest4:", next(l1));
print("nest5 (exhausted):", next(l1));
print("deep nest done");

print("");
print("=== 5. 生成器在 try-catch 中 ===");
gen func gen_try_catch() {
    try {
        yield 1;
        err = {"message": "test error"};
        throw err;
        yield 2;
    } catch (e) {
        print("caught in gen");
        yield 3;
    }
    yield 4;
}
gtc = gen_try_catch();
print("tc1:", next(gtc));
print("tc2:", next(gtc));
print("tc3:", next(gtc));
print("tc4 (exhausted):", next(gtc));
print("try-catch gen done");

print("");
print("=== 6. 生成器在 try-finally 中 ===");
gen func gen_try_finally() {
    try {
        yield 1;
        yield 2;
    } finally {
        print("finally executed");
    }
    yield 3;
}
gtf = gen_try_finally();
print("tf1:", next(gtf));
print("tf2:", next(gtf));
print("tf3:", next(gtf));
print("tf4 (exhausted):", next(gtf));
print("try-finally gen done");

print("");
print("=== 7. 生成器在 try-catch-finally 中 ===");
gen func gen_full_try() {
    try {
        yield 1;
        err = {"message": "full try error"};
        throw err;
    } catch (e) {
        print("catch in full try");
        yield 2;
    } finally {
        print("finally in full try");
    }
    yield 3;
}
gft = gen_full_try();
print("ft1:", next(gft));
print("ft2:", next(gft));
print("ft3:", next(gft));
print("ft4 (exhausted):", next(gft));
print("full try gen done");

print("");
print("=== 8. 生成器外部 try-catch 捕获生成器异常 ===");
gen func gen_throw_out() {
    yield 1;
    err = {"message": "uncaught error"};
    throw err;
    yield 2;
}
gto = gen_throw_out();
try {
    print("out1:", next(gto));
    print("out2:", next(gto));
} catch (e) {
    print("caught outside");
}
print("external catch done");

print("");
print("=== 9. 生成器 send/receive（Python 风格：send 恢复执行并返回下一个 yield 值）===");
gen func gen_echo() {
    while(true) {
        v = receive();
        yield v;
    }
}
ge = gen_echo();
next(ge);  // 启动生成器，执行到 receive()，返回 null
r1 = send(ge, "hello");  // send 恢复执行，receive() 返回 "hello"，yield "hello"
print("echo1:", r1);
r2 = send(ge, 42);  // send 恢复执行，receive() 返回 42，yield 42
print("echo2:", r2);
print("send/receive done");

print("");
print("=== 10. 生成器作为参数传递 ===");
gen func gen_source() {
    yield 10;
    yield 20;
    yield 30;
}
func consume_gen(g) {
    total = 0;
    v = next(g);
    while(v != null) {
        total = total + v;
        v = next(g);
    }
    return total;
}
gs = gen_source();
result = consume_gen(gs);
print("gen as arg result:", result);
print("gen as arg done");

print("");
print("=== 11. 生成器在 for-each 中使用 ===");
gen func gen_range() {
    for(i = 0; i < 3; i = i + 1) {
        yield i * 10;
    }
}
gr = gen_range();
for v in gr {
    print("for-each gen:", v);
}
print("for-each gen done");

print("");
print("=== 12. 生成器提前终止（break）===");
gen func gen_early() {
    yield 1;
    yield 2;
    yield 3;
}
gea = gen_early();
for v in gea {
    print("early:", v);
    if(v == 2) {
        break;
    }
}
print("early break done");

print("");
print("=== ALL GENERATOR BOUNDARY TESTS PASSED ===");
