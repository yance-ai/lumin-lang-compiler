// ============ 标量替换（Scalar Replacement）全场景测试 ============
// 运行：./bin/lumyr tests/scalar_replacement_test.lm
// 编译：./bin/lumyr -c tests/scalar_replacement_test.lm -o /tmp/srt && /tmp/srt

// ---- 1. 固定下标小数组：拆解为标量局部变量 ----
func arr_scalar() {
    a = [1, 2, 3];
    print(a[0]);  // 1
    print(a[1]);  // 2
    print(a[2]);  // 3
    a[1] = 5;
    print(a[1]);  // 5
    print(a[0] + a[1] + a[2]);  // 1+5+3=9
}
before = gc_count();
arr_scalar();
after = gc_count();
print("arr_scalar_low=" + ((after - before) < 20));  // 双通道优化不同，范围断言

// ---- 2. 固定键小 map：拆解为标量局部变量 ----
func map_scalar() {
    m = {"x": 10, "y": 20};
    print(m["x"]);  // 10
    print(m["y"]);  // 20
    m["x"] = 99;
    print(m["x"]);  // 99
}
before2 = gc_count();
map_scalar();
after2 = gc_count();
print("map_scalar_low=" + ((after2 - before2) < 20));

// ---- 3. 只做 len() 的数组：len 直接替换为常量 ----
func len_only() {
    a = [1, 2, 3, 4, 5];
    print(len(a));  // 5
}
before3 = gc_count();
len_only();
after3 = gc_count();
print("len_only_low=" + ((after3 - before3) < 20));

// ---- 4. 反例：动态下标不触发标量替换（回退栈/堆分配） ----
func dynamic_index() {
    a = [10, 20, 30];
    i = 1;
    print(a[i]);  // 20（动态下标，不标量替换）
}
dynamic_index();

// ---- 5. 反例：数组传参不触发标量替换 ----
func take_arr(arr) {
    return arr[0];
}
func pass_arr() {
    a = [100, 200];
    print(take_arr(a));  // 100
}
pass_arr();

// ---- 6. 反例：return 数组不触发标量替换 ----
func return_arr() {
    a = [1, 2, 3];
    return a;
}
r = return_arr();
print(r[0] + r[1] + r[2]);  // 6

// ---- 7. 反例：多次赋值不触发标量替换 ----
func multi_assign() {
    a = [1, 2, 3];
    print(a[0]);  // 1
    a = [4, 5, 6];
    print(a[0]);  // 4
}
multi_assign();

// ---- 8. 数组元素是变量（非字面量）仍可标量替换 ----
func var_elements() {
    x = 10;
    y = 20;
    a = [x, y, x + y];
    print(a[0]);  // 10
    print(a[1]);  // 20
    print(a[2]);  // 30
    a[2] = 99;
    print(a[2]);  // 99
}
before8 = gc_count();
var_elements();
after8 = gc_count();
print("var_elem_low=" + ((after8 - before8) < 20));

// ---- 9. map 值是表达式仍可标量替换 ----
func map_expr_values() {
    base = 5;
    m = {"a": base, "b": base * 2};
    print(m["a"]);  // 5
    print(m["b"]);  // 10
    m["b"] = 100;
    print(m["b"]);  // 100
}
before9 = gc_count();
map_expr_values();
after9 = gc_count();
print("map_expr_low=" + ((after9 - before9) < 20));

// ---- 10. 反例：越界访问不触发标量替换（分析阶段检测到下标 >= len，回退堆/栈分配）
// 注：越界访问会抛出运行时错误，此处仅作为反例说明，不实际执行
// func out_of_bounds() {
//     a = [1, 2, 3];
//     print(a[5]);  // 下标5 >= 3，不标量替换，回退正常分配
// }

print("ALL_DONE");
