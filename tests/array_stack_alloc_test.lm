// ============ 数组栈分配（逃逸分析驱动）全场景测试 ============
// 运行：./bin/lumin tests/array_stack_alloc_test.lm
// 编译：./bin/lumin -c tests/array_stack_alloc_test.lm -o /tmp/asat && /tmp/asat
// 双通道输出必须逐行一致

// ---- 1. 不逃逸数组：函数内创建使用后丢弃 ----
func nonescaping_basic() {
    a = [1, 2, 3];
    b = [4, 5, 6];
    print(a[0] + b[2]);  // 7
    print(len(a));        // 3
}
nonescaping_basic();

// ---- 2. 逃逸数组：return ----
func escape_return() {
    a = [10, 20, 30];
    return a;
}
r = escape_return();
print(r[1]);  // 20
print(len(r));  // 3

// ---- 3. 逃逸数组：顶层赋值给变量（main中所有变量为全局） ----
g_arr = [100, 200];
print(g_arr[0]);  // 100
print(g_arr[1]);  // 200
g_arr[0] = 999;
print(g_arr[0]);  // 999

// ---- 4. 数组拷贝：引用语义（b = a 共享同一 ValueArray） ----
func copy_refsem() {
    a = [1, 2, 3];
    b = a;
    b[0] = 99;
    print(a[0]);  // 99（a和b共享）
    print(b[0]);  // 99
    print(len(a));  // 3
}
copy_refsem();

// ---- 5. 数组扩容：.add() 循环 ----
func expand_add() {
    a = [];
    for (i = 0; i < 10; i = i + 1) {
        a.add(i * 2);
    }
    print(len(a));  // 10
    print(a[9]);    // 18
    print(a[0]);    // 0
}
expand_add();

// ---- 6. 嵌套数组 ----
func nested_arrays() {
    a = [[1, 2], [3, 4], [5, 6]];
    print(a[0][1]);  // 2
    print(a[2][0]);  // 5
    print(len(a));    // 3
    print(len(a[1])); // 2
}
nested_arrays();

// ---- 7. 数组含字符串 ----
func array_with_strings() {
    a = ["hello", "world", "lumin"];
    print(a[0]);       // hello
    print(a[2]);       // lumin
    print(len(a));     // 3
    print(len(a[1]));  // 5
}
array_with_strings();

// ---- 8. receiver-returning 方法后 return（UAF 回归测试） ----
func return_after_clear() {
    a = [1, 2, 3, 4];
    a.clear();
    a.add(99);
    return a;
}
r2 = return_after_clear();
print(len(r2));  // 1
print(r2[0]);    // 99

func return_after_add() {
    a = [1, 2];
    a.add(3);
    return a;
}
r3 = return_after_add();
print(len(r3));  // 3
print(r3[2]);    // 3

func return_after_remove() {
    a = [10, 20, 30];
    a.remove(1);
    return a;
}
r4 = return_after_remove();
print(len(r4));  // 2
print(r4[1]);    // 30

// ---- 9. 数组作为函数参数（逃逸） ----
func array_arg(arr) {
    return arr[0] + arr[1];
}
func pass_array() {
    a = [5, 15, 25];
    print(array_arg(a));  // 20
    print(a[2]);           // 25（原数组仍有效）
}
pass_array();

// ---- 10. 数组存入另一个数组（逃逸） ----
func store_in_array() {
    outer = [];
    inner = [1, 2];
    outer.add(inner);
    print(len(outer));     // 1
    print(outer[0][0]);    // 1
    inner[0] = 99;
    print(outer[0][0]);    // 99（引用语义）
}
store_in_array();

// ---- 11. 不逃逸数组 + sort（返回新数组） ----
func nonescaping_sort() {
    a = [3, 1, 4, 1, 5];
    b = sort(a);
    print(b[0]);  // 1
    print(b[4]);  // 5
    print(a[0]);  // 3（原数组不变）
}
nonescaping_sort();

// ---- 12. 空数组栈分配 ----
func empty_array() {
    a = [];
    print(len(a));  // 0
    a.add(1);
    print(len(a));  // 1
    print(a[0]);    // 1
}
empty_array();

// ---- 13. 不逃逸数组 gc_count 验证 ----
func gc_check() {
    x = [1, 2, 3, 4, 5];
    y = [6, 7, 8];
    print(x[0] + y[0]);  // 7
    print(len(x) + len(y));  // 8
}
before_gc = gc_count();
gc_check();
after_gc = gc_count();
print("gc_delta=" + (after_gc - before_gc));

print("ALL_DONE");
