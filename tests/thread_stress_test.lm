// ===== 多线程重负载压测（确定性场景，双通道可逐行 diff） =====
// 共享可变变量的无锁竞态（lost update）不在本文件：输出不确定，无法 diff；
// 竞态本身是语言语义边界（与 C 一致），详见 thread_race_test.lm 备注。

// A. 每线程 10000 次循环累加自身 id —— 验证线程局部状态隔离（无串扰）
func heavy(id) {
    s = 0;
    for (i = 0; i < 10000; i = i + 1) { s = s + id; }
    return s;
}
ha = thread(heavy, 1);
hb = thread(heavy, 2);
hc = thread(heavy, 3);
hd = thread(heavy, 4);
print("A: " + thread_join(ha) + " " + thread_join(hb) + " " + thread_join(hc) + " " + thread_join(hd));
// A: 10000 20000 30000 40000

// G. 单线程 40000 次自增 —— 非并发下应精确
g_counter = 0;
func single() { for (i = 0; i < 40000; i = i + 1) { g_counter = g_counter + 1; } return g_counter; }
print("G: " + single());
// G: 40000

// H. 4 线程各局部 10000 次自增 —— 局部变量隔离应精确
func plocal() { s = 0; for (i = 0; i < 10000; i = i + 1) { s = s + 1; } return s; }
p1 = thread(plocal); p2 = thread(plocal); p3 = thread(plocal); p4 = thread(plocal);
print("H: " + thread_join(p1) + " " + thread_join(p2) + " " + thread_join(p3) + " " + thread_join(p4));
// H: 10000 10000 10000 10000

// C. 120 线程批量创建/join —— 验证线程表动态扩容（>64）
func light(i) { return i; }
s = 0;
for (k = 0; k < 120; k = k + 1) {
    t = thread(light, k);
    s = s + thread_join(t);
}
print("C: sum=" + s);
// C: sum=7140 (0+1+...+119)

// D. 线程内 try/catch + 1000 次循环 —— 异常不逃逸、不挂死
func twork(x) {
    try {
        for (i = 0; i < 1000; i = i + 1) {
            if (i == x) { throw "hit"; }
        }
        return 1;
    } catch (e) {
        return -1;
    }
}
da = thread(twork, 0);
db = thread(twork, 999);
dc = thread(twork, 500);
print("D: " + thread_join(da) + " " + thread_join(db) + " " + thread_join(dc));
// D: -1 -1 -1

// E. 线程内嵌套函数调用 + 字符串拼接 —— 跨线程数据独立
func inner2(x) { return "v" + x; }
func outer2(x) { return inner2(x) + inner2(x); }
ea = thread(outer2, 7);
eb = thread(outer2, 8);
print("E: " + thread_join(ea) + " " + thread_join(eb));
// E: v7v7 v8v8

// F. 线程返回数组（join 只一次）
func mklist(n) { a = [0,0,0]; a[0] = n; a[1] = n + 1; a[2] = n + 2; return a; }
fa = thread(mklist, 10);
fb = thread(mklist, 20);
arrA = thread_join(fa);
arrB = thread_join(fb);
print("F: " + arrA[0] + " " + arrA[1] + " " + arrA[2] + " | " + arrB[0] + " " + arrB[1] + " " + arrB[2]);
// F: 10 11 12 | 20 21 22

// I. 线程内大循环只计算不打印 —— 验证无崩溃/挂死（输出确定性）
func burn(tag) { x = 0; for (i = 0; i < 5000; i = i + 1) { x = x + i; } return x; }
ia = thread(burn, 1);
ib = thread(burn, 2);
ic = thread(burn, 3);
print("I: " + thread_join(ia) + " " + thread_join(ib) + " " + thread_join(ic));
// I: 12497500 12497500 12497500 (0+1+...+4999)
