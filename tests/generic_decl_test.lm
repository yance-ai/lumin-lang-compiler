// generic_decl_test.lm —— 泛型声明 <T>value / <T>[...] / <string,V>{...} 全场景覆盖
// 双通道（VM 与 -c C 编译）逐行一致验证

print("== 1. 单值声明 - 基本类型 ==");
print(<int>42);           // 42
print(<double>3.14);      // 3.14
print(<bool>true);        // true
print(<bool>0);           // false
print(<char>'z');         // z
print(<char>65);          // A
print(<string>"hello");   // hello
print(<string>123);       // 123
print(<byte>200);         // 200
print(<ascii>'A');        // 65

print("== 2. 单值声明 - 固定宽度整数 ==");
print(<int8>200);         // -56
print(<int8>127);         // 127
print(<int16>32768);      // -32768
print(<int32>2147483648); // -2147483648
print(<int64>9223372036854775807); // max
print(<uint8>256);        // 0
print(<uint8>(-1));       // 255
print(<uint16>65536);     // 0
print(<uint32>4294967296); // 0
print(<uint>100);         // 100
print(<long>999);         // 999
print(<long long>888);    // 888

print("== 3. 单值声明 - 表达式 ==");
print(<int32>(100 + 200));  // 300
print(<int8>(100 + 200));   // 44 (300 & 0xFF = 44)
x = 500;
print(<int8>x);             // 244 (500 & 0xFF = 244)
print(<uint16>(x * 2));     // 1000

print("== 4. 数组泛型 - 基本类型 ==");
ai = <int>[1, 2, 3];
print(ai[0]); print(ai[2]);  // 1, 3
ad = <double>[1.1, 2.2];
print(ad[1]);                // 2.2
ab = <bool>[true, false, 1];
print(ab[0]); print(ab[2]);  // true, true
ac = <char>['a', 'b', 99];
print(ac[0]); print(ac[2]);  // a, c
as_ = <string>["x", "y", 123];
print(as_[0]); print(as_[2]); // x, 123
aby = <byte>[200, 256, -1];
print(aby[0]); print(aby[1]); print(aby[2]); // 200, 0, 255

print("== 5. 数组泛型 - 固定宽度整数 ==");
ai8 = <int8>[200, 127, 128];
print(ai8[0]); print(ai8[2]); // -56, -128
au8 = <uint8>[200, 256, -1];
print(au8[1]); print(au8[2]); // 0, 255
ai32 = <int32>[2147483648, 100];
print(ai32[0]);               // -2147483648
au32 = <uint32>[4294967295, 4294967296];
print(au32[0]); print(au32[1]); // 4294967295, 0

print("== 6. 数组泛型 - 空数组 ==");
e1 = <int>[];
print(len(e1));  // 0
e2 = <string>[];
print(len(e2));  // 0
e3 = <uint8>[];
print(len(e3));  // 0
e4 = <long long>[];
print(len(e4));  // 0

print("== 7. map 泛型 - 基本值类型 ==");
mi = <string,int>{"a": 1, "b": 2};
print(mi["a"]); print(mi["b"]); // 1, 2
md = <string,double>{"x": 1.5};
print(md["x"]);  // 1.5
mb = <string,bool>{"t": true, "f": 0};
print(mb["t"]); print(mb["f"]); // true, false
mc = <string,char>{"k": 'A', "n": 66};
print(mc["k"]); print(mc["n"]); // A, B
ms = <string,string>{"a": "1", "b": 2};
print(ms["a"]); print(ms["b"]); // 1, 2
mby = <string,byte>{"a": 200, "b": 256};
print(mby["a"]); print(mby["b"]); // 200, 0

print("== 8. map 泛型 - 固定宽度整数 ==");
mi8 = <string,int8>{"a": 200, "b": 127};
print(mi8["a"]); print(mi8["b"]); // -56, 127
mu8 = <string,uint8>{"a": 200, "b": -1};
print(mu8["a"]); print(mu8["b"]); // 200, 255
mi32 = <string,int32>{"big": 2147483648};
print(mi32["big"]);  // -2147483648
muint = <string,uint>{"n": 100};
print(muint["n"]);   // 100
mlong = <string,long>{"n": 999};
print(mlong["n"]);   // 999

print("== 9. map 泛型 - char 值类型 ==");
mchar = <string,char>{"first": 'A', "second": 66};
print(mchar["first"]);  // A
print(mchar["second"]); // B
print(len(mchar));      // 2

print("== 10. 嵌套泛型 ==");
nested = <int>[<int8>200, <int16>32768, <uint8>256];
print(nested[0]);  // -56
print(nested[1]);  // -32768
print(nested[2]);  // 0

print("== 11. 泛型 + 变量引用 ==");
val = 300;
arr = <int8>[val, val + 1];
print(arr[0]);  // 44 (300 & 0xFF)
print(arr[1]);  // 45 (301 & 0xFF)
mvar = <string,int8>{"key": val};
print(mvar["key"]);  // 44

print("== 12. 泛型数组后续操作 ==");
ga = <int8>[100, 200];
ga = ga.add(300);
print(ga[2]);  // 300（add 不做强转，保持原值）
print(len(ga)); // 3
gm = <string,uint8>{"a": 100};
gm["b"] = 300;
print(gm["b"]);  // 300（下标赋值不做强转）

print("== 13. float 单精度浮点 ==");
print(<float>3.14159265358979);  // float 精度截断
print((float)3.14159265358979);  // 强转同样截断
print((float)"1.5");             // 1.5
print((float)42);                // 42
fa = <float>[3.14159, 2.71828];
print(fa[0]); print(fa[1]);      // 3.14159, 2.71828
fm = <string,float>{"pi": 3.14159265};
print(fm["pi"]);                 // 3.14159
print(<float>(1.0 / 3.0));       // 0.333333

print("== done ==");
