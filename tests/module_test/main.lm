// main.lm —— 导入 math 模块并测试（第二阶段：Name Mangling 符号隔离）
import "math.lm" as m;

print("add=" + m.add(1, 2));
print("sub=" + m.sub(10, 3));
print("PI=" + m.PI);

// 导出 map 中不应包含私有符号 internal
print("internal_in_map=" + (m.internal == null ? "yes(not exported)" : "no(leaked!)"));

// 模块内私有函数 internal 被导出函数 workman 调用，验证 mangled 引用一致
print("workman=" + m.workman());
