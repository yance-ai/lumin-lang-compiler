// main.lm —— 导入 math 模块并测试
import "math.lm" as m;

print("add=" + m.add(1, 2));
print("sub=" + m.sub(10, 3));
print("PI=" + m.PI);

// 导出 map 中不应包含私有符号 internal
print("internal_in_map=" + (m.internal == null ? "yes(not exported)" : "no(leaked!)"));

// 第一阶段已知限制：模块内联后，私有符号在全局仍可直接调用
print("internal_global_call=" + internal());
