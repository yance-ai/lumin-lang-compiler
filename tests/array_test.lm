// P0: 逻辑运算符 + 取模 + 数组 + 复合赋值
a = [1, 2, 3];
print(len(a));
print(a[0]);
print(a[2]);
a[1] = 99;
print(a[1]);
print(a[0] + a[2]);
arr2 = [10, 20, 30, 40];
print(len(arr2));
arr2[3] = arr2[0] + arr2[1];
print(arr2[3]);
arr2[0] += 5;
print(arr2[0]);
arr2[1] -= 5;
print(arr2[1]);
arr2[2] *= 2;
print(arr2[2]);
arr2[3] /= 4;
print(arr2[3]);
empty = [];
print(len(empty));
x = 7;
x += 3;
print(x);
x -= 2;
print(x);
x *= 4;
print(x);
x /= 3;
print(x);
n = 17;
print(n % 5);
d = 17.5;
print(d % 5);
print(3 + 4 * 2 == 11 && 2 > 1);
print(1 > 2 || 3 < 4);
print(!(1 > 2));
print(0 && 1);
print(1 || 0);
print(!0);
print(!5);
if (1 > 0 && 2 > 1) { print(100); }
if (0 && 1 > 0) { print(200); } else { print(300); }
i = 3;
while (i > 0 && i <= 3) {
    print(i);
    i -= 1;
}
for (j = 0; j < len(a); j += 1) {
    print(a[j]);
}
