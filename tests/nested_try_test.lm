// ================= nested_try_test.lm：循环 × try/catch/finally 嵌套专项 =================
// 覆盖：for/while × try-catch / try-finally / try-catch-finally 多层互嵌
//       break/continue/throw 穿透、异常跨多层 finally 冒泡
// 每节注释给出期望输出，双通道（VM / -c 编译）必须逐行一致

// ---- n1: for + try/catch（无 finally），catch 内 continue/异常计数 ----
s1 = 0;
for (i = 0; i < 6; i++) {
    try {
        if (i == 2) { throw "n1"; }
        if (i == 4) { continue; }
        s1 = s1 + i;
    } catch (e) {
        s1 = s1 + 10;
    }
}
print("n1: s=" + s1);   // 0+1 +10 +3 +5 = 19

// ---- n2: while + try-catch-finally（异常路径 catch 后仍跑 finally）----
s2 = 0;
i2 = 0;
while (i2 < 4) {
    try {
        if (i2 == 1) { throw "n2"; }
        s2 = s2 + i2;
    } catch (e) {
        s2 = s2 + 100;
    } finally {
        s2 = s2 + 1000;
    }
    i2 = i2 + 1;
}
print("n2: s=" + s2);   // (0+1000) + (100+1000) + (2+1000) + (3+1000) = 4105

// ---- n3: for × try-finally（无 catch），函数内 throw 冒泡到循环外 catch ----
s3 = 0;
func f3(i3) {
    try {
        if (i3 == 1) { throw "n3"; }
        return i3;
    } finally {
        s3 = s3 + 1;
    }
}
for (i3 = 0; i3 < 3; i3++) {
    try {
        s3 = s3 + f3(i3);
    } catch (e) {
        s3 = s3 + 100;
    }
}
print("n3: s=" + s3);   // 读取先于调用：0+0 +100 +101+2 = 103

// ---- n4: 双层 for + try-finally，内层 break 穿透 finally ----
s4 = 0;
for (i4 = 0; i4 < 3; i4++) {
    for (j4 = 0; j4 < 4; j4++) {
        try {
            if (j4 == 2) { break; }
            s4 = s4 + i4 * 10 + j4;
        } finally {
            s4 = s4 + 1;
        }
    }
}
print("n4: s=" + s4);   // 每 i4 两轮：0,1 → +10,+11,+1,+1 … 总 72

// ---- n5: while × try-finally 内 continue 穿透 finally，外层再包 try-catch-finally ----
s5 = 0;
try {
    i5 = 0;
    while (i5 < 3) {
        try {
            if (i5 == 1) { i5 = i5 + 1; continue; }
            s5 = s5 + i5;
            i5 = i5 + 1;
        } finally {
            s5 = s5 + 1;
        }
    }
} catch (e) {
    s5 = s5 + 1000;
} finally {
    s5 = s5 + 10000;
}
print("n5: s=" + s5);   // (0+1)+(1)+(2+1)+10000 = 10005

// ---- n6: 双层循环内 throw 冒泡到循环外 catch（无 finally）----
s6 = 0;
try {
    for (i6 = 0; i6 < 4; i6++) {
        for (j6 = 0; j6 < 4; j6++) {
            if (i6 == 2 && j6 == 1) { throw "n6"; }
            s6 = s6 + 1;
        }
    }
} catch (e) {
    s6 = s6 + 500;
}
print("n6: s=" + s6);   // 4+4+1 +500 = 509

// ---- n7: while + try/catch（无 finally），catch 内 break 跳出循环 ----
s7 = 0;
i7 = 0;
while (i7 < 10) {
    try {
        if (i7 == 3) { throw "n7"; }
        s7 = s7 + i7;
    } catch (e) {
        s7 = s7 + 7;
        break;
    }
    i7 = i7 + 1;
}
print("n7: s=" + s7);   // 0+1+2 +7 = 10

// ---- n8: 三层嵌套 for > try-finally > try-catch，内层 catch 捕获后两层 finally 都跑 ----
s8 = 0;
for (i8 = 0; i8 < 2; i8++) {
    try {
        s8 = s8 + 1;
        try {
            if (i8 == 1) { throw "n8"; }
            s8 = s8 + 10;
        } catch (e) {
            s8 = s8 + 100;
        }
        s8 = s8 + 1000;
    } finally {
        s8 = s8 + 10000;
    }
}
print("n8: s=" + s8);   // (1+10+1000+10000) + (1+100+1000+10000) = 22112

// ---- n9: while 内嵌套 try-finally，throw 穿过 finally 冒泡到最外层 catch ----
s9 = 0;
try {
    i9 = 0;
    while (i9 < 3) {
        try {
            if (i9 == 1) { throw "n9"; }
            s9 = s9 + i9;
        } finally {
            s9 = s9 + 1;
        }
        i9 = i9 + 1;
    }
} catch (e) {
    s9 = s9 + 100;
}
print("n9: s=" + s9);   // 0+fin1 +fin2+100 = 102（finally 只在 throw 时执行一次）

// ---- n10: 双重循环 + 嵌套 try-finally，break 穿透两层 finally ----
s10 = 0;
for (i10 = 0; i10 < 2; i10++) {
    try {
        for (j10 = 0; j10 < 3; j10++) {
            try {
                if (j10 == 1) { break; }
                s10 = s10 + i10 + j10;
            } finally {
                s10 = s10 + 10;
            }
        }
        s10 = s10 + 100;
    } finally {
        s10 = s10 + 1000;
    }
}
print("n10: s=" + s10); // (0+10+100+1000) + (1121+10+100+1000) = 2241

// ---- n11: 循环内 try-finally 连续多轮，验证 finally 每轮都跑（有/无异常交替）----
s11 = 0;
for (i11 = 0; i11 < 5; i11++) {
    try {
        try {
            if (i11 % 2 == 1) { throw "odd"; }
            s11 = s11 + i11;
        } finally {
            s11 = s11 + 10;
        }
    } catch (e) {
        s11 = s11 + 100;
    }
}
print("n11: s=" + s11); // i=0: 0+10; i=1: +100+10; i=2: +2+10; i=3: +100+10; i=4: +4+10 = 246

// ---- n12: while + try-catch-finally，catch 内 continue（while 需自行步进）----
s12 = 0;
i12 = 0;
while (i12 < 5) {
    try {
        if (i12 == 2) { throw "n12"; }
        s12 = s12 + i12;
    } catch (e) {
        s12 = s12 + 50;
        i12 = i12 + 1;
        continue;
    } finally {
        s12 = s12 + 5;
    }
    i12 = i12 + 1;
}
print("n12: s=" + s12); // 5+6 +61+5 +66+3+5 +74+4+5 = 83
