// ============================================================
// 条件变量超时等待（cond_wait_timeout）综合测试
// 语义：被唤醒返回 true；超时返回 false（超时后仍持有锁，与 C 语义一致）
// 全部确定性输出，VM 与 C 编译双通道逐行 diff
// ============================================================

// 1. 无信号超时返回 false（100ms 后自动返回，不挂死）
m1 = mutex(); c1 = condvar();
lock(m1);
r1 = cond_wait_timeout(c1, m1, 100);
unlock(m1);
print("timeout-false: " + r1);                        // false

// 2. 被唤醒返回 true（等 5000ms，另一线程忙等后 signal，远早于超时）
m2 = mutex(); c2 = condvar(); g2 = [0];
func siglater2() {
    for (i = 0; i < 1000000; i = i + 1) { }           // 忙等延迟（<< 5000ms）
    lock(m2);
    g2[0] = 1;
    cond_signal(c2);
    unlock(m2);
}
t2 = thread(siglater2);
lock(m2);
r2 = cond_wait_timeout(c2, m2, 5000);
unlock(m2);
thread_join(t2);
print("wake-true: " + r2 + " " + g2[0]);              // true 1

// 3. 超时后仍持有锁（trylock 非阻塞验证：锁未释放则 false）
m3 = mutex(); c3 = condvar();
lock(m3);
r3 = cond_wait_timeout(c3, m3, 100);                  // 超时返回
h3 = trylock(m3);                                     // 仍持有 → false
unlock(m3);
u3 = trylock(m3);                                     // 释放后 → true
unlock(m3);
print("timeout-held: " + r3 + " " + h3 + " " + u3);   // false false true

// 4. 循环超时重试消费（带超时的生产-消费：无货时 50ms 重试，生产者延迟供货）
m4 = mutex(); c4 = condvar(); g4 = [0]; consumed4 = [0];
func tproducer4() {
    for (i = 0; i < 2000000; i = i + 1) { }           // 忙等延迟（让消费者先进入等待）
    lock(m4);
    g4[0] = 1;
    cond_signal(c4);
    unlock(m4);
}
func tconsumer4() {
    while (true) {
        lock(m4);
        if (g4[0] > 0) {
            g4[0] = g4[0] - 1;
            consumed4[0] = consumed4[0] + 1;
            unlock(m4);
            return;
        }
        r = cond_wait_timeout(c4, m4, 50);
        unlock(m4);                                   // 超时/唤醒后都先释放再重试
    }
}
t4p = thread(tproducer4);
t4c = thread(tconsumer4);
thread_join(t4p); thread_join(t4c);
print("timeout-consumer: " + consumed4[0]);           // 1

// 5. 混合：signal 唤醒 + 超时（统计唤醒总数；bool 用真值判断，signal 至少唤醒 1 个）
m5 = mutex(); c5 = condvar();
ready5 = [0]; woken5 = [0]; timedout5 = [0];
func siglater5() {
    while (true) { lock(m5); n = ready5[0]; unlock(m5); if (n >= 2) { break; } }
    lock(m5);
    cond_signal(c5);                                  // 唤醒 ≥1 个（pthread 语义）
    unlock(m5);
}
func tw5() {
    lock(m5);
    ready5[0] = ready5[0] + 1;
    r = cond_wait_timeout(c5, m5, 3000);              // 被唤醒 true / 超时 false
    if (r) { woken5[0] = woken5[0] + 1; } else { timedout5[0] = timedout5[0] + 1; }
    unlock(m5);
}
t5s = thread(siglater5);
t5a = thread(tw5); t5b = thread(tw5);
thread_join(t5s); thread_join(t5a); thread_join(t5b);
print("mix-wake-timeout: " + (woken5[0] >= 1) + " total=" + (woken5[0] + timedout5[0]));   // true total=2

// 6. 类型错误：配错锁 / 无效 id / 超时非整数（全部可 try/catch）
sp6 = spinlock(); rw6 = rwlock(); m6 = mutex(); c6 = condvar();
try { cond_wait_timeout(c6, sp6, 100); } catch (e) { print("ct-spin: caught"); }
try { cond_wait_timeout(c6, rw6, 100); } catch (e) { print("ct-rw: caught"); }
try { cond_wait_timeout(99999, m6, 100); } catch (e) { print("ct-invalid-cond: caught"); }
try { cond_wait_timeout(c6, 99999, 100); } catch (e) { print("ct-invalid-lock: caught"); }
try { cond_wait_timeout(c6, m6, "abc"); } catch (e) { print("ct-ms-type: caught"); }

// 7. 超时 0ms 立即返回（无 signal → 立即超时 false）
m7 = mutex(); c7 = condvar();
lock(m7);
r7 = cond_wait_timeout(c7, m7, 0);
unlock(m7);
print("timeout-zero: " + r7);                          // false

print("cond-timeout-test-done");
