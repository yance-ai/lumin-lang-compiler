// template_test.lm —— 字符串模板内插 + 匿名函数（lambda）表达式
// 预期输出按行标注

// ---- 匿名函数：高阶参数 ----
a = [1, 2, 3, 4];
print(join(map(a, func(x) { return x * x; }), ","));   // 1,4,9,16
print(join(filter(a, func(x) { return x % 2 == 0; }), ",")); // 2,4
print(reduce(a, func(acc, v) { return acc + v; }, 0));  // 10

// ---- 匿名函数：赋值 / 动态调用 / 类型 ----
g = func(x) { return x + 10; };
print(g(5));                    // 15
print(type(g));                 // func

// ---- 匿名函数：函数体内定义 ----
func outer() {
    f = func(a, b) { return a * b; };
    return f(3, 4);
}
print(outer());                 // 12

// ---- 匿名函数：变参 ----
sum_all = func(...args) { return sum(args); };
print(sum_all(1, 2, 3));        // 6

// ---- 字符串模板：基本内插 ----
name = "lumyr";
n = 42;
print(f"hello {name}");                     // hello lumyr
print(f"val={n} sq={n * n} even={n % 2 == 0}"); // val=42 sq=1764 even=true

// ---- 模板：转义 / 嵌套调用 / 下标 / 三元 ----
print(f"{{literal}} n={n}");                // {literal} n=42
print(f"pi={3.14} s={format(\"a={}\", 1)}"); // pi=3.14 s=a=1
arr = [7, 8];
print(f"arr[1]={arr[1]} f={len(arr)}");     // arr[1]=8 f=2
print(f"t={n > 5 ? \"yes\" : \"no\"} u={n > 0 && n < 10}"); // t=yes u=true

// ---- 模板：字面 {}（format 占位）不拦截 ----
print(format("{}", join(a, "-")));         // 1-2-3-4
print("bare={}");                          // {}
