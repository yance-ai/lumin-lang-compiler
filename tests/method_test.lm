// map 点属性访问/赋值 + 数组/容器方法链测试
// 方法链 a.b(x) → b(a, x)（接收者作首参）；a.b（无括号）→ a["b"] 属性访问

print("== map 点属性读 ==");
m = {"a": 1, "b": "x", "c": [1, 2]};
print(m.a);                  // 1
print(m.b);                  // x
print(m.c[1]);               // 2（属性取到数组再下标）
print(type(m));              // map

print("== map 点属性赋值 ==");
m.d = 42;                    // 新增键
print(m["d"]);               // 42
m.a = 100;                   // 覆盖已有键
print(m.a);                  // 100
m.e = [7, 8];
print(m.e[0]);               // 7

print("== 数组 add ==");
a = [1, 2, 3];
a2 = a.add(4);               // [1,2,3,4]
print(len(a2));              // 4
print(a2[3]);                // 4
print(len(a));               // 3（原数组不变，值语义）

print("== 数组 remove ==");
r = a2.remove(1);            // 删下标 1 → [1,3,4]
print(len(r));               // 3
print(r[1]);                 // 3
print(r[2]);                 // 4

print("== 数组 clear ==");
c = r.clear();
print(len(c));               // 0

print("== 链式 ==");
x = [].add(1).add(2).add(3).add(4);
print(len(x));               // 4
print(x[0]);                 // 1
print(x[3]);                 // 4

print("== 复用已有内置的方法形式 ==");
print(join([3, 1, 2].sort(), ","));    // 1,2,3
print([1, 2, 3].sum());                // 6
print([1, 2, 3].avg());                // 2
print([1, 2, 3].contains(2));          // true
print([5, 4].reverse()[0]);            // 4
b = [1, 3].insert(1, 2);               // [1,2,3]
print(join(b, ","));                   // 1,2,3
print([1, 2, 3].del(1)[1]);            // 3（del 方法形式）

print("== map 方法 ==");
print({"x": 1}.keys()[0]);             // x
print({"a": 1}.values()[0]);           // 1

print("== 嵌套组合 ==");
cfg = {"data": [1, 2, 3], "opts": {"flag": true}};
cfg.data = cfg.data.add(4);            // 属性读+数组方法+属性赋值
print(len(cfg.data));                  // 4
print(cfg.data.remove(0)[0]);          // 2
cfg.list = [].add(cfg.opts).add({"n": 1});
print(cfg.list[0]["flag"]);            // true
print(cfg.list[1].n);                  // 1（嵌套属性读）

print("== indexOf / get / set / first / last ==");
a = [10, 20, 30, 20];
print(a.indexOf(20));           // 1（首个相等下标）
print(a.indexOf(99));           // -1（未找到）
print(a.get(0));                // 10（安全取）
print(a.get(100) == null);      // true（越界 → null 不抛错）
print(a.get(-1) == null);       // true
a.set(1, 99);                   // 原地改（与 a[1]=99 一致）
print(join(a, ","));            // 10,99,30,20
print(a.first());               // 10
print(a.last());                // 20
print([].first() == null);      // true（空数组 → null）
print([].last() == null);       // true
print(join([1, 2, 3].insert(1, 9), ","));  // 1,9,2,3
c = [].add(1).add(2).add(3).set(0, 8).add(4);  // 链式组合
print(join(c, ","));            // 8,2,3,4
print(c.indexOf(3));            // 2

print("== 边界 ==");
print(len([].clear()));                // 0
try { [1, 2].remove(5); print("no"); } catch (e) { print("caught"); }
try { m.missing.x; print("no"); } catch (e) { print("caught2"); }
