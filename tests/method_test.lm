// map 点属性访问/赋值 + 数组/容器方法链测试
// 方法链 a.b(x) → b(a, x)（接收者作首参）；a.b（无括号）→ a["b"] 属性访问

print("== map 点属性读 ==");
m = {"a": 1, "b": "x", "c": [1, 2]};
print(m.a);                  // 1
print(m.b);                  // x
print(m.c[1]);               // 2（属性取到数组再下标）
print(type(m));              // map

print("== map 点属性赋值 ==");
m.d = 42;                    // 新增键
print(m["d"]);               // 42
m.a = 100;                   // 覆盖已有键
print(m.a);                  // 100
m.e = [7, 8];
print(m.e[0]);               // 7

print("== 数组 add ==");
a = [1, 2, 3];
a2 = a.add(4);               // [1,2,3,4]
print(len(a2));              // 4
print(a2[3]);                // 4
print(len(a));               // 4（引用语义：add 原地修改 a）

print("== 数组 remove ==");
r = a2.remove(1);            // 删下标 1 → [1,3,4]
print(len(r));               // 3
print(r[1]);                 // 3
print(r[2]);                 // 4

print("== 数组 clear ==");
c = r.clear();
print(len(c));               // 0

print("== 链式 ==");
x = [].add(1).add(2).add(3).add(4);
print(len(x));               // 4
print(x[0]);                 // 1
print(x[3]);                 // 4

print("== 复用已有内置的方法形式 ==");
print(join([3, 1, 2].sort(), ","));    // 1,2,3
print([1, 2, 3].sum());                // 6
print([1, 2, 3].avg());                // 2
print([1, 2, 3].contains(2));          // true
print([5, 4].reverse()[0]);            // 4
b = [1, 3].insert(1, 2);               // [1,2,3]
print(join(b, ","));                   // 1,2,3
print([1, 2, 3].del(1)[1]);            // 3（del 方法形式）

print("== map 方法 ==");
print({"x": 1}.keys()[0]);             // x
print({"a": 1}.values()[0]);           // 1

print("== 嵌套组合 ==");
cfg = {"data": [1, 2, 3], "opts": {"flag": true}};
cfg.data = cfg.data.add(4);            // 属性读+数组方法+属性赋值
print(len(cfg.data));                  // 4
print(cfg.data.remove(0)[0]);          // 2
cfg.list = [].add(cfg.opts).add({"n": 1});
print(cfg.list[0]["flag"]);            // true
print(cfg.list[1].n);                  // 1（嵌套属性读）

print("== indexOf / get / set / first / last ==");
a = [10, 20, 30, 20];
print(a.indexOf(20));           // 1（首个相等下标）
print(a.indexOf(99));           // -1（未找到）
print(a.get(0));                // 10（安全取）
print(a.get(100) == null);      // true（越界 → null 不抛错）
print(a.get(-1) == null);       // true
a.set(1, 99);                   // 原地改（与 a[1]=99 一致）
print(join(a, ","));            // 10,99,30,20
print(a.first());               // 10
print(a.last());                // 20
print([].first() == null);      // true（空数组 → null）
print([].last() == null);       // true
print(join([1, 2, 3].insert(1, 9), ","));  // 1,9,2,3
c = [].add(1).add(2).add(3).set(0, 8).add(4);  // 链式组合
print(join(c, ","));            // 8,2,3,4
print(c.indexOf(3));            // 2

print("== map 方法（get/set/add/has/remove/first/last/clear）==");
m = {"a": 1, "b": "x"};
print(m.get("a"));             // 1（安全取键）
print(m.get("zz") == null);    // true（缺键 null）
print(m.has("a"));             // true（键存在）
print(m.has("zz"));            // false
m.set("c", 42);                // 设键（原地）
print(m["c"]);                 // 42
m2 = m.add("d", 99);           // add 设键，返回 m（链式）
print(m["d"]);                 // 99
print(m2 == m);                // true（原地 + 返回自身）
print(m.remove("a")["b"]);     // x（remove 删键，原地修改并返回自身）
print(m.has("a"));             // false（引用语义：remove 原地删键）
print(m.first());              // 1（首键值，插入序）
print(m.last());               // 99（尾键值）
print(m.clear() == {});        // true（clear 原地生效，返回自身）
n = {}.add("x", 1).add("y", 2).set("z", 3);  // 链式
print(n["y"]);                 // 2
print(n.first());              // 1
print(n.last());               // 3
print(len(n.keys()));          // 3（map 方法嵌套）
print(n.values()[0]);          // 1

print("== 全部容器内置可 .函数() 触发 ==");
a = [3, 1, 2];
print(a.len());                    // 3
print(a.indexOf(2));               // 2
print(a.contains(1));              // true
print(a.first());                  // 3
print(a.last());                   // 2
print(a.sum());                    // 6
print(a.avg());                    // 2
print(a.sort().first());           // 1
print(a.reverse().first());        // 3
b = a.insert(0, 9);
print(b.len());                    // 4
print(b.del(1).len());             // 3
m = {"x": 1, "y": 2};
print(m.len());                    // 2
print(m.keys().len());             // 2
print(m.values().sum());           // 3
print(m.contains("x"));            // true
print(m.get("x"));                 // 1
print(m.has("y"));                 // true
print(m.del("x").len());           // 1（map del 方法链：引用语义原地删键）
print(m.first());                  // 2（引用语义：x 已被删，首键 y 的值）
print(m.last());                   // 2
print(m.add("z", 3).len());        // 2（y+z）
print(m.set("w", 4).len());        // 3（y+z+w）
print(m.clear().len());            // 0（普通 map 无 __mapname__，清空后 0）

print("== 边界 ==");
print(len([].clear()));                // 0
try { [1, 2].remove(5); print("no"); } catch (e) { print("caught"); }
try { m.missing.x; print("no"); } catch (e) { print("caught2"); }
