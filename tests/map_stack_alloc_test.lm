// ============ map 结构体栈分配全场景测试 ============
// 运行：./bin/lumyr tests/map_stack_alloc_test.lm
// 编译：./bin/lumyr -c tests/map_stack_alloc_test.lm -o /tmp/msat && /tmp/msat
// 双通道语义输出必须逐行一致（gc_count 等内省指标在编译模式可能不同）

// ---- 1. 不逃逸 map：ValueMap 结构体栈分配，gc_count 下降 ----
func nonescape_map() {
    m = {"a": 1, "b": 2, "c": 3};
    print(m["a"]);  // 1
    print(m["b"]);  // 2
    print(m["c"]);  // 3
    print(len(m));  // 3
}
before = gc_count();
nonescape_map();
after = gc_count();
print("map_gc_delta=" + (after - before));

// ---- 2. 不逃逸 map + 原地修改 set/remove/clear ----
func map_modify() {
    m = {"x": 10, "y": 20};
    m["z"] = 30;
    print(m["z"]);  // 30
    print(len(m));  // 3
    m.remove("x");
    print(has(m, "x"));  // false
    print(len(m));  // 2
    m.clear();
    print(len(m));  // 0
}
map_modify();

// ---- 3. map 方法链：set/add/remove 返回自身 ----
func map_chain() {
    m = {}.add("a", 1).add("b", 2).set("c", 3);
    print(m["a"]);  // 1
    print(m["c"]);  // 3
    print(len(m));  // 3
    print(m.remove("b")["a"]);  // 1（链式）
}
map_chain();

// ---- 4. 逃逸 map：return ----
func escape_return() {
    m = {"k": "v", "n": 42};
    return m;
}
r = escape_return();
print(r["k"]);  // v
print(r["n"]);  // 42

// ---- 5. 逃逸 map：顶层赋值（main 中所有变量为全局） ----
g_map = {"global": true};
print(g_map["global"]);  // true
g_map["new"] = 99;
print(g_map["new"]);  // 99

// ---- 6. map 作为函数参数：逃逸 ----
func map_param(m) {
    return m["a"] + m["b"];
}
func pass_map() {
    m = {"a": 5, "b": 15};
    print(map_param(m));  // 20
}
pass_map();

// ---- 7. map 存入数组：逃逸 ----
func map_in_array() {
    arr = [{"x": 1}, {"y": 2}];
    print(arr[0]["x"]);  // 1
    print(arr[1]["y"]);  // 2
}
map_in_array();

// ---- 8. 嵌套 map ----
func nested_map() {
    m = {"outer": {"inner": 42}};
    print(m["outer"]["inner"]);  // 42
    m["outer"]["inner"] = 99;
    print(m["outer"]["inner"]);  // 99
}
nested_map();

// ---- 9. map keys/values ----
func map_keys_values() {
    m = {"a": 1, "b": 2, "c": 3};
    ks = keys(m);
    print(len(ks));  // 3
    vs = values(m);
    print(vs[0] + vs[1] + vs[2]);  // 6
}
map_keys_values();

// ---- 10. map 迭代 ----
func map_iter() {
    m = {"a": 1, "b": 2};
    ks = keys(m);
    sum = 0;
    for(i = 0; i < len(ks); i = i + 1) {
        sum = sum + m[ks[i]];
    }
    print(sum);  // 3
}
map_iter();

// ---- 11. 大量元素（触发红黑树）----
func map_rbtree() {
    m = {};
    for (i = 0; i < 100; i = i + 1) {
        m["key_" + i] = i;
    }
    print(len(m));  // 100
    print(m["key_50"]);  // 50
    print(m["key_99"]);  // 99
}
map_rbtree();

// ---- 12. map 含数组值（数组逃逸）----
func map_with_array() {
    m = {"data": [1, 2, 3]};
    print(m["data"][1]);  // 2
    m["data"].add(4);
    print(len(m["data"]));  // 4
}
map_with_array();

// ---- 13. 空 map 栈分配 ----
func empty_map() {
    m = {};
    print(len(m));  // 0
    m["x"] = 1;
    print(m["x"]);  // 1
}
empty_map();

print("ALL_DONE");
