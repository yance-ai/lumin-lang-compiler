// ============================================================
// 线程局部变量（threadlocal_get / threadlocal_set）综合测试
// 语义：
//   - threadlocal_set(name, value) 写当前线程局部槽，返回 value
//   - threadlocal_get(name) 读当前线程局部槽；当前线程未初始化则 runtime_error（可 catch）
//   - 每线程独立副本，跨线程不可见；数组/字符串为引用存储
// 全部确定性输出，VM 与 C 编译双通道逐行 diff
// ============================================================

// 1. 各线程独立计数：4 线程各自累加 1000，互不干扰（无锁精确）
func tinc1() {
    threadlocal_set("acc", 0);
    for (i = 0; i < 1000; i = i + 1) {
        threadlocal_set("acc", threadlocal_get("acc") + 1);
    }
    return threadlocal_get("acc");
}
res1 = [0,0,0,0];
tt1 = [0,0,0,0];
for (k = 0; k < 4; k = k + 1) { tt1[k] = thread(tinc1); }
for (k = 0; k < 4; k = k + 1) { res1[k] = thread_join(tt1[k]); }
print("tls-indep: " + res1[0] + " " + res1[1] + " " + res1[2] + " " + res1[3]);   // 1000 1000 1000 1000

// 2. 同名不同值：worker 各写 "x" 互不干扰，主线程 "x" 不受影响
threadlocal_set("x", 111);
func twx2(i) {
    threadlocal_set("x", 1000 + i);
    return threadlocal_get("x");
}
res2 = [0,0,0,0];
tt2 = [0,0,0,0];
for (k = 0; k < 4; k = k + 1) { tt2[k] = thread(twx2, k); }
for (k = 0; k < 4; k = k + 1) { res2[k] = thread_join(tt2[k]); }
print("tls-same-name: " + threadlocal_get("x") + " " + res2[0] + " " + res2[1] + " " + res2[2] + " " + res2[3]);   // 111 1000 1001 1002 1003

// 3. 字符串 TLS 隔离：worker 拼接自己的字符串，主线程字符串不受影响
threadlocal_set("s", "main");
func tws3(i) {
    threadlocal_set("s", "worker-" + i);
    return threadlocal_get("s");
}
res3 = [0,0,0,0];
tt3 = [0,0,0,0];
for (k = 0; k < 4; k = k + 1) { tt3[k] = thread(tws3, k); }
for (k = 0; k < 4; k = k + 1) { res3[k] = thread_join(tt3[k]); }
s3 = threadlocal_get("s");
print("tls-string: " + s3 + " | " + res3[0] + " " + res3[1] + " " + res3[2] + " " + res3[3]);   // main | worker-0 worker-1 worker-2 worker-3

// 4. 数组 TLS 隔离：worker 写自己的数组（长度 2），主线程数组（长度 3）不变
threadlocal_set("arr", [1,2,3]);
func twa4() {
    threadlocal_set("arr", [7,8]);
    return len(threadlocal_get("arr"));
}
r4 = thread_join(thread(twa4));
print("tls-array: " + r4 + " " + len(threadlocal_get("arr")));      // 2 3

// 5. 未初始化 get 报错（可 catch）
try { threadlocal_get("nope"); } catch (e) { print("tls-uninit: caught"); }

// 6. set 返回原值（表达式值）
r6 = threadlocal_set("a", 42);
print("tls-set-ret: " + r6);                                          // 42

// 7. 名字非字符串报错（可 catch）
try { threadlocal_get(123); } catch (e) { print("tls-get-name-type: caught"); }
try { threadlocal_set(456, 1); } catch (e) { print("tls-set-name-type: caught"); }

// 8. 跨线程不可见：worker 读不到主线程的 TLS（未初始化 → catch → -1）
threadlocal_set("hidden", 7);
func tcross8() {
    try { v = threadlocal_get("hidden"); return v; } catch (e) { return -1; }
}
r8 = thread_join(thread(tcross8));
print("tls-cross-thread: " + r8);                                     // -1

// 9. TLS 大循环无竞争精确：4 线程各 10000 次读写（对比全局无锁会丢更新）
func tbig9() {
    threadlocal_set("n", 0);
    for (i = 0; i < 10000; i = i + 1) {
        threadlocal_set("n", threadlocal_get("n") + 1);
    }
    return threadlocal_get("n");
}
res9 = [0,0,0,0];
tt9 = [0,0,0,0];
for (k = 0; k < 4; k = k + 1) { tt9[k] = thread(tbig9); }
for (k = 0; k < 4; k = k + 1) { res9[k] = thread_join(tt9[k]); }
print("tls-big: " + res9[0] + " " + res9[1] + " " + res9[2] + " " + res9[3]);   // 10000 10000 10000 10000

print("threadlocal-test-done");
