// 空安全测试

print("=== Test 1: safe call on null ===");
obj = null;
result = obj?.method();
print(result);

print("=== Test 2: safe call on non-null ===");
arr = [1, 2, 3];
print(len(arr));

print("=== Test 3: safe property access on null ===");
obj2 = null;
print(obj2?.name);

print("=== Test 4: null coalescing ===");
x = null;
y = x ?? "default";
print(y);

z = "hello" ?? "default";
print(z);

print("=== Test 5: chained null coalescing ===");
a = null;
b = null;
c = a ?? b ?? "fallback";
print(c);

print("=== All null safety tests passed ===");
