// addall_multi_test.lm —— addAll 合并 / 8 维数组 flat / 多线程容器并发
func dbl(x) { return x * 2; }
print("== 1. addAll 数组（值语义：新数组） ==");
a = [1, 2, 3];
b = a.addAll([4, 5]);
print(b.join(","));               // 1,2,3,4,5
print(len(b));                    // 5
print(a.len());                   // 3（原数组不变）
print([].addAll([1]).join(","));  // 1（空数组 + 1）
print([1, 2].addAll([]).join(","));  // 1,2（加空）
print([].addAll([]).len());       // 0（空 + 空）
// 混合类型元素
c = ["x", 1].addAll([true, 2.5]);
print(len(c));                    // 4
print(c[0]);                      // x
print(c[2]);                      // true
// 链式：addAll 后继续方法链
print([1].addAll([2, 3]).map(dbl).join(","));  // 2,4,6
d = [[1], [2]].addAll([[3, 4]]);
print(d.flat(2).join(","));       // 1,2,3,4

print("== 2. addAll 字典（引用语义：原地合并） ==");
m1 = {"a": 1, "b": 2};
m2 = {"c": 3, "a": 99};
r = m1.addAll(m2);
print(r.a);                       // 99（同键覆盖）
print(r.b);                       // 2
print(r.c);                       // 3
print(m1.a);                      // 99（m1 原地被改——引用语义）
print(m1.c);                      // 3
print(len(m1.keys()));            // 3
print({}.addAll({"x": 1}).x);     // 1（空字典合并）
print({"x": 1}.addAll({}).x);     // 1（合并空字典）
// 链式
m3 = {"n": 1};
print(m3.addAll({"m": 2}).qs());  // n=1&m=2
print(m3.addAll({"k": 3}).len()); // 3

print("== 3. 8 维数组 flat（深度矩阵） ==");
d2 = [[1, 2], [3, 4]];
d3 = [d2, d2];
d4 = [d3, d3];
d5 = [d4, d4];
d6 = [d5, d5];
d7 = [d6, d6];
d8 = [d7, d7];
print(d8.flat(1).len());          // 4（8→7 维：2 个 d7 各 2 个 d6）
print(d8.flat(2).len());          // 8（6 维）
print(d8.flat(3).len());          // 16
print(d8.flat(4).len());          // 32
print(d8.flat(5).len());          // 64
print(d8.flat(6).len());          // 128（2 维：64 个 d2 数组）
print(d8.flat(7).len());          // 256（1 维全展开：标量）
print(d8.flat(8).len());          // 256（全展开）
print(d8.flat(-1).len());         // 256（无限深度）
f = d8.flat(-1);
print(f[0]);                      // 1
print(f[1]);                      // 2
print(f[2]);                      // 3
print(f[3]);                      // 4
print(f[255]);                    // 4（第 64 组末元素）
print(f[127]);                    // 4（第 32 组末元素）
ok = true;
for (i = 0; i < 256; i = i + 1) {
    if (f[i] != (i % 4) + 1) { ok = false; }
}
print(ok);                        // true（256 元素全量校验 1,2,3,4 循环）
print(d8.flat(6)[0].len());       // 2（6 层后元素是 [1,2] 行数组）
print(d8.flat(6)[0][0]);          // 1（flat 后多级索引取值）
print(d8.flat(6)[63][1]);         // 4（第 64 个行元素 [3,4] 的第二个值）

print("== 4. 多线程并发 map.addAll（原地合并跨线程共享） ==");
shared = {};
ml = mutex();
func merge_worker(i) {
    blk = {}; blk.set("k" + i, i); blk.set("x", i * 10);
    lock(ml);
    shared.addAll(blk);         // 原地合并（map 引用语义 → 跨线程可见）
    unlock(ml);
}
ts = [];
for (i = 0; i < 60; i = i + 1) { ts = ts.add(thread(merge_worker, i)); }
for (i = 0; i < 60; i = i + 1) { thread_join(ts[i]); }
print(len(shared.keys()));        // 61（60 个 k+i + x 被覆盖为最后写入）
print(shared.get("k7"));          // 7
print(shared.get("k59"));         // 59
sum = 0;
for (i = 0; i < 60; i = i + 1) { sum = sum + shared.get("k" + i); }
print(sum);                       // 1770

print("== 5. 多线程并发数组 addAll（值语义 + 共享槽位传出） ==");
out = range(20);                  // 预分配 20 槽（元素共享）
ao = mutex();
func arr_worker(i) {
    block = [];
    for (j = 0; j < 10; j = j + 1) { block = block.add(i * 100 + j); }
    merged = block.addAll([-1, -2]);   // 数组值语义：新数组
    lock(ao);
    out[i] = merged;              // 结果存共享槽位（items 共享）
    unlock(ao);
}
ts2 = [];
for (i = 0; i < 20; i = i + 1) { ts2 = ts2.add(thread(arr_worker, i)); }
for (i = 0; i < 20; i = i + 1) { thread_join(ts2[i]); }
print(len(out));                  // 20
print(len(out[0]));               // 12（10 + 2）
print(out[0][0]);                 // 0
print(out[0][11]);                // -2
print(out[19][0]);                // 1900
print(out[19][9]);                // 1909
ok = true;
for (i = 0; i < 20; i = i + 1) {
    if (len(out[i]) != 12) { ok = false; }
    for (j = 0; j < 10; j = j + 1) {
        if (out[i][j] != i * 100 + j) { ok = false; }
    }
    if (out[i][10] != -1 || out[i][11] != -2) { ok = false; }
}
print(ok);                        // true（20 槽 × 12 元素全量校验）

print("== 6. 多线程共享 8 维数组 flat ==");
fl = mutex();
func flat_worker(i) {
    lock(fl);
    r = d8.flat(-1);              // 共享只读 8 维数组无限展平
    unlock(fl);
    if (len(r) != 256) { print("flat 长度异常 " + i); }
    if (r[255] != 4) { print("flat 元素异常 " + i); }
}
ts3 = [];
for (i = 0; i < 30; i = i + 1) { ts3 = ts3.add(thread(flat_worker, i)); }
for (i = 0; i < 30; i = i + 1) { thread_join(ts3[i]); }
print("flat 线程检查完成");       // 无"异常"输出即全部一致

print("== 7. 综合：多线程合并 + 多维 + addAll 链式 ==");
big = {};
bl = mutex();
func big_worker(i) {
    block = {};
    for (j = 0; j < 5; j = j + 1) { block.set("b" + i + "_" + j, i * 5 + j); }
    lock(bl);
    big.addAll(block);            // 300 键（60 线程 × 5）
    unlock(bl);
}
ts4 = [];
for (i = 0; i < 60; i = i + 1) { ts4 = ts4.add(thread(big_worker, i)); }
for (i = 0; i < 60; i = i + 1) { thread_join(ts4[i]); }
print(len(big.keys()));           // 300
print(big.get("b7_4"));           // 39
print(big.get("b59_0"));          // 295
// 合并结果继续方法链
print(big.qs().len());            // 查询字符串非空
print(big.keys().len());          // 300
