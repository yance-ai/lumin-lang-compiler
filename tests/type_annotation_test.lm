// 类型标注测试：<type>expr 等价 C 的类型声明，给值打类型标记
// 与类型转换 (type)expr 行为一致，但语义不同：标注是变量级声明，转换是单次转换

// 整数类型标注
print("=== 整数类型标注 ===");
print(<int8>1000);      // -24 (截断为 int8)
print(<int16>100000);   // -31072 (截断为 int16)
print(<int32>3000000000); // -1294967296 (截断为 int32)
print(<int64>3000000000); // 3000000000 (不截断)
print(<uint8>1000);      // 232 (截断为 uint8)
print(<uint16>70000);    // 4464 (截断为 uint16)
print(<uint32>5000000000); // 705032704 (截断为 uint32)
print(<uint64>5000000000); // 5000000000 (不截断)

// 浮点类型标注
print("=== 浮点类型标注 ===");
print(<float>3.14159265358979);   // 3.141593 (截断为 float 精度)
print(<double>3.14159265358979);  // 3.14159265358979 (完整 double 精度)

// void 标注
print("=== void 标注 ===");
print(<void>100);   // null

// bool 标注
print("=== bool 标注 ===");
print(<bool>100);   // 1
print(<bool>0);     // 0

// char 标注
print("=== char 标注 ===");
print(<char>65);    // 65 (ASCII 'A')

// 类型标注与类型转换对比
print("=== 标注 vs 转换 ===");
print(<int8>1000);   // -24 (标注)
print((int8)1000);   // -24 (转换，结果相同)
print(<uint8>1000);  // 232 (标注)
print((uint8)1000);  // 232 (转换，结果相同)

// 非常量表达式标注
print("=== 非常量表达式标注 ===");
x = 1000;
print(<int8>x);      // -24
print(<uint8>x);     // 232
print(<int16>x);     // 1000
print(<int32>x);     // 1000
print(<int64>x);     // 1000

// 复合表达式标注
print("=== 复合表达式标注 ===");
print(<int8>(100 + 900));  // -24 (先计算再截断)
print(<int8>100 + 900);    // 1000 (只截断 100，再加 900)

// 函数返回值标注
print("=== 函数返回值标注 ===");
func get_val() { return 1000; }
print(<int8>get_val());  // -24

print("=== 类型标注测试完成 ===");
