// regex_time_log_test.lm —— 正则表达式 / 日期时间 / 日志
print("== 1. regex_match 完整匹配 ==");
print(regex_match("abc123", "[a-z]+[0-9]+"));  // true
print(regex_match("abc123", "^[0-9]+"));        // false
print(regex_match("hello", "hello"));            // true
print(regex_match("hello", "hell"));             // false（非完整匹配）
print(regex_match("2026-09-07", "\d{4}-\d{2}-\d{2}")); // true
print("== 2. regex_search 分组捕获 ==");
m = regex_search("price=99.5元", "([a-z]+)=([0-9.]+)");
print(len(m));   // 3
print(m[0]);     // price=99.5
print(m[1]);     // price
print(m[2]);     // 99.5
m2 = regex_search("no match", "\d+");
print(len(m2));  // 0
m3 = regex_search("2026-09-07", "(\d{4})-(\d{2})-(\d{2})");
print(m3[1]);    // 2026
print(m3[2]);    // 09
print(m3[3]);    // 07
print("== 3. regex_replace 替换 + 反向引用 ==");
print(regex_replace("hello world", "([a-z]+)", "<\1>"));  // <hello> <world>
print(regex_replace("a1b2c3", "([a-z])([0-9])", "\2\1")); // 1a2b3c
print(regex_replace("  hello  ", "\s+", ""));             // hello
print(regex_replace("2026-09-07", "(\d+)-(\d+)-(\d+)", "\3/\2/\1")); // 07/09/2026
print(regex_replace("aaa", "a", "b"));                     // bbb
print("== 4. 日期时间 ==");
n = now();
print(n.year > 2020);                    // true
print(n.month >= 1 && n.month <= 12);    // true
print(n.day >= 1 && n.day <= 31);        // true
print(n.hour >= 0 && n.hour <= 23);      // true
print(timestamp() > 1700000000);         // true
print(timestamp_ms() > 1700000000000);   // true
print(len(date()) == 10);                // true
print(len(time()) == 8);                 // true
print(len(datetime()) == 19);            // true
print(format_time("%Y/%m/%d") != "");    // true
print("== 5. sleep 计时 ==");
t0 = timestamp_ms();
sleep(30);
t1 = timestamp_ms();
print(t1 - t0 >= 20);                     // true
print("== 6. 日志函数（输出到 stderr） ==");
debug("debug msg");
info("info msg");
warn("warn msg");
error("error msg");
fatal("fatal msg");
log.debug("method debug");
log.info("method info");
log.warn("method warn");
log.error("method error");
log.fatal("method fatal");
print("log calls done");
print("== done ==");
