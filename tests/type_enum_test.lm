// type_enum_test.lm —— type 声明 / 枚举声明 / 泛型自定义类型
// 双通道（VM 与 -c C 编译）逐行一致验证

print("== type 声明 ==");
type Person {
    name: string,
    age: int
}
p = Person("张三", 18);
print(p.name);            // 张三
print(p.age);             // 18
print(p["age"]);          // 18（构造产物是普通 map）
p2 = Person("18", "25");  // 属性强转：age → int
print(p2.age);            // 25
print(type(p2.age));      // int
p3 = Person(30, "40");    // 数字/字符串混合
print(p3.name);           // 30（int → string 强转）
print(p3.age);            // 40

print("== 空 type ==");
type Empty { }
e = Empty(1);             // 无属性：构造为空 map
print(type(e));           // map
print(len(e.keys()));     // 0

print("== type 构造 + 方法链 ==");
type Tag { name: string }
t = Tag("vip").add("level", 3);   // 构造后当 map 用
print(t.name);            // vip
print(t.level);           // 3

print("== 枚举 ==");
enum Color { RED, GREEN, BLUE }
print(Color.RED);         // RED（值 = 成员名）
print(Color.GREEN);       // GREEN
c = Color.BLUE;
print(c == "BLUE");       // true
enum Level { LOW, MID, HIGH }
lv = Level.MID;
if (lv == Level.LOW) { print("low"); }
elseif (lv == Level.MID) { print("mid"); }
else { print("high"); }   // mid
print(Color.RED == "RED");  // true（不同枚举可同时存在）

print("== 泛型 type ==");
arr = <Person>[Person("a", 1), {"name": "b", "age": 2}];
print(len(arr));          // 2
print(arr[0].name);       // a
print(arr[1].age);        // 2
tags = <Tag>[Tag("a"), Tag("b")].add(Tag("c"));  // 泛型 + 方法链
print(len(tags));         // 3
print(tags[2].name);      // c

print("== 嵌套构造 ==");
type User { name: string, tag: Tag }
u = User("u1", Tag("vip"));
print(u.name);            // u1
print(u.tag.name);        // vip
print(u.tag.add("id", 7).id);  // 7（链式深入）

print("== __classname__ 只读属性 ==");
print(p.__classname__);              // Person（构造自动注入）
print(p["__classname__"]);           // Person
print(p.__classname__ == "Person");  // true
q = {"a": 1};
print(q.__classname__ == null);      // true（普通 map 无此属性）
print(p.name);                       // 张三（原属性不受影响）
// 只读拦截（编译期/运行期）：
//   t.__classname__ = "x";           → 语义错误（编译期）
//   t["__classname__"] = "x";        → 语义错误（编译期）
//   t.set("__classname__", "x");     → Runtime Error（方法链）
//   t.add("__classname__", "x");     → Runtime Error（方法链）
//   t.remove("__classname__");       → Runtime Error（只读不可删）
//   k = "__classname__"; t[k] = "x"; → Runtime Error（动态键兜底）

print("== 多类型 clear 保留 __classname__ ==");
type Product { id: int, price: double }
type Book { title: string, pages: int }
type Car { brand: string, speed: int }
pr = Product(1, 99.5);
bk = Book("Lumin 语言", 300);
cr = Car("BYD", 120);
pr.clear();
bk.clear();
cr.clear();
print(pr.__classname__);       // Product（clear 后类名保留）
print(bk.__classname__);       // Book
print(cr.__classname__);       // Car
print(len(pr.keys()));         // 1（只剩 __classname__）
print(pr.id == null);          // true（普通属性被清）
print(bk.title == null);       // true
print(cr.speed == null);       // true
print(cr.clear().__classname__);  // Car（再次 clear 仍保留，链式返回自身）
print(cr.brand == null);       // true（第二次 clear 后仍无普通属性）
plain = {"x": 1, "y": 2};      // 普通 map 无 __classname__
plain.clear();
print(len(plain.keys()));      // 0
print(plain == {});            // true
a = [1, 2, 3];
a = a.clear();                 // 引用语义：clear 原地清空（与 add/remove 一致）
print(len(a));                 // 0
print(a == []);                // true
print(len([9, 8].clear()));    // 0（链式：clear 结果直接用）
// clear 链式：构造 → clear → 读类名
print(Product(7, 1.5).clear().__classname__);  // Product

print("== range 无 1 亿上限 ==");
// 旧版 range() 有 100000000LL 安全阀；已移除，长度只受内存与 INT_MAX 约束
// （range(100000001) 1.6GB 已双通道临时验证）
print(len(range(5000000)));        // 5000000（5 百万，80MB）
print(range(5000000 - 1, 5000000)[0]);  // 4999999（跨旧上限区间验证）
print(len(range(0, 0, 1)));        // 0（空 range 正常）

print("== 类型构造参数错误（语义检查） ==");
// Person("only one")  单参非 map → 位置构造（name=only one，age 缺省 null）
p4 = Person("only one");
print(p4.name);           // only one
print(p4.age == null);    // true（缺省属性 null）
// 下面这行会被 typecheck 拦截（需 2 个或单 map，实际 3 个）：
// Person("a", 1, 2);
