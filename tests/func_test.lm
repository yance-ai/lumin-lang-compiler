// ============ 函数调用 / return / break / continue 集成测试 ============
// 运行：./bin/lumin tests/func_test.lm
// 期望输出按行标注在注释里

// ---- 1. 基础函数：定义 + return ----
func add(a, b) {
    return a + b;
}
print(add(3, 4));          // 7

func triple(x) {
    return x * 3;
}
print(triple(5));          // 15

// ---- 2. 多实参（3个以上，验证左嵌套实参链表顺序收集）----
func sum3(a, b, c) {
    return a + b + c;
}
print(sum3(1, 2, 3));      // 6
print(sum3(10, 20, 30));   // 60

// ---- 3. 参数遮蔽全局变量 ----
g = 100;
func shadow(g) {
    return g * 2;
}
print(shadow(5));          // 10
print(g);                  // 100 （全局未被污染）

// ---- 4. 函数内赋值 = 局部变量（遮蔽全局同名，C 语义；读全局仍可达）----
counter = 0;
func inc() {
    counter = counter + 1;   // 读全局 0 → 绑定本帧局部 counter=1
    return counter;
}
print(inc());              // 1
print(inc());              // 1（每次调用独立局部，从全局 0 起步）
print(counter);            // 0（全局未被函数修改）

// ---- 5. 函数内新建局部变量（不在链上→新建在当前帧）----
func local_var() {
    fresh = 42;
    return fresh;
}
print(local_var());        // 42

// ---- 6. 递归：阶乘 ----
func fact(n) {
    if(n <= 1) return 1;
    return n * fact(n - 1);
}
print(fact(5));            // 120
print(fact(10));           // 3628800

// ---- 7. 函数调用函数 ----
func add1(x) {
    return x + 1;
}
func add2(x) {
    return add1(add1(x));
}
print(add2(10));           // 12

// ---- 8. 循环内 return：直接退出函数 ----
func find_index() {
    i = 0;
    while(i < 10) {
        if(i == 5) return i;
        i = i + 1;
    }
    return -1;
}
print(find_index());       // 5

// ---- 9. switch 内 return ----
func sw(x) {
    switch(x) {
    case 1:
        return 100;
    case 2:
        return 200;
    default:
        return 300;
    }
}
print(sw(1));              // 100
print(sw(2));              // 200
print(sw(9));              // 300

// ---- 10. 循环内 break / continue ----
func loop_flow() {
    i = 0;
    while(i < 10) {
        i = i + 1;
        if(i == 3) continue;
        if(i == 6) break;
        print("w-" + i);   // w-1 w-2 w-4 w-5
    }
    j = 0;
    for(j = 0; j < 5; j = j + 1) {
        if(j == 2) continue;
        if(j == 4) break;
        print("f-" + j);   // f-0 f-1 f-3
    }
    return i;
}
print(loop_flow());        // 6

// ---- 11. 字符串返回值（含返回帧内字符串变量的克隆路径）----
func greet(name) {
    return "hello-" + name;
}
print(greet("kai"));       // hello-kai

func getmsg() {
    m = "internal-msg";
    return m;
}
print(getmsg());           // internal-msg
y = getmsg();
print(y);                  // internal-msg （验证无悬垂指针）

// ---- 12. 可变参数 ...rest（打包成数组，无语法观察，验证不崩溃）----
func va(a, ...rest) {
    return a;
}
print(va(1, 2, 3));        // 1

// ---- 13. 无 return 的函数默认返回 nil，程序继续 ----
func no_ret() {
    print("no_ret 执行");
}
no_ret();                  // no_ret 执行
print("end");              // end

// ---- 14. 前向引用：调用在更后面定义的函数（parse期已全局注册）----
print(forward(4));         // 8
func forward(x) {
    return x * 2;
}
print(forward(10));        // 20
