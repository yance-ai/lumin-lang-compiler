// destruct_spread_test.lm —— 解构赋值 + 展开运算符
print("== 1. 解构赋值基础 ==");
a, b = [1, 2];
print(a);  // 1
print(b);  // 2
x, y, z = ["hello", 3.14, true];
print(x);  // hello
print(y);  // 3.14
print(z);  // true
print("== 2. 解构赋值 + 表达式右值 ==");
func mkarr() { return [10, 20, 30]; }
p, q, r = mkarr();
print(p);  // 10
print(q);  // 20
print(r);  // 30
print("== 3. 展开运算符 - 数组 ==");
arr = [3, 4];
r1 = [1, 2, ...arr, 5];
print(len(r1));  // 5
print(r1[0]);    // 1
print(r1[2]);    // 3
print(r1[4]);    // 5
r2 = [...arr, ...arr];
print(len(r2));  // 4
print(r2[0]);    // 3
print(r2[3]);    // 4
r3 = [...[100, 200], 300];
print(r3[0]);    // 100
print(r3[2]);    // 300
print("== 4. 展开运算符 - map ==");
m1 = {"a": 1, "b": 2};
m2 = {...m1, "c": 3};
print(m2["a"]);  // 1
print(m2["c"]);  // 3
print(len(m2));  // 3
m3 = {"x": 10};
m4 = {...m3, "x": 20, "y": 30};  // 后面覆盖前面
print(m4["x"]);  // 20
print(m4["y"]);  // 30
print(len(m4));  // 2
print("== 5. 解构 + 展开组合 ==");
data = [1, [2, 3], 4];
first, inner, last = data;
print(first);  // 1
print(len(inner));  // 2
print(last);   // 4
combined = [...inner, first, last];
print(len(combined));  // 4
print(combined[0]);    // 2
print(combined[3]);    // 4
print("== done ==");
