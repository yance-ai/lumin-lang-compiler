// match_type_test.lm —— match/case 类型匹配测试
// case int: / case string: / case double: / case bool: / default:

func describe(x) {
    match (x) {
        case int:
            return "integer";
        case string:
            return "string";
        case double:
            return "double";
        case bool:
            return "boolean";
        default:
            return "other";
    }
}

print(describe(42));           // integer
print(describe("hello"));      // string
print(describe(3.14));         // double
print(describe(true));         // boolean
print(describe([1,2,3]));      // other
print(describe(null));         // other

print("ALL MATCH TYPE TESTS DONE");
