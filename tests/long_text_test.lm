// 长文本字符串测试：repeat 生成 5000 字符
s = repeat("hello", 1000);
print(len(s));
print(substr(s, 0, 5));
print(substr(s, 4995, 5));
print(contains(s, "hello"));
u = toupper(s);
print(len(u));
print(substr(u, 0, 5));
r = replace(s, "hello", "hi");
print(len(r));
print(substr(r, 0, 2));
parts = split(repeat("a,b,", 2000), ",");
print(len(parts));
print(parts[0]);
print(parts[4000]);
j = join(parts, "|");
print(len(j));
n = repeat("x", 100000);
print(len(n));
