// map 红黑树自适应压力测试
// 覆盖：树化触发(桶>8且cap>=64)、退化(<6)、resize/rehash、大数据量、多线程并发、自定义type键
print("=== 第1节：基础 CRUD（小数据，验证链表路径） ===");
m = {0: 0};
m = m.remove(0);
for (i = 0; i < 50; i = i + 1) { m[i] = i * 2; }
ok = 1;
for (i = 0; i < 50; i = i + 1) { if (m[i] != i * 2) { ok = 0; print("FAIL small get" + (string)(i)); } }
print("small 50 entries CRUD:" + (string)(ok ? "PASS" : "FAIL"));
print("len:" + (string)(len(m)));

print("=== 第2节：触发树化（插入 200 个元素，必然有桶>8 且 cap>=64） ===");
big = {0: 0};
big = big.remove(0);
for (i = 0; i < 200; i = i + 1) { big["key_" + (string)(i)] = i; }
ok2 = 1;
for (i = 0; i < 200; i = i + 1) { if (big["key_" + (string)(i)] != i) { ok2 = 0; print("FAIL big get" + (string)(i)); } }
print("200 entries treeify CRUD:" + (string)(ok2 ? "PASS" : "FAIL"));
print("len:" + (string)(len(big)));

print("=== 第3节：删除触发退化（删到桶<6） ===");
del_ok = 1;
for (i = 0; i < 150; i = i + 1) {
    k = "key_" + (string)(i);
    if (!big.has(k)) { del_ok = 0; print("FAIL has before del" + (string)(i)); }
    big = big.remove(k);
    if (big.has(k)) { del_ok = 0; print("FAIL still has after del" + (string)(i)); }
}
print("delete 150 (untreeify):" + (string)(del_ok ? "PASS" : "FAIL"));
print("remaining len:" + (string)(len(big)));
rem_ok = 1;
for (i = 150; i < 200; i = i + 1) { if (big["key_" + (string)(i)] != i) { rem_ok = 0; } }
print("remaining 50 readable:" + (string)(rem_ok ? "PASS" : "FAIL"));

print("=== 第4节：大数据量 10000 元素（大量 resize + rehash） ===");
huge = {0: 0};
huge = huge.remove(0);
for (i = 0; i < 10000; i = i + 1) { huge[i] = i * i; }
huge_ok = 1;
for (i = 0; i < 10000; i = i + 1) { if (huge[i] != i * i) { huge_ok = 0; break; } }
print("10000 int keys CRUD:" + (string)(huge_ok ? "PASS" : "FAIL"));
print("len:" + (string)(len(huge)));

print("=== 第5节：自定义 type 作为键（值比较+哈希） ===");
type Point {
    x: int,
    y: int
}
p1 = Point(1, 2);
p2 = Point(1, 2);
p3 = Point(3, 4);
pm = {0: 0};
pm = pm.remove(0);
pm[p1] = "first";
pm[p3] = "third";
print("p1==p2:" + (string)(p1 == p2 ? "true" : "false"));
print("pm[p1]:" + (string)(pm[p1]));
print("pm[p2] (值相等应命中):" + (string)(pm[p2]));
print("pm[p3]:" + (string)(pm[p3]));
print("len:" + (string)(len(pm)));
pm[p2] = "overwritten";
print("after pm[p2] overwrite, len:" + (string)(len(pm)));
print("pm[p1]:" + (string)(pm[p1]));

print("=== 第6节：自定义 type 嵌套作为键 ===");
type Line {
    start: map,
    end: map
}
l1 = Line(Point(0, 0), Point(1, 1));
l2 = Line(Point(0, 0), Point(1, 1));
lm_map = {0: 0};
lm_map = lm_map.remove(0);
lm_map[l1] = "lineA";
print("nested type key lm_map[l1]:" + (string)(lm_map[l1]));
print("nested type key lm_map[l2] (值相等):" + (string)(lm_map[l2]));
print("len:" + (string)(len(lm_map)));

print("=== 第7节：混合类型键（int/string/char/bool/double/type 同表） ===");
mix = {0: 0};
mix = mix.remove(0);
mix[42] = "int_key";
mix["hello"] = "str_key";
mix['z'] = "char_key";
mix[true] = "bool_key";
mix[3.14] = "double_key";
pk = Point(5, 6);
mix[pk] = "type_key";
print("mix[42]:" + (string)(mix[42]));
print("mix[hello]:" + (string)(mix["hello"]));
print("mix[z]:" + (string)(mix['z']));
print("mix[true]:" + (string)(mix[true]));
print("mix[3.14]:" + (string)(mix[3.14]));
print("mix[Point(5,6)]:" + (string)(mix[pk]));
print("len:" + (string)(len(mix)));

print("=== 第8节：多线程并发写同一个 map（10 线程 x 1000 次） ===");
shared = {0: 0};
shared = shared.remove(0);
mutex = mutex();
func worker(id) {
    for (i = 0; i < 1000; i = i + 1) {
        lock(mutex);
        shared["t" + (string)(id) + "_" + (string)(i)] = id * 1000 + i;
        unlock(mutex);
    }
}
threads = [];
for (t = 0; t < 10; t = t + 1) { threads = threads.add(thread(worker, t)); }
for (t = 0; t < 10; t = t + 1) { thread_join(threads[t]); }
print("concurrent write len (expect 10000):" + (string)(len(shared)));
cw_ok = 1;
for (t = 0; t < 10; t = t + 1) {
    for (i = 0; i < 1000; i = i + 1) {
        if (shared["t" + (string)(t) + "_" + (string)(i)] != t * 1000 + i) { cw_ok = 0; }
    }
}
print("concurrent write verify:" + (string)(cw_ok ? "PASS" : "FAIL"));

print("=== 第9节：多线程并发读 + 写（5写5读，各500次） ===");
shared2 = {0: 0};
shared2 = shared2.remove(0);
m2 = mutex();
for (i = 0; i < 100; i = i + 1) { shared2[i] = i; }
func writer(id) {
    for (i = 0; i < 500; i = i + 1) {
        lock(m2);
        shared2[i % 100] = id * 1000 + i;
        unlock(m2);
    }
}
func reader(id) {
    sum = 0;
    for (i = 0; i < 500; i = i + 1) {
        lock(m2);
        v = shared2[i % 100];
        sum = sum + v;
        unlock(m2);
    }
    return sum;
}
ts = [];
for (t = 0; t < 5; t = t + 1) { ts = ts.add(thread(writer, t)); }
for (t = 0; t < 5; t = t + 1) { ts = ts.add(thread(reader, t)); }
for (t = 0; t < 10; t = t + 1) { thread_join(ts[t]); }
print("concurrent rw len (expect 100):" + (string)(len(shared2)));
print("concurrent rw: PASS (no crash)");

print("=== 第10节：红黑树路径下的删除（大数据量删一半） ===");
rb = {0: 0};
rb = rb.remove(0);
for (i = 0; i < 500; i = i + 1) { rb["k" + (string)(i)] = i; }
for (i = 0; i < 250; i = i + 1) { rb = rb.remove("k" + (string)(i)); }
rb_ok = 1;
for (i = 0; i < 250; i = i + 1) { if (rb.has("k" + (string)(i))) { rb_ok = 0; } }
for (i = 250; i < 500; i = i + 1) { if (rb["k" + (string)(i)] != i) { rb_ok = 0; } }
print("rbtree delete half:" + (string)(rb_ok ? "PASS" : "FAIL"));
print("len after delete:" + (string)(len(rb)));

print("=== 第11节：clear 后复用（验证桶重置） ===");
rb = rb.clear();
print("after clear len:" + (string)(len(rb)));
for (i = 0; i < 100; i = i + 1) { rb[i] = i + 1000; }
cl_ok = 1;
for (i = 0; i < 100; i = i + 1) { if (rb[i] != i + 1000) { cl_ok = 0; } }
print("reuse after clear:" + (string)(cl_ok ? "PASS" : "FAIL"));

print("=== 第12节：自定义 type 键 + 多线程（4线程 x 500次 Color 键） ===");
type Color {
    r: int,
    g: int,
    b: int
}
cmap = {0: 0};
cmap = cmap.remove(0);
cm = mutex();
func color_worker(id) {
    for (i = 0; i < 500; i = i + 1) {
        c = Color(id*500+i, (id*500+i)*7+1, (id*500+i)*13+2);
        lock(cm);
        cmap[c] = id * 500 + i;
        unlock(cm);
    }
}
cts = [];
for (t = 0; t < 4; t = t + 1) { cts = cts.add(thread(color_worker, t)); }
for (t = 0; t < 4; t = t + 1) { thread_join(cts[t]); }
print("custom type key concurrent len:" + (string)(len(cmap)));
ct_ok = 1;
for (t = 0; t < 4; t = t + 1) {
    for (i = 0; i < 500; i = i + 1) {
        c = Color(t*500+i, (t*500+i)*7+1, (t*500+i)*13+2);
        if (cmap[c] != t * 500 + i) { ct_ok = 0; }
    }
}
print("custom type key concurrent verify:" + (string)(ct_ok ? "PASS" : "FAIL"));

print("=== ALL DONE ===");
