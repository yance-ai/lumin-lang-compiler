// full_test.lm —— 全语言特性交叉验证（动态类型 + 各特性组合）
// 预期输出按行标注；双通道（VM / -c）输出必须逐行一致

// ============ 1. 动态类型切换（同一变量反复赋值不同类型，含 null 往返） ============
x = 42;
print(x);                // 42
print(type(x));          // int
x = "hello";
print(x);                // hello
print(type(x));          // string
x = null;
print(x);                // null
print(type(x));          // none
x = true;
print(type(x));          // bool
x = 'c';
print(type(x));          // char
x = 3.14;
print(type(x));          // double
x = [1, 2, 3];
print(type(x));          // array
print(len(x));           // 3
x = null;                // 再回 null
print(x);                // null
x = func(v) { return v; };
print(type(x));          // func
print(x("fn"));          // fn

// ============ 2. 数值运算交叉 ============
print(2 + 3 * 4);        // 14
print((2 + 3) * 4);      // 20
print(10 / 4);           // 2.5
print(10 % 4);           // 2
print(-10 % 3);          // -1
print(1 + 2.5);          // 3.5
print(2.5 * 2);          // 5
print(7 / 2.0);          // 3.5
n = 5;
n += 3; print(n);        // 8
n *= 2; print(n);        // 16
n -= 5; print(n);        // 11
n /= 2; print(n);        // 5.5
i = 1;
i++; print(i);           // 2
i--; print(i);           // 1
print(1 < 2 && 3 > 2);   // true
print(1 > 2 || 3 > 2);   // true
print(!true);            // false
print(5 > 3 ? "big" : "small");  // big

// ============ 3. 字符串交叉 ============
s = "Hello, World";
print(len(s));               // 12
print(substr(s, 0, 5));      // Hello
print(substr(s, 7, 5));      // World
print(toupper(s));           // HELLO, WORLD
print(tolower(s));           // hello, world
print(s[0]);                 // H
print(s[1]);                 // e
print(contains(s, "World")); // true
print(startswith(s, "Hello")); // true
print(endswith(s, "World"));   // true
print(strip("  pad  "));       // pad
parts = split("a,b,c", ",");
print(len(parts));           // 3
print(join(parts, "-"));     // a-b-c
print(repeat("ab", 3));      // ababab
print(replace("banana", "na", "NA")); // baNANA
print(format("{} + {} = {}", 1, 2, 3)); // 1 + 2 = 3
name = "lumin";
nn = 99;
print("hi {name} #{nn}");       // hi lumin #99
print("{{x}}={nn}");            // {x}=99
print("s[0]={s[0]} up={toupper(name)}"); // s[0]=H up=LUMIN
print("a" + "b" + "c");         // abc
print("v=" + 7);                // v=7
print(7 + "v");                 // 7v

// ============ 4. 数组交叉 ============
arr = [3, 1, 4, 1, 5, 9, 2, 6];
print(len(arr));               // 8
print(sum(arr));               // 31
print(avg(arr));               // 3.875
print(max(3, 1, 4));           // 4
print(min(5, 9, 2));           // 2
print(join(sort(arr), ","));       // 1,1,2,3,4,5,6,9
print(join(reverse(arr), ","));    // 6,2,9,5,1,4,1,3
mixed = [1, "two", null, true, 'c', 3.5];
print(mixed[0]);               // 1
print(mixed[1]);               // two
print(mixed[2]);               // null
print(mixed[3]);               // true
print(mixed[4]);               // c
print(mixed[5]);               // 3.5
print(type(mixed[2]));         // none
mixed[1] = "TWO";
print(mixed[1]);               // TWO
print(len(mixed));             // 6
darr = del(mixed, 1);
print(len(darr));              // 5
print(darr[1]);                // null
iarr = insert(mixed, 1, "mid");
print(len(iarr));              // 7
print(iarr[1]);                // mid
md = [[1, 2], [3, 4], [5, 6]];
print(md[0][1]);               // 2
print(md[2][0]);               // 5
md3 = [[[1]], [[2]]];
print(md3[1][0][0]);           // 2
print(len(md));                // 3
print(contains(mixed, "TWO")); // true
print(sum(md[0]));             // 3

// ============ 5. 函数交叉 ============
func fact(n) { if (n <= 1) { return 1; } return n * fact(n - 1); }
print(fact(5));                // 120
func fib(n) { if (n < 2) { return n; } return fib(n - 1) + fib(n - 2); }
print(fib(10));                // 55
func greet(name) { return "hi " + name; }
print(greet("kai"));           // hi kai
func sum_all(...nums) { return sum(nums); }
print(sum_all(1, 2, 3, 4));    // 10
print(sum_all());              // 0
base = 10;
func add_base(x) { return x + base; }   // 函数访问全局
print(add_base(5));            // 15
f = func(x) { return x * 2; };
print(f(21));                  // 42
print(join(map([1, 2, 3], f), ","));   // 2,4,6
print(join(map([1, 2, 3], func(v) { return v * v; }), ",")); // 1,4,9
print(reduce([1, 2, 3, 4], func(a, b) { return a + b; }, 0)); // 10
func squares(n) { return map(range(n), func(x) { return x * x; }); }
print("sq2={squares(3)[1]}");  // sq2=1
g2 = fact;                     // 具名函数赋值
print(g2(6));                  // 720
g2 = 42;                       // 变量改存数字
print(g2);                     // 42
g2 = "str";
print(g2);                     // str

// ============ 6. 控制流交叉 ============
x = 7;
if (x > 10) { print("big"); } else if (x > 5) { print("mid"); } else { print("small"); }  // mid
x = 2;
if (x > 10) { print("big"); } else if (x > 5) { print("mid"); } else { print("small"); }  // small
cnt = 0;
while (cnt < 4) { print(cnt); cnt++; }   // 0 1 2 3
for (i = 0; i < 6; i++) {
    if (i % 2 == 1) { continue; }
    if (i >= 5) { break; }
    print(i);
}                                          // 0 2 4
day = 3;
switch (day) { case 1: print("mon"); break; case 2: print("tue"); break; case 3: print("wed"); break; default: print("?"); }  // wed
switch (day) { case 1: print("mon"); break; default: print("other"); }  // other
for (i = 0; i < 2; i++) { for (j = 0; j < 2; j++) { print(i * 10 + j); } }  // 0 1 10 11

// ============ 7. 强转交叉 ============
print((int)3.99);            // 3
print((double)7);            // 7
print((string)3.14);         // 3.14
print((string)true);         // true
print((bool)1);              // true
print((bool)0);              // false
print((char)65);             // A
print((ASCII)'a');           // 97
print((int)'5');             // 53
print((int)"42");            // 42
print((int)"  42  ");        // 42
print((int)"3.9");           // 3
print((double)"3.14");       // 3.14

// ============ 8. 综合交叉 ============
words = ["hello", "world", "lumin"];
print(join(map(words, func(w) { return toupper(w); }), ","));  // HELLO,WORLD,LUMIN
words2 = ["a", "bb", "ccc"];
print(join(map(words2, func(w) { return w + "!"; }), " "));    // a! bb! ccc!
v = 1;
print("v={v}");              // v=1
v = "one";
print("v={v}");              // v=one
v = null;
print("v={v}");              // v=null
nums = [10, 20, 30];
print(sum(nums) + max(nums));    // 90
print(avg(nums) * 2);            // 40
print(join(reverse(split("1,2,3", ",")), "-"));  // 3-2-1
print(join(range(4), ","));      // 0,1,2,3
print(join(range(1, 5), ","));   // 1,2,3,4
print(join(range(5, 1, -1), ",")); // 5,4,3,2
m2 = [1 + 2, len("abc"), "x" + "y", (int)2.7];
print(m2[0]);                // 3
print(m2[1]);                // 3
print(m2[2]);                // xy
print(m2[3]);                // 2
print(join(map(m2, func(m) { return format("{}", m); }), ",")); // 3,3,xy,2

// ============ 9. 调用链 + 方法链 ============
func get_plus2() { return func(x) { return x + 2; }; }
print(get_plus2()(10));                 // 12
f = func(a) { return func(b) { return b * 2; }; };
print(f(1)(21));                        // 42
g = func() { return func() { return func() { return 99; }; }; };
print(g()()());                         // 99
print((func(x) { return x + 1; })(41)); // 42
arrf = [func() { return func() { return 7; }; }];
print(arrf[0]()());                     // 7
s = "  Hello World  ";
print(s.strip());                       // Hello World
print(s.strip().toupper());             // HELLO WORLD
print(s.strip().len());                 // 11
print(s.strip().substr(0, 5));          // Hello
print("a,b,c".split(",").len());        // 3
print("banana".replace("a", "o"));      // bonono
print("abc".contains("bc"));            // true
print(join("a,b,c".split(","), "-"));   // a-b-c
arr = [3, 1, 2];
print(join(arr.sort(), ","));           // 1,2,3
print(arr.len());                       // 3
print([1, 2, 3].sum());                 // 6
print([1, 2, 3].avg());                 // 2
nm = " lumin ";
print("[{nm.strip().toupper()}]");      // [LUMIN]

// ============ 10. 动态字符串内插安全性 ============
server = "hello {{name}}";            // 运行时值 hello {{name}}（源码 {{ 转义）
print("{server}");                    // hello {{name}}（原样，不二次解析）
srv2 = "price: {}";
print("{srv2}");                      // price: {}（原样）
srv3 = "a}" + "{{" + "c";             // 运行时值 a}{{c
print("{srv3}");                      // a}{{c（原样）
n2 = 5;
t2 = "x={n2}";
print(t2);                            // x=5（模板已求值）
print("{t2}");                        // x=5（原样，不二次内插）
print("{{x}} {n2}");                // {x} 5（{{ 转义 + {n2} 内插混合）
print(format("{{x}} {}", n2));      // {x} 5（format 占位 + 转义混合）
print("v={\"a{b}c\".len()}");         // v=5（内插表达式内字符串用 \"）

// ============ 11. 文件 IO ============
print(file_exists("/tmp/ft_io_nonexist.txt")); // false
write "/tmp/ft_io.txt" "alpha\nbeta\n";
print(file_exists("/tmp/ft_io.txt"));        // true
print(read "/tmp/ft_io.txt");                // alpha\nbeta\n
print(len(read "/tmp/ft_io.txt"));           // 11
print((read "/tmp/ft_io.txt").strip());      // alpha\nbeta
lines = split((read "/tmp/ft_io.txt").strip(), "\n");
print(join(lines, "|"));                     // alpha|beta
print(lines[1]);                             // beta
write "/tmp/ft_io.txt" "overwrite";
print(read "/tmp/ft_io.txt");                // overwrite
write "/tmp/ft_io.txt" "n={42}";
print(read "/tmp/ft_io.txt");                // n=42
idx = 2;
write "/tmp/ft_data_{idx}.txt" "x";          // 模板路径
print(file_exists("/tmp/ft_data_2.txt"));    // true
print(read "/tmp/ft_data_2.txt");            // x

// ============ 12. 字典 / 哈希表 ============
d = {"name": "kai", "age": 30};
print(len(d));                    // 2
print(d["name"]);                 // kai
print(d["missing"]);              // null
print(contains(d, "age"));        // true
d["city"] = "chongqing";
print(len(d));                    // 3
print(d["city"]);                 // chongqing
ks = keys(d);
print(join(ks, ","));             // name,age,city
print(len(values(d)));            // 3
print(type(d));                   // map
d2 = del(d, "age");
print(len(d2));                   // 2
print(contains(d2, "age"));       // false
d3 = {"a": {"b": 42}, "arr": [1, 2]};
print(d3["a"]["b"]);              // 42
print(d3["arr"][1]);              // 2
d4 = {};                          // 空字典
print(len(d4));                   // 0
d5 = {x: 1, y: "two"};            // ID 键（字面量）
print(d5["x"]);                   // 1
print(d5 == {"x": 1, "y": "two"});// true
print(d5 == {"x": 2});            // false
print(join(keys(d5), "-"));       // x-y

// ================= 第 13 节：try/catch 错误处理 =================
try {
    a = [1, 2];
    b = a[5];                 // 越界 → 捕获
    print("unreachable");
} catch (e) {
    print("c1: " + e);        // c1: 数组下标越界: 5 (长度 2)
}
print("after1");              // after1

// 嵌套：内层捕获；catch 内再出错冒泡外层
try {
    try {
        a = [1];
        b = a[9];
    } catch (e2) {
        print("c2: " + e2);   // c2: 数组下标越界: 9 (长度 1)
        c = a[99];            // catch 内越界 → 冒泡外层
    }
} catch (e) {
    print("c3: " + e);        // c3: 数组下标越界: 99 (长度 1)
}
print("after2");              // after2

// 跨函数错误 + 错误消息模板内插
func boom(i) { x = [1, 2, 3]; return x[i]; }
try { y = boom(10); } catch (err) { print("c4: {err}"); }  // c4: 数组下标越界: 10 (长度 3)

// 循环内 try + continue
s = 0;
for (i = 0; i < 5; i++) {
    try {
        if (i == 3) { s = s + [9][i]; }
        s = s + 1;
    } catch (e) {
        print("c5: iter {i}");  // c5: iter 3
        continue;
    }
}
print("s=" + s);              // s=4

// try 块内 return 正常执行
func f() { try { return 42; } catch (e) { print("no"); } return 0; }
print("f=" + f());            // f=42

// ================= 第 14 节：throw / 错误对象 / finally =================
// throw 字符串 → catch 错误对象
try {
    throw "err14";
} catch (e) {
    print("d1: " + e);              // d1: err14
    print("d2: " + type(e));        // d2: error
    print("d3: " + e["type"]);      // d3: Error
    print("d4: " + e["message"]);   // d4: err14
}
// 错误对象与字符串比较（向后兼容）
try {
    throw "oops";
} catch (e) {
    print("d5: " + (e == "oops"));  // d5: true
}
// throw map {type,message} → 提取字段
try {
    throw {"type":"MyError","message":"custom"};
} catch (e) {
    print("d6: " + e["type"]);      // d6: MyError
    print("d7: " + e["message"]);   // d7: custom
}
// try-catch-finally 正常路径
try {
    print("d8: body");
} catch (e) {
    print("d8: catch");
} finally {
    print("d8: finally");
}
print("d8: after");
// try-catch-finally 异常路径
try {
    throw "e9";
} catch (e) {
    print("d9: catch " + e);
} finally {
    print("d9: finally");
}
// try-finally（无 catch）异常冒泡到外层 catch
func f14() {
    try {
        print("d10: inner");
        throw "e10";
    } finally {
        print("d10: fin");
    }
}
try { f14(); } catch (e) { print("d10: outer " + e); }
// return 穿透 finally
func f14b() {
    try {
        return 14;
    } finally {
        print("d11: fin");
    }
}
print("d11: ret=" + f14b());
// break/continue 穿透 finally
s14 = 0;
for (i = 0; i < 4; i++) {
    try {
        if (i == 1) { continue; }
        if (i == 3) { break; }
        s14 = s14 + i;
    } finally {
        s14 = s14 + 10;
    }
}
print("d12: s=" + s14);   // d12: s=42
// 栈回溯跨函数
func g14() { return h14(); }
func h14() { throw "deep14"; }
try { g14(); } catch (e) {
    print("d13: has g: " + contains(e["stack"], "g14"));
    print("d13: has h: " + contains(e["stack"], "h14"));
}
// 嵌套 try-finally：内层 finally 先跑，异常冒泡外层 catch
try {
    try {
        throw "nest";
    } finally {
        print("d14: inner fin");
    }
} catch (e) {
    print("d14: outer " + e);
}
