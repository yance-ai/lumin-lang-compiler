// lambda_full_test.lm —— 匿名函数（lambda）全面测试
//
// 测试覆盖场景：
//   1. 基础：赋值、调用、作为参数传递（map/filter/reduce）
//   2. 全局变量访问（lambda 允许访问全局变量）
//   3. lambda 内部局部变量
//   4. lambda 作为返回值（无捕获，无 UAF 风险）
//   5. lambda 存入数组/字典并调用
//   6. 变参 lambda（...args）
//   7. type() 对 lambda 的返回值
//   8. lambda 递归（通过全局变量自引用）
//   9. 多参数 lambda
//  10. lambda 与线程（thread 内置函数）
//  11. 大量 lambda 分配 + GC 压力
//  12. lambda 返回值链式调用 f()(x)
//
// 设计说明：
//   lumin 的 lambda 是"无闭包"设计——编译期（ast_typecheck.c）强制禁止
//   lambda 体访问外层函数局部变量，只能访问：自身参数、全局变量、
//   以及 lambda 体内赋值产生的局部变量。这从根本上杜绝了 UAF 和
//   闭包生命周期问题。本测试验证该设计下的所有可用场景。

// ===== 1. 基础：赋值、调用 =====
g = func(x) { return x + 10; };
print(g(5));                          // 15
print(g(0));                          // 10

// 多参数
add_fn = func(a, b) { return a + b; };
print(add_fn(3, 4));                  // 7

// ===== 2. 作为高阶参数传递 =====
arr = [1, 2, 3, 4, 5];
print(join(map(arr, func(x) { return x * x; }), ","));   // 1,4,9,16,25
print(join(filter(arr, func(x) { return x % 2 == 0; }), ","));  // 2,4
print(reduce(arr, func(acc, v) { return acc + v; }, 0));  // 15

// lambda 带条件逻辑
print(join(map(arr, func(x) { if (x > 2) { return x * 10; } else { return x; } }), ","));  // 1,2,30,40,50

// ===== 3. 全局变量访问 =====
g_multiplier = 3;
mul_global = func(x) { return x * g_multiplier; };
print(mul_global(7));                 // 21

// 修改全局变量后 lambda 读取新值
g_multiplier = 10;
print(mul_global(7));                 // 70

// lambda 读取全局变量（写全局会被词法遮蔽为局部，见下方说明）
counter = 0;
bump = func() { counter = counter + 1; return counter; };
print(bump());                        // 1（读全局 counter=0，+1=1，但写入为局部）
print(bump());                        // 1（每次调用都读全局 counter=0）
print(bump());                        // 1
print(counter);                       // 0（全局 counter 从未被修改）
// 设计说明：lumin 函数/lambda 内的赋值总是绑定当前帧局部（C 语义词法遮蔽），
// 不会沿帧链更新全局。要修改全局需在 main 帧直接操作或通过参数返回。

// ===== 4. lambda 内部局部变量 =====
local_sum = func(a, b) {
    s = a + b;
    d = s * 2;
    return d;
};
print(local_sum(3, 4));               // 14

// lambda 内 if/for 控制流
fib_like = func(n) {
    result = 0;
    for (i = 0; i < n; i = i + 1) {
        result = result + i;
    }
    return result;
};
print(fib_like(5));                   // 10 (0+1+2+3+4)

// ===== 5. lambda 作为返回值 =====
func make_double() {
    return func(x) { return x * 2; };
}
dbl = make_double();
print(dbl(21));                       // 42

// 设计说明：lumin 不支持 lambda 捕获外层函数局部变量。
// 例如 func make_adder(n) { return func(x) { return x + n; }; } 会被
// 语义检查拒绝（"匿名函数不能访问外层函数局部变量 n"）。
// 需要共享状态时通过全局变量传递：

g_offset = 100;
func make_adder_global() {
    return func(x) { return x + g_offset; };
}
add100 = make_adder_global();
print(add100(5));                     // 105
g_offset = 200;
print(add100(5));                     // 205

// ===== 6. lambda 存入数组/字典 =====
funcs = [
    func(x) { return x + 1; },
    func(x) { return x * 10; },
    func(x) { return x * x; }
];
print(funcs[0](10));                  // 11
print(funcs[1](10));                  // 100
print(funcs[2](10));                  // 100

op_map = {
    "add": func(a, b) { return a + b; },
    "sub": func(a, b) { return a - b; },
    "mul": func(a, b) { return a * b; }
};
print(op_map["add"](3, 4));           // 7
print(op_map["sub"](10, 3));          // 7
print(op_map["mul"](6, 7));           // 42

// 数组中 lambda 的批量调用
vals = [1, 2, 3];
results = map(vals, funcs[0]);
print(join(results, ","));             // 2,3,4

// ===== 7. 变参 lambda =====
sum_all = func(...args) { return sum(args); };
print(sum_all(1, 2, 3));               // 6
print(sum_all(10, 20, 30, 40, 50));   // 150
print(sum_all());                      // 0

join_all = func(sep, ...parts) { return join(parts, sep); };
print(join_all("-", "a", "b", "c"));  // a-b-c

// ===== 8. type() =====
print(type(g));                        // func
print(type(dbl));                      // func
print(type(sum_all));                  // func

// ===== 9. lambda 递归（通过全局变量自引用）=====
g_fact = func(n) {
    if (n <= 1) { return 1; }
    return n * g_fact(n - 1);
};
print(g_fact(5));                      // 120
print(g_fact(10));                     // 3628800

// 递归 lambda 通过 Y 组合子风格
g_fib = func(n) {
    if (n < 2) { return n; }
    return g_fib(n - 1) + g_fib(n - 2);
};
print(g_fib(10));                      // 55

// ===== 10. lambda 与线程 =====
func thread_worker(n) {
    return n * 1000;
}
t1 = thread(func(x) { return x * 2; }, 21);
print(thread_join(t1));               // 42

t2 = thread(thread_worker, 5);
print(thread_join(t2));                // 5000

// 多线程 + lambda 结果聚合
ts = [];
for (i = 0; i < 4; i = i + 1) {
    ts = ts.add(thread(func(x) { return x * x; }, i + 1));
}
sum_th = 0;
for (j = 0; j < 4; j = j + 1) {
    sum_th = sum_th + thread_join(ts[j]);
}
print(sum_th);                         // 1+4+9+16 = 30

// ===== 11. 大量 lambda 分配 + GC 压力 =====
// 创建大量 lambda 存入数组，触发 GC，验证不崩溃
big_funcs = [];
for (k = 0; k < 200; k = k + 1) {
    big_funcs = big_funcs.add(func(x) { return x + 1; });
}
print(len(big_funcs));                 // 200
print(big_funcs[50](10));              // 11

// lambda 内部分配大量对象后调用，验证 GC 正确扫描
func alloc_stress(n) {
    local_arr = [];
    for (m = 0; m < n; m = m + 1) {
        local_arr = local_arr.add(m * m);
    }
    return len(local_arr);
}
print(alloc_stress(100));              // 100

// ===== 12. 闭包链式调用说明 =====
// 设计限制：内层 lambda 不能捕获外层 lambda 的参数。
// 例如 func(x) { return func(y) { return x + y; }; } 会被语义检查拒绝。
// 需要传递中间状态时用全局变量或多参数函数。

g_chain_x = 5;
chain_outer = func(y) { return g_chain_x + y; };
print(chain_outer(100));               // 105

// ===== 13. lambda 作为 map/filter/reduce 的混合使用 =====
people = [
    {"name": "Alice", "age": 30},
    {"name": "Bob", "age": 25},
    {"name": "Carol", "age": 35}
];
names = map(people, func(p) { return p["name"]; });
print(join(names, ","));               // Alice,Bob,Carol

adults = filter(people, func(p) { return p["age"] > 26; });
print(len(adults));                     // 2 (Alice, Carol)

total_age = reduce(people, func(acc, p) { return acc + p["age"]; }, 0);
print(total_age);                       // 90

// ===== 14. lambda 与字符串操作 =====
greet = func(name) { return "Hello, " + name + "!"; };
print(greet("World"));                  // Hello, World!

upper_first = func(s) { return s[0]; };
print(upper_first("test"));             // t

// ===== 15. lambda 无参 =====
always_42 = func() { return 42; };
print(always_42());                     // 42

// ===== 16. lambda 返回布尔值 =====
is_even = func(n) { return n % 2 == 0; };
print(is_even(4));                      // true
print(is_even(7));                      // false

// ===== 17. lambda 嵌套调用其他 lambda =====
dbl_fn = func(x) { return x * 2; };
dbl_and_add = func(x) { return dbl_fn(x) + 1; };
print(dbl_and_add(5));                  // 11
