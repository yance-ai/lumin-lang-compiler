// FFI 扩展类型测试 - 简化版

// ========== 1. 各种整数返回类型 ==========
extern "msvcrt.dll" <int> func atoi(<string>s);
extern "msvcrt.dll" <long> func atol(<string>s);
extern "msvcrt.dll" <int64> func _atoi64(<string>s);
extern "msvcrt.dll" <size_t> func strlen(<string>s);

print("=== 1. Integer Return Types ===");
print("atoi(\"123\") =", atoi("123"));
print("atol(\"456\") =", atol("456"));
print("_atoi64(\"789\") =", _atoi64("789"));
print("strlen(\"hello\") =", strlen("hello"));

// ========== 2. 无符号整数类型 ==========
extern "msvcrt.dll" <long> func strtol(<string>s, <ptr>endptr, <int>base);
extern "msvcrt.dll" <ulong> func strtoul(<string>s, <ptr>endptr, <int>base);
extern "msvcrt.dll" <int64> func _strtoi64(<string>s, <ptr>endptr, <int>base);
extern "msvcrt.dll" <uint64> func _strtoui64(<string>s, <ptr>endptr, <int>base);

print("\n=== 2. Unsigned Integer Types ===");
v1 = strtol("12345", 0, 10);
print("strtol(\"12345\") =", v1);
v2 = strtoul("67890", 0, 10);
print("strtoul(\"67890\") =", v2);
v3 = _strtoi64("111111111111", 0, 10);
print("_strtoi64(\"111111111111\") =", v3);
v4 = _strtoui64("222222222222", 0, 10);
print("_strtoui64(\"222222222222\") =", v4);

// ========== 3. 浮点类型 ==========
extern "msvcrt.dll" <double> func atof(<string>s);
extern "msvcrt.dll" <double> func strtod(<string>s, <ptr>endptr);

print("\n=== 3. Float Types ===");
print("atof(\"3.14159\") =", atof("3.14159"));
d = strtod("2.71828", 0);
print("strtod(\"2.71828\") =", d);

// ========== 4. 字符类型（用 isdigit 测试） ==========
extern "msvcrt.dll" <int> func isdigit(<int>c);

print("\n=== 4. Char Types ===");
r1 = isdigit(53);
print("isdigit(53) =", r1);
r2 = isdigit(97);
print("isdigit(97) =", r2);

// ========== 5. 指针类型别名 ==========
extern "msvcrt.dll" <handle> func malloc(<size_t>size);
extern "msvcrt.dll" <void> func free(<pointer>p);
extern "msvcrt.dll" <ptr> func memset(<ptr>p, <int>value, <size_t>num);

print("\n=== 5. Pointer Type Aliases ===");
p = malloc(64);
print("malloc(64) handle =", p);
if(p != 0) {
    memset(p, 0, 64);
    print("memset(p, 0, 64) done");
    free(p);
    print("free(p) done");
}

print("\n=== All Extended Type Tests Passed ===");
