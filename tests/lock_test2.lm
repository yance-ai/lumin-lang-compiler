// ===== 锁机制严谨测试补充（工程场景） =====
// 覆盖：临界区异常/return + finally 防锁泄漏、锁表扩容、压力放大、
//       多锁独立、锁参数传递、递归深度、读写混合并发、类型错误。
// 全部确定性输出，双通道可逐行 diff；多线程场景若锁泄漏会挂起（回归暴露）。

// 1. 递归互斥锁：100 层重入（深度不受限）+ 持有时 trylock 成功
rd = rmutex();
func rec_rm(r, n) {
    lock(r);
    if (n > 0) { rec_rm(r, n - 1); }
    unlock(r);
}
rec_rm(rd, 100);
lock(rd);
print("rmutex-held-trylock: " + trylock(rd));   // true（递归锁同线程可再入）
unlock(rd);
print("rmutex-depth100: 1");

// 2. 锁表扩容：创建 200 把锁（初始容量 64 → 翻倍扩容，无硬上限）
cnt2 = 0;
for (i = 0; i < 200; i = i + 1) {
    mi = mutex();
    lock(mi);
    unlock(mi);
    cnt2 = cnt2 + 1;
}
print("lock-table-200: " + cnt2);               // 200

// 3. 压力放大：8 线程竞争同一互斥锁，各 5000 次 → 精确 40000
g3 = [0];
gm3 = mutex();
func inc8() {
    for (i = 0; i < 5000; i = i + 1) {
        lock(gm3);
        g3[0] = g3[0] + 1;
        unlock(gm3);
    }
}
t3 = [0,0,0,0,0,0,0,0];
for (k = 0; k < 8; k = k + 1) {
    t3[k] = thread(inc8);
}
for (k = 0; k < 8; k = k + 1) { thread_join(t3[k]); }
print("mutex-8thread: " + g3[0]);               // 40000

// 4. 多锁独立：两把锁分别保护两个计数，并发互不干扰
ga = [0]; gb = [0];
ma = mutex(); mb = mutex();
func work_a() { for (i = 0; i < 3000; i = i + 1) { lock(ma); ga[0] = ga[0] + 1; unlock(ma); } }
func work_b() { for (i = 0; i < 2000; i = i + 1) { lock(mb); gb[0] = gb[0] + 1; unlock(mb); } }
t4a = thread(work_a); t4b = thread(work_b);
thread_join(t4a); thread_join(t4b);
print("two-locks: " + ga[0] + " " + gb[0]);     // 3000 2000

// 5. 锁作为参数在调用链传递（锁 id 是 int，标量值传递；数组为深拷贝不可共享）
g5 = [0];
func guarded(lockid) {
    lock(lockid);
    g5[0] = g5[0] + 1;
    unlock(lockid);
}
func caller(lockid, n) {
    for (i = 0; i < n; i = i + 1) { guarded(lockid); }
}
m5 = mutex();
t5a = thread(caller, m5, 4000);
t5b = thread(caller, m5, 4000);
thread_join(t5a); thread_join(t5b);
print("lock-passed: " + g5[0]);                 // 8000

// 6. 临界区 + 异常 + finally unlock（防锁泄漏：漏 unlock 第二个线程会挂起）
g6 = [0];
gm6 = mutex();
func risky(n) {
    lock(gm6);
    try {
        g6[0] = g6[0] + 1;
        if (n == 1) { throw "boom"; }
        return 0;
    } catch (e) {
        return -1;       // 捕获后 finally 释放锁
    } finally {
        unlock(gm6);
    }
}
t6a = thread(risky, 0);
t6b = thread(risky, 1);      // 抛异常 → catch → finally 释放锁
r6a = thread_join(t6a);
r6b = thread_join(t6b);
print("finally-unlock: " + r6a + " " + r6b + " " + g6[0]);   // 0 -1 2

// 7. 临界区 + return + finally unlock（return 穿透 finally 释放锁）
g7 = [0];
gm7 = mutex();
func early(n) {
    lock(gm7);
    try {
        g7[0] = g7[0] + 1;
        return n * 10;
    } finally {
        unlock(gm7);
    }
}
t7a = thread(early, 1);
t7b = thread(early, 2);
r7a = thread_join(t7a);
r7b = thread_join(t7b);
// 两线程都成功返回（若锁泄漏会阻塞），计数精确
print("return-finally: " + r7a + " " + r7b + " " + g7[0]);   // 10 20 2

// 8. 读写锁混合并发：2 读线程 + 2 写线程（写计数精确；读线程只读，无死锁）
g8 = [0];
rw8 = rwlock();
func writer8() { for (i = 0; i < 3000; i = i + 1) { wrlock(rw8); g8[0] = g8[0] + 1; unlock(rw8); } }
func reader8() {
    for (i = 0; i < 2000; i = i + 1) {
        rdlock(rw8);
        x = g8[0];           // 只读（读锁共享，多读线程可并发进入）
        unlock(rw8);
    }
}
w8a = thread(writer8); w8b = thread(writer8);
r8a = thread(reader8); r8b = thread(reader8);
thread_join(w8a); thread_join(w8b); thread_join(r8a); thread_join(r8b);
print("rw-mixed: " + g8[0] + " readers-done");  // 6000 readers-done

// 9. 自旋锁高压：4 线程 × 3000 → 精确 12000
g9 = [0];
sp9 = spinlock();
func spinc() { for (i = 0; i < 3000; i = i + 1) { lock(sp9); g9[0] = g9[0] + 1; unlock(sp9); } }
s9a = thread(spinc); s9b = thread(spinc); s9c = thread(spinc); s9d = thread(spinc);
thread_join(s9a); thread_join(s9b); thread_join(s9c); thread_join(s9d);
print("spin-4thread: " + g9[0]);                // 12000

// 10. 类型错误：lock 非整数 / trylock 读写锁（运行时错误，try/catch 捕获）
try {
    lock("not-a-lock");
} catch (e) {
    print("err-lock-string: caught");
}
rw10 = rwlock();
try {
    trylock(rw10);          // trylock 不适用于读写锁 → 报错
} catch (e) {
    print("err-trylock-rw: caught");
}
print("lock-test2-done");
