// byte 数据类型全场景测试（双通道：VM 与 C 编译输出必须一致）
print("== byte 强转 ==");
print((byte)65);          // int → 65
print((byte)300);         // C 风格截断 8 位 → 44
print((byte)(-1));        // 负 → 255
print((byte)3.99);        // double 截断 → 3
print((byte)true);        // bool → 1
print((byte)false);       // bool → 0
print((byte)'A');         // char → 65
print((byte)"255");       // string 解析 → 255
print((byte)"12");        // string → 12
print((byte)null);        // none → 0

print("== type / 打印 ==");
b = (byte)42;
print(type(b));           // byte
print(b);                 // 42
print((byte)0);           // 0
print((byte)255);         // 255（不溢出）

print("== 算术（byte 提升数值类型）==");
print(b + 1);             // 43
print((byte)10 + (byte)20); // 30
print((byte)200 + 100);   // 300（数值运算不截断）
print(b * 2);             // 84
print((byte)7 / 2);       // 3.5
print((byte)9 % 4);       // 1
print(-(byte)5);          // -5
print((byte)3 < 4);       // true（数值比较）

print("== 比较 ==");
print((byte)65 == (byte)65); // true（同类型数值比较）
print((byte)65 == 65);       // true（数值弱比较，与 char 同语义）
print((byte)65 == 66);       // false
print((byte)1 != (byte)2);   // true

print("== 容器 ==");
arr = [(byte)1, (byte)2, (byte)3];
print(arr[0]);            // 1
print(arr[2]);            // 3
m = {"k": (byte)7};
print(m["k"]);            // 7

print("== 字符串拼接 ==");
s = "v=" + (byte)99;
print(s);                 // v=99
print((byte)10 + (byte)20 == 30); // true

print("== 常量折叠（编译期 (byte)x）==");
print((byte)200 + (byte)55);  // 255
print((byte)256);             // 0（截断）
print((byte)257);             // 1

print("== 与函数/控制流 ==");
func getb() { return (byte)8; }
print(getb());            // 8
for (i = 0; i < 3; i = i + 1) {
    print((byte)(100 + i));  // 100 101 102
}

print("== 边界 ==");
print((byte)"300");       // 44（string 解析后截断）
print((byte)128);         // 128
print((byte)127);         // 127
print((byte)"abc");       // atoll("abc") = 0 → 0

print("== 泛型容器（尖括号类型标注）==");
gb = <byte>[1, 2, 300];
print(gb[0]);             // 1
print(type(gb[0]));       // byte
print(gb[2]);             // 44（300 截断）
gs = <string>[1, 65, true];
print(gs[1]);             // 65
gi = <int>["42", "7"];
print(gi[0] + gi[1]);     // 49
gm = <string, byte>{"a": 1, "b": 300};
print(gm["a"]);           // 1
print(type(gm["a"]));     // byte
print(gm["b"]);           // 44（截断）
gmi = <string, int>{"x": "10", "y": "32"};
print(gmi["x"] + gmi["y"]); // 42
print(type(gm));          // map（容器泛型保持容器类型）

print("== cast 容器形式（等价，补充语法）==");
cb = (byte)[1, 2, 3];
print(cb[2]);             // 3
print(type(cb[1]));       // byte
cm = (int){"a": "7", "b": "8"};
print(cm["a"] + cm["b"]); // 15

print("== 泛型容器做参数/返回 ==");
func first(x) { return x[0]; }
print(first(<int>["9", "8"]));   // 9
func sumb(a) { return (int)a[0] + (int)a[1]; }
print(sumb(<byte>[10, 32]));     // 42
