// ===== 多线程测试：thread(f, args...) 启动 / thread_join(tid) 等待并取返回值 =====
// 所有 print 均在 join 之后（主线程），输出确定性，双通道可逐行 diff
counter = 0;
func worker(n) {
    return n * 100;   // 函数内赋值=局部（遮蔽全局），共享写改在 main 聚合
}

// 1. 基础：多线程 + 返回值
t1 = thread(worker, 1);
t2 = thread(worker, 2);
t3 = thread(worker, 3);
r1 = thread_join(t1);
r2 = thread_join(t2);
r3 = thread_join(t3);
counter = counter + r1 + r2 + r3;
print("t1: r=" + r1 + " r2=" + r2 + " r3=" + r3 + " counter=" + counter);
// r=100 r2=200 r3=300 counter=600

// 2. 无参线程
func hi() { return 42; }
t4 = thread(hi);
print("t2: r4=" + thread_join(t4));
// r4=42

// 3. 字符串参数 + 返回
func echo(s) { return s; }
t5 = thread(echo, "hello-thread");
print("t3: r5=" + thread_join(t5));
// hello-thread

// 4. 数组参数
func arrlen(a) { return len(a); }
t6 = thread(arrlen, [10, 20, 30]);
print("t4: r6=" + thread_join(t6));
// 3

// 5. 线程内 try/catch（错误不逃逸）
func safe(x) {
    try {
        if (x == 0) { throw "div-zero"; }
        return 100 / x;
    } catch (e) {
        return -1;
    }
}
t7 = thread(safe, 0);
t8 = thread(safe, 2);
print("t5: r7=" + thread_join(t7) + " r8=" + thread_join(t8));
// r7=-1 r8=50

// 6. 嵌套线程：线程内再开线程
func inner(x) { return x + 1; }
func outer(x) {
    t = thread(inner, x);
    return thread_join(t) * 2;
}
t9 = thread(outer, 10);
print("t6: r9=" + thread_join(t9));
// 22

// 7. 循环批量线程（8 个线程并发求和，main 聚合）
func bump(i) {
    return i * i;
}
sum7 = 0;
for (k = 0; k < 8; k = k + 1) {
    t = thread(bump, k);
    sum7 = sum7 + thread_join(t);
}
print("t7: sum7=" + sum7);
// sum7=140 (0+1+4+9+16+25+36+49)

// 8. 字符串拼接在返回中（跨线程字符串）
func greet(name) { return "hi " + name; }
t10 = thread(greet, "lumyr");
print("t8: " + thread_join(t10));
// hi lumyr
