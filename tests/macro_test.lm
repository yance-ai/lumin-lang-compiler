// 宏展开测试 - 简化版

print("=== Test 1: simple macro ===");
macro greet() {
    print("Hello from macro!");
}
greet();

print("=== Test 2: macro with args ===");
macro square(x) {
    print(x * x);
}
square(5);
square(10);

print("=== Test 3: macro with two args ===");
macro add_and_print(a, b) {
    print(a + b);
}
add_and_print(3, 4);

print("=== All macro tests passed ===");
