// ============================================================
// 条件变量（condvar/cond_wait/cond_signal/cond_broadcast）
// + 读写锁非阻塞尝试（tryrdlock/trywrlock）综合测试
// 全部确定性输出，VM 与 C 编译双通道逐行 diff
// 若条件变量唤醒链有死锁，对应场景会挂起以暴露回归
// ============================================================

// 1. 单生产者-单消费者：mutex + condvar，10 个任务精确流转
produced = [0]; consumed = [0]; buf = [0];
m1 = mutex(); c1 = condvar();
func producer(n) {
    for (i = 0; i < n; i = i + 1) {
        lock(m1);
        buf[0] = buf[0] + 1;
        produced[0] = produced[0] + 1;
        cond_signal(c1);
        unlock(m1);
    }
}
func consumer(n) {
    while (consumed[0] < n) {
        lock(m1);
        while (buf[0] == 0) { cond_wait(c1, m1); }
        buf[0] = buf[0] - 1;
        consumed[0] = consumed[0] + 1;
        unlock(m1);
    }
}
t1p = thread(producer, 10);
t1c = thread(consumer, 10);
thread_join(t1p); thread_join(t1c);
print("producer-consumer: " + produced[0] + " " + consumed[0] + " " + buf[0]);   // 10 10 0

// 2. 多消费者接力：1 生产者产 12 + 3 消费者竞争消费（消费后 signal 接力，防死锁）
total2 = 12;
g2 = [0]; consumed2 = [0];
m2 = mutex(); c2 = condvar();
func producer2(n) {
    for (i = 0; i < n; i = i + 1) {
        lock(m2);
        g2[0] = g2[0] + 1;
        cond_signal(c2);
        unlock(m2);
    }
    lock(m2);
    cond_broadcast(c2);      // 产完兜底唤醒
    unlock(m2);
}
func consumer2() {
    while (true) {
        lock(m2);
        while (g2[0] == 0) {
            if (consumed2[0] >= total2) { unlock(m2); return; }
            cond_wait(c2, m2);
        }
        g2[0] = g2[0] - 1;
        consumed2[0] = consumed2[0] + 1;
        cond_signal(c2);     // 接力：唤醒其他等待者
        unlock(m2);
        if (consumed2[0] >= total2) { return; }
    }
}
t2p = thread(producer2, 12);
t2a = thread(consumer2); t2b = thread(consumer2); t2c = thread(consumer2);
thread_join(t2p); thread_join(t2a); thread_join(t2b); thread_join(t2c);
print("multi-consumer: " + consumed2[0] + " " + g2[0]);                           // 12 0

// 3. cond_signal 唤醒链：3 个 waiter，主线程 signal 一次，醒来后接力（无死锁）
w3 = [0]; r3 = [0]; go3 = [0];
m3 = mutex(); c3 = condvar();
func waiter3() {
    lock(m3);
    r3[0] = r3[0] + 1;
    while (go3[0] == 0) { cond_wait(c3, m3); }
    w3[0] = w3[0] + 1;
    cond_signal(c3);         // 接力唤醒下一个等待者
    unlock(m3);
}
t3a = thread(waiter3); t3b = thread(waiter3); t3c = thread(waiter3);
while (true) { lock(m3); n3 = r3[0]; unlock(m3); if (n3 >= 3) { break; } }
go3[0] = 1;
cond_signal(c3);
thread_join(t3a); thread_join(t3b); thread_join(t3c);
print("signal-chain: " + w3[0]);                                                   // 3

// 4. cond_broadcast 一次唤醒全部：3 个 waiter 同时就绪
w4 = [0]; r4 = [0]; go4 = [0];
m4 = mutex(); c4 = condvar();
func waiter4() {
    lock(m4);
    r4[0] = r4[0] + 1;
    while (go4[0] == 0) { cond_wait(c4, m4); }
    w4[0] = w4[0] + 1;
    unlock(m4);
}
t4a = thread(waiter4); t4b = thread(waiter4); t4c = thread(waiter4);
while (true) { lock(m4); n4 = r4[0]; unlock(m4); if (n4 >= 3) { break; } }
go4[0] = 1;
cond_broadcast(c4);
thread_join(t4a); thread_join(t4b); thread_join(t4c);
print("broadcast-all: " + w4[0]);                                                  // 3

// 5. tryrdlock：无锁成功 / 多读共存 / 写锁持有时失败
rw5 = rwlock();
a5 = tryrdlock(rw5);      // 无锁 → true
b5 = tryrdlock(rw5);      // 已持读锁 → true（读可共享）
unlock(rw5); unlock(rw5); // 释放 2 次读
wrlock(rw5);
f5 = tryrdlock(rw5);      // 写锁独占 → false
unlock(rw5);
h5 = tryrdlock(rw5);      // 释放后 → true
unlock(rw5);
print("tryrdlock: " + a5 + " " + b5 + " " + f5 + " " + h5);                        // true true false true

// 6. trywrlock：无锁成功 / 写锁互斥 / 读锁持有时失败
rw6 = rwlock();
x6 = trywrlock(rw6);      // 无锁 → true
y6 = trywrlock(rw6);      // 写锁持有 → false
unlock(rw6);
rdlock(rw6);
z6 = trywrlock(rw6);      // 读锁持有 → false
unlock(rw6);
w6b = trywrlock(rw6);     // 释放后 → true
unlock(rw6);
print("trywrlock: " + x6 + " " + y6 + " " + z6 + " " + w6b);                       // true false false true

// 7. 递归互斥锁配条件变量（注意：cond_wait 只释放/重获一层，多层持有会阻塞其他线程取锁
//    而死锁——pthread 递归锁配条件变量的经典陷阱；本场景按"单层持有"正确用法验证）
r7 = [0]; w7 = [0]; go7 = [0];
rm7 = rmutex(); c7 = condvar();
func waiter7() {
    lock(rm7);            // 仅 1 层
    r7[0] = r7[0] + 1;
    while (go7[0] == 0) { cond_wait(c7, rm7); }   // 释放 → 0 层；唤醒重获 → 1 层
    w7[0] = w7[0] + 1;
    unlock(rm7);          // 1 层 → 0
}
t7 = thread(waiter7);
while (true) { lock(rm7); n7 = r7[0]; unlock(rm7); if (n7 >= 1) { break; } }
go7[0] = 1;
cond_signal(c7);
thread_join(t7);
print("rmutex-cond: " + w7[0]);                                                    // 1

// 8. 多条件变量独立：各自 signal 只唤醒各自的等待者
w8a = [0]; w8b = [0]; r8a = [0]; r8b = [0]; go8 = [0];
m8 = mutex(); c8a = condvar(); c8b = condvar();
func waiter8a() {
    lock(m8);
    r8a[0] = r8a[0] + 1;
    while (go8[0] == 0) { cond_wait(c8a, m8); }
    w8a[0] = w8a[0] + 1;
    unlock(m8);
}
func waiter8b() {
    lock(m8);
    r8b[0] = r8b[0] + 1;
    while (go8[0] == 0) { cond_wait(c8b, m8); }
    w8b[0] = w8b[0] + 1;
    unlock(m8);
}
t8a = thread(waiter8a); t8b = thread(waiter8b);
while (true) { lock(m8); n8 = r8a[0] + r8b[0]; unlock(m8); if (n8 >= 2) { break; } }
go8[0] = 1;
cond_signal(c8a);         // 只唤醒 c8a 的等待者
thread_join(t8a);         // a 已醒（若 c8a 唤醒到 b 会怎样：b 醒来 w8b++ 后 join 完成，w8a 挂起 → 测试挂死暴露）
cond_signal(c8b);
thread_join(t8b);
print("cond-independent: " + w8a[0] + " " + w8b[0]);                               // 1 1

// 9. 类型错误：条件变量配错锁 / try 系列配错锁 / 无效 id（全部可 try/catch）
sp9 = spinlock(); rw9 = rwlock(); mt9 = mutex(); c9 = condvar();
try { cond_wait(c9, sp9); } catch (e) { print("cond-spin: caught"); }
try { cond_wait(c9, rw9); } catch (e) { print("cond-rw: caught"); }
try { tryrdlock(mt9); } catch (e) { print("tryrd-mutex: caught"); }
try { trywrlock(mt9); } catch (e) { print("trywr-mutex: caught"); }
try { cond_signal(99999); } catch (e) { print("cond-invalid: caught"); }
try { cond_wait(99999, mt9); } catch (e) { print("condwait-invalid: caught"); }

// 10. 条件表扩容：创建 200 个条件变量（初始 64 → 翻倍，无硬上限）
c10 = [0,0,0,0,0,0,0,0];
for (k = 0; k < 200; k = k + 1) { c10[0] = c10[0] + 1; condvar(); }
print("cond-table-200: " + c10[0]);                                               // 200

// 11. cond_wait 恢复后 finally 释放锁（异常/正常路径的锁状态一致性）
w11 = [0]; r11 = [0]; go11 = [0];
m11 = mutex(); c11 = condvar();
func waiter11() {
    lock(m11);
    try {
        r11[0] = r11[0] + 1;
        while (go11[0] == 0) { cond_wait(c11, m11); }
        w11[0] = w11[0] + 1;
    } finally {
        unlock(m11);       // wait 恢复后仍持锁，finally 释放
    }
}
t11 = thread(waiter11);
while (true) { lock(m11); n11 = r11[0]; unlock(m11); if (n11 >= 1) { break; } }
go11[0] = 1;
cond_signal(c11);
thread_join(t11);
print("cond-finally: " + w11[0]);                                                 // 1

print("cond-test-done");
