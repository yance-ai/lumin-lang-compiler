// ============================================================
// gc_promotion_test.lm —— 分代 GC 晋升测试
// 验证：长生命周期对象经多次 Minor GC 后 age 增长并晋升老年代
// ============================================================

print("== 1. 长生命周期对象晋升老年代 ==");
// 创建一个小对象（走 TLA 快速路径），保持引用，多次 GC 后应晋升
survivor = [1, 2, 3];
for (i = 0; i < 10; i = i + 1) {
    // 每次 GC 前分配一些临时对象产生新生代垃圾
    tmp = [i, i + 1, i + 2];
    gc_collect();
}
print(survivor[0]);  // 1
print(survivor[2]);  // 3
print("s1 ok");

print("== 2. 晋升后对象数据不被错误回收 ==");
// survivor 已晋升老年代，继续 GC 应保持数据完整
for (i = 0; i < 5; i = i + 1) {
    garbage = range(100);
    gc_collect();
}
print(len(survivor));  // 3
print(survivor[1]);    // 2
print("s2 ok");

print("== 3. 老年代引用新生代（remembered set） ==");
// survivor 是老年代对象，向其中添加新生代元素
survivor = survivor.add(99);
new_elem = survivor[3];
gc_collect();
print(survivor[3]);  // 99
print("s3 ok");

print("== 4. 字符串对象晋升 ==");
long_str = "this_is_a_long_lived_string_for_promotion_test";
for (i = 0; i < 10; i = i + 1) {
    tmp_str = "temp_" + i;
    gc_collect();
}
print(long_str);  // 完整字符串
print(len(long_str));
print("s4 ok");

print("== 5. Map 对象晋升 ==");
long_map = {"key1": "value1", "key2": 42, "key3": [1, 2, 3]};
for (i = 0; i < 10; i = i + 1) {
    tmp_map = {"t": i};
    gc_collect();
}
print(long_map["key2"]);     // 42
print(long_map["key3"][1]);  // 2
print("s5 ok");

print("== ALL PROMOTION TESTS DONE ==");
