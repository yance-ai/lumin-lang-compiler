// fixed_width_int_test.lm —— 固定宽度整数类型 int8/int16/int32/int64/uint8/uint16/uint32/uint64/uint
print("== 1. int8 有符号截断 ==");
print((int8)200);    // -56
print((int8)127);    // 127
print((int8)128);    // -128
print((int8)(-1));   // -1
print((int8)0);      // 0
print("== 2. uint8 无符号截断 ==");
print((uint8)200);   // 200
print((uint8)256);   // 0
print((uint8)(-1));  // 255
print((uint8)255);   // 255
print("== 3. int16 ==");
print((int16)32767);  // 32767
print((int16)32768);  // -32768
print((int16)(-32769)); // 32767
print("== 4. uint16 ==");
print((uint16)65535);  // 65535
print((uint16)65536);  // 0
print("== 5. int32 ==");
print((int32)2147483647);   // 2147483647
print((int32)2147483648);   // -2147483648
print("== 6. uint32 ==");
print((uint32)4294967295);  // 4294967295
print((uint32)4294967296);  // 0
print("== 7. int64 / uint64 / uint ==");
print((int64)9223372036854775807);  // max int64
big = 18446744073709551615;  // 超过 int64 范围，字面量解析可能截断
print((uint64)big);  // 取决于字面量解析
print((uint)100);  // 100
print("== 8. 字符串强转 ==");
print((int8)"200");   // -56
print((uint8)"255");  // 255
print((int32)"2147483648");  // -2147483648
print("== 9. 泛型数组 ==");
a = <int8>[200, 127, 128];
print(a[0]);  // -56
print(a[2]);  // -128
b = <uint8>[200, 256, -1];
print(b[1]);  // 0
print(b[2]);  // 255
print("== 10. 泛型 map ==");
m = <string,int32>{"a": 2147483648, "b": 100};
print(m["a"]);  // -2147483648
print(m["b"]);  // 100
print("== 11. type 声明属性 ==");
type Pixel { r: uint8, g: uint8, b: uint8 }
p = Pixel(200, 128, 64);
print(p.r);  // 200
print(p.g);  // 128
print(p.__classname__);  // Pixel
print("== 12. long / long long ==");
print((long)3.14);       // 3
print((long long)3.14);  // 3
print((long)"42");       // 42
print("== 13. <T>value 单值声明语法 ==");
a = <int>8;
b = <long>8;
c = <int16>127;
d = <long long>100;
e = <uint8>200;
f = <int8>200;
g = <int32>(100 + 200);
print(a);  // 8
print(b);  // 8
print(c);  // 127
print(d);  // 100
print(e);  // 200
print(f);  // -56（截断）
print(g);  // 300
print("== done ==");
