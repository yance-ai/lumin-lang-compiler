

func counter(x) { x = x + 1; return x; }

i = 0;
for (; i < 3; i = counter(i)) {
    print(i);
}


func choose(v) {
    if (v > 0) { return v * 10; }
    return 0;
}
r = choose(2) > 0 ? "pos" : "neg";
print(r);


func early(x) {
    j = 0;
    for (j = 0; j < 10; j = j + 1) {
        if (j == x) { return j * 100; }
    }
    return -1;
}
print(early(3));
print(early(20));


func add2(a) { return a + 2; }
print(add2(add2(add2(1))));


func combo(n) {
    k = 0;
    while (k < 100) {
        k = k + 1;
        if (k == 2) { continue; }
        if (k > n) { break; }
    }
    return k;
}
print(combo(5));


return;
print("never");
