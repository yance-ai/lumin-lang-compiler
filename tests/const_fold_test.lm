// 常量折叠优化 pass 测试
// 覆盖：基本算术、比较、逻辑、一元、嵌套、除零不折叠、变量不折叠、混合

// 基本算术：1 + 2*3 = 7
print(1 + 2 * 3);

// 比较
print(10 > 5);
print(3 <= 4);
print(5 == 5);
print(7 != 8);

// 逻辑（纯常量短路折叠）
print(true && false);
print(true || false);

// 一元
print(-5);
print(+10);
print(!false);

// 嵌套：(1+2)*(3+4) = 21
print((1 + 2) * (3 + 4));

// 字符串拼接折叠
print("foo" + "bar");

// 浮点
print(1.5 + 2.5);

// 除零不折叠：运行期应输出 inf（不崩溃），不被折叠成常量
print(1 / 0);

// 变量不折叠：x+3 运行期计算 = 8
x = 5;
print(x + 3);

// 混合：10 + x*2 = 20（部分折叠，x 为变量不折）
print(10 + x * 2);

// 函数内常量折叠（验证函数表 pass）
func add(a, b) {
    return (a + 1) + (b + 2);
}
print(add(1, 2));
