// ============================================================
// gc_return_race.lm — 返回值保护窗口压力测试
// 专测：线程函数返回堆对象后、unregister→protect 之间的窗口
// 大量短生命周期线程并发退出，主线程疯狂分配触发 GC，
// 验证返回的堆对象不被错误回收（UAF）。
// ============================================================

func make_payload(id, iter) {
    // 创建一个非 SSO 的大字符串，强制堆分配
    s = "payload_" + id + "_" + iter +
        "_padding_padding_padding_padding_padding_padding_padding_padding";
    // 再包一层数组，增加堆对象图复杂度
    holder = [s, id, iter, s, s, s, s, s];
    return holder;
}

func worker(id, iter) {
    h = make_payload(id, iter);
    // 持有引用一段时间，确保对象在新生代存活足够久
    gc_collect();
    // 返回 holder —— 返回值在 C 栈上，线程退出时 unregister 与 protect 之间有窗口
    return h;
}

// 主循环：批量启动线程 + 分配垃圾触发 GC
GARBAGE = 5000;
total_ok = 1;
round = 0;

while (round < 20) {
    N = 20;
    tids = [];
    for (t = 0; t < N; t = t + 1) {
        tids.add(thread(worker, round * 1000 + t, t));
    }

    // 主线程疯狂分配垃圾，触发频繁 GC
    junk = [];
    for (j = 0; j < GARBAGE; j = j + 1) {
        junk.add("junk_string_" + j + "_padding_padding_padding_padding");
    }
    gc_collect();
    junk = [];
    gc_collect();

    // Join 并验证返回值
    for (t = 0; t < N; t = t + 1) {
        r = thread_join(tids[t]);
        expected_id = round * 1000 + t;
        // 验证返回数组内容未被破坏
        if (len(r) != 8) {
            print("CORRUPTION round=" + round + " t=" + t + " len=" + len(r));
            total_ok = 0;
        } else {
            first = r[0];
            expected_prefix = "payload_" + expected_id + "_" + t + "_padding";
            // 简单校验：第一个元素应是字符串且非空
            if (len(first) < 10) {
                print("CORRUPTION round=" + round + " t=" + t + " first_len=" + len(first));
                total_ok = 0;
            }
        }
    }
    print("round " + round + " done");
    round = round + 1;
}

if (total_ok) {
    print("gc_return_race: PASS");
} else {
    print("gc_return_race: FAIL");
}
