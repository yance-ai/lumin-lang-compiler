// requests HTTP 请求测试（本地回环 127.0.0.1:8123；服务器不在时输出 srv-down，全量回归稳定）
// 服务器：python3 /tmp/http_srv.py（GET/POST/PUT/DELETE/HEAD/PATCH echo）
srv = "up";
try {
    p = requests.get("http://127.0.0.1:8123/ping");
    if (p["status"] != 200) { srv = "down"; }
} catch(e) {
    srv = "down";
}
print("srv:" + srv);

if (srv == "up") {
    print("== GET ==");
    r = requests.get("http://127.0.0.1:8123/echo");
    print(r["status"]);                // 200
    print(r["body"]);                  // json
    print(r["headers"]["X-Test"]);     // lumin-http
    print(type(r["headers"]));         // map

    print("== 查询参数 ==");
    r2 = requests.get("http://127.0.0.1:8123/echo", {"q": "hello world", "n": 42});
    print(r2["body"]);                 // URL 编码后的 query
    r2b = requests.get("http://127.0.0.1:8123/echo", "a=1&b=2");
    print(r2b["body"]);                // 字符串查询串原样

    print("== POST / body / headers ==");
    r3 = requests.post("http://127.0.0.1:8123/echo", {"a": 1}, {"headers": {"Content-Type": "text/plain"}, "body": "hello-from-lm"});
    print(r3["body"]);

    print("== PUT / DELETE / PATCH / HEAD ==");
    print(requests.put("http://127.0.0.1:8123/echo", "", {"body": "put-body"})["body"]);
    print(requests.delete("http://127.0.0.1:8123/echo")["body"]);
    print(requests.patch("http://127.0.0.1:8123/echo")["body"]);
    print(requests.head("http://127.0.0.1:8123/echo")["status"]);

    print("== 类型/参数错误 catch ==");
    try { x = requests.get(123); print("no-error"); } catch(e) { print("caught-url"); }
    try { x = requests.get("http://127.0.0.1:8123/echo", {"q": 1}, {"headers": "not-map"}); print("no-error"); } catch(e) { print("caught-headers"); }
    try { x = requests.post("http://127.0.0.1:8123/echo", {"a": 1}, {"body": 42}); print("no-error"); } catch(e) { print("caught-body"); }

    print("== 连接错误 catch ==");
    try { x = requests.get("http://127.0.0.1:9999/none"); print("no-error"); } catch(e) { print("caught-conn"); }

    print("== 响应复用（map 存响应）==");
    rs = [requests.get("http://127.0.0.1:8123/echo"), requests.post("http://127.0.0.1:8123/echo")];
    print(rs[0]["status"]);
    print(rs[1]["status"]);

    print("== 响应值类型 ==");
    // 1) 字符串响应：body 直接是 string
    rs2 = requests.get("http://127.0.0.1:8123/t/string");
    print(type(rs2["body"]));     // string
    print(rs2["body"]);           // hello-from-server
    print(len(rs2["body"]));      // 17

    // 2) 数组响应：逗号分隔 → split → 数组，元素强转数字
    ra = requests.get("http://127.0.0.1:8123/t/array");
    arr = split(ra["body"], ",");
    print(type(arr));             // array
    print(len(arr));              // 4
    print((int)arr[0] + (int)arr[3]);  // 1 + 4 = 5
    print(arr[1]);                // 2（字符串元素）
    print(type(arr[1]));          // string

    // 3) map 响应：k=v&k=v → 逐对拆解拼 map
    rm = requests.get("http://127.0.0.1:8123/t/map");
    pairs = split(rm["body"], "&");
    m2 = {};
    for (i = 0; i < len(pairs); i = i + 1) {
        kv = split(pairs[i], "=");
        m2[kv[0]] = kv[1];
    }
    print(type(m2));              // map
    print(m2["a"]);               // 1
    print(m2["b"]);               // hello
    print(len(m2));               // 2（键 a b）

    // 4) byte 数组响应：二进制 body → 逐字节转 byte 数组
    rb = requests.get("http://127.0.0.1:8123/t/bytes");
    bs = [0, 0, 0, 0, 0];         // 预分配（空数组不能按下标追加）
    n = len(rb["body"]);
    print(n);                     // 5
    for (i = 0; i < n; i = i + 1) {
        bs[i] = (byte)rb["body"][i];
    }
    print(type(bs));              // array
    print(type(bs[0]));           // byte
    print((int)bs[0] + (int)bs[4]);   // 1 + 5 = 6
    print((int)bs[2]);            // 3
    print(bs[1] == (byte)2);      // true（byte 同类型数值比较）

    // 5) map 响应里带数字 → 强转 int 后算术
    print((int)m2["a"] + 100);    // 101
} else {
    print("(server down: 跳过请求场景)");
}
