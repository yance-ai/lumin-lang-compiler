// for-each 循环测试

print("=== Test 1: for x in array ===");
arr = [10, 20, 30, 40, 50];
sum = 0;
for x in arr {
    sum = sum + x;
    print(x);
}
print("sum = " + sum);

print("=== Test 2: for x in array with break ===");
for x in arr {
    if (x > 30) { break; }
    print(x);
}

print("=== Test 3: for x in array with continue ===");
for x in arr {
    if (x % 20 == 0) { continue; }
    print(x);
}

print("=== Test 4: for k,v in map ===");
m = {"a": 1, "b": 2, "c": 3};
for k, v in m {
    print(k + " = " + v);
}

print("=== All for-each tests passed ===");
