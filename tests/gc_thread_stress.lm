// ============================================================
// gc_thread_stress.lm — 多线程 GC 压力测试
// 验证 GC 能正确扫描所有线程栈上的根，防止 use-after-free
// ============================================================

func worker(id) {
    // 保留对象：长字符串（非SSO，强制堆分配），整个生命周期持有
    keepers = [];
    for (k = 0; k < 100; k = k + 1) {
        keepers.add("keeper_string_thread_" + id + "_idx_" + k + "_padding_padding_padding");
    }

    checksum = 0;
    for (i = 0; i < 50000; i = i + 1) {
        // 创建大量临时堆对象：长字符串 + 大数组 + map
        tmp = "temporary_string_" + id + "_" + i + "_data_data_data_data_data";
        arr = [id, i, id + i, id * i, id - i, i + 1, i + 2, i + 3];
        m = {};
        m["key1"] = tmp;
        m["key2"] = i;
        m["key3"] = arr;

        // 每 500 次迭代强制 GC + 验证保留对象
        if (i % 500 == 0) {
            gc_collect();
            for (k = 0; k < 100; k = k + 1) {
                expected = "keeper_string_thread_" + id + "_idx_" + k + "_padding_padding_padding";
                if (keepers[k] != expected) {
                    print("CORRUPTION thread=" + id + " idx=" + k +
                          " expected=[" + expected + "] got=[" + keepers[k] + "]");
                    return -1;
                }
            }
            checksum = checksum + id;
        }
    }

    // 最终验证
    gc_collect();
    for (k = 0; k < 100; k = k + 1) {
        expected = "keeper_string_thread_" + id + "_idx_" + k + "_padding_padding_padding";
        if (keepers[k] != expected) {
            print("FINAL CORRUPTION thread=" + id + " idx=" + k);
            return -1;
        }
    }
    return checksum;
}

N = 10;
tids = [];
for (t = 0; t < N; t = t + 1) {
    tids.add(thread(worker, t));
}

all_ok = 1;
for (t = 0; t < N; t = t + 1) {
    r = thread_join(tids[t]);
    if (r < 0) { all_ok = 0; }
    print("thread " + t + " done checksum=" + r);
}

if (all_ok) {
    print("gc_thread_stress: PASS");
} else {
    print("gc_thread_stress: FAIL");
}
