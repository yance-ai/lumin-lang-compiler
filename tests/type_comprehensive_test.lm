// ============================================
// 类型系统全面测试 - 覆盖自定义type、混合嵌套、默认类型、多维数组等场景
// ============================================
print("=== Type Comprehensive Test ===");

// ========== 1. 默认未声明类型 vs 有类型标注 对比 ==========
print("\n--- 1. Default vs Typed ---");
// 默认未声明类型（整数默认 long long，浮点默认 double）
d1 = 100;
d2 = 3.14;
print("default int:", d1);
print("default double:", d2);
// 有类型标注
t1 = <int>100;
t2 = <double>3.14;
t3 = <int8>100;
t4 = <float>3.14;
print("typed int:", t1);
print("typed double:", t2);
print("typed int8:", t3);
print("typed float:", t4);

// ========== 2. 自定义 type 基础 ==========
print("\n--- 2. Custom Type Basic ---");
type Point { x: int, y: int }
type Color { r: uint8, g: uint8, b: uint8 }
p1 = Point(10, 20);
c1 = Color(255, 128, 0);
print("Point x:", p1.x, "y:", p1.y);
print("Color r:", c1.r, "g:", c1.g, "b:", c1.b);
print("Point class:", p1.__classname__);

// ========== 3. 自定义 type 嵌套 ==========
print("\n--- 3. Nested Custom Type ---");
type Pixel { pos: Point, color: Color }
pix1 = Pixel(Point(5, 5), Color(255, 0, 0));
print("Pixel pos x:", pix1.pos.x);
print("Pixel pos y:", pix1.pos.y);
print("Pixel color r:", pix1.color.r);
print("Pixel class:", pix1.__classname__);

// ========== 4. 自定义 type 作为数组元素 ==========
print("\n--- 4. Custom Type in Array ---");
arr_points = [Point(1, 2), Point(3, 4), Point(5, 6)];
print("arr_points len:", len(arr_points));
print("arr_points[0] x:", arr_points[0].x);
print("arr_points[2] y:", arr_points[2].y);
// 自定义 type 数组遍历
sum_x = 0;
for(i = 0; i < len(arr_points); i = i + 1) {
    sum_x = sum_x + arr_points[i].x;
}
print("sum x:", sum_x);

// ========== 5. 自定义 type 作为 map 值 ==========
print("\n--- 5. Custom Type in Map ---");
map_colors = {"red": Color(255, 0, 0), "green": Color(0, 255, 0), "blue": Color(0, 0, 255)};
print("map_colors len:", len(map_colors));
print("red r:", map_colors["red"].r);
print("green g:", map_colors["green"].g);
print("blue b:", map_colors["blue"].b);

// ========== 6. 数组的数组（二维数组） ==========
print("\n--- 6. 2D Array ---");
matrix = [[1, 2, 3], [4, 5, 6], [7, 8, 9]];
print("matrix len:", len(matrix));
print("matrix[0] len:", len(matrix[0]));
print("matrix[0][0]:", matrix[0][0]);
print("matrix[1][1]:", matrix[1][1]);
print("matrix[2][2]:", matrix[2][2]);
// 二维数组遍历求和
total = 0;
for(i = 0; i < len(matrix); i = i + 1) {
    for(j = 0; j < len(matrix[i]); j = j + 1) {
        total = total + matrix[i][j];
    }
}
print("2D sum:", total);

// ========== 7. 三维数组（多层嵌套） ==========
print("\n--- 7. 3D Array ---");
cube = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]];
print("cube len:", len(cube));
print("cube[0] len:", len(cube[0]));
print("cube[0][0] len:", len(cube[0][0]));
print("cube[0][0][0]:", cube[0][0][0]);
print("cube[1][1][1]:", cube[1][1][1]);
sum3d = 0;
for(i = 0; i < len(cube); i = i + 1) {
    for(j = 0; j < len(cube[i]); j = j + 1) {
        for(k = 0; k < len(cube[i][j]); k = k + 1) {
            sum3d = sum3d + cube[i][j][k];
        }
    }
}
print("3D sum:", sum3d);

// ========== 8. 数组中嵌套 map ==========
print("\n--- 8. Array of Maps ---");
users = [{"name": "alice", "age": 30}, {"name": "bob", "age": 25}];
print("users len:", len(users));
print("users[0] name:", users[0]["name"]);
print("users[1] age:", users[1]["age"]);
// 遍历
ages_sum = 0;
for(i = 0; i < len(users); i = i + 1) {
    ages_sum = ages_sum + users[i]["age"];
}
print("ages sum:", ages_sum);

// ========== 9. map 中嵌套数组 ==========
print("\n--- 9. Map of Arrays ---");
data = {"scores": [90, 85, 95], "names": ["a", "b", "c"]};
print("data scores len:", len(data["scores"]));
print("data scores[0]:", data["scores"][0]);
print("data names[2]:", data["names"][2]);
// map 中数组的遍历
score_sum = 0;
for(i = 0; i < len(data["scores"]); i = i + 1) {
    score_sum = score_sum + data["scores"][i];
}
print("scores sum:", score_sum);

// ========== 10. map 的 map（嵌套 map） ==========
print("\n--- 10. Nested Maps ---");
nested_map = {"user1": {"name": "alice", "score": 95}, "user2": {"name": "bob", "score": 88}};
print("nested_map len:", len(nested_map));
print("user1 name:", nested_map["user1"]["name"]);
print("user2 score:", nested_map["user2"]["score"]);

// ========== 11. 复杂混合：map 的数组的 map ==========
print("\n--- 11. Complex Mixed: Map->Array->Map ---");
complex_data = {"rows": [{"id": 1, "val": 100}, {"id": 2, "val": 200}]};
print("complex rows len:", len(complex_data["rows"]));
print("row0 id:", complex_data["rows"][0]["id"]);
print("row1 val:", complex_data["rows"][1]["val"]);
complex_sum = 0;
for(i = 0; i < len(complex_data["rows"]); i = i + 1) {
    complex_sum = complex_sum + complex_data["rows"][i]["val"];
}
print("complex sum:", complex_sum);

// ========== 12. 空数组和空 map ==========
print("\n--- 12. Empty Array and Map ---");
empty_arr = [];
empty_map = {};
print("empty_arr len:", len(empty_arr));
print("empty_map len:", len(empty_map));
// 空数组添加元素
empty_arr = empty_arr.add(1);
empty_arr = empty_arr.add(2);
print("after add len:", len(empty_arr));
print("after add[0]:", empty_arr[0]);
// 空 map 添加元素
empty_map["key"] = "value";
print("after set len:", len(empty_map));
print("after set key:", empty_map["key"]);

// ========== 13. 有类型标注的变量重新赋值 ==========
print("\n--- 13. Typed Variable Reassignment ---");
tv = <int>42;
print("typed int initial:", tv);
tv = 100;
print("after int reassignment:", tv);
tv = <double>3.14;
print("after double reassignment:", tv);
tv = "hello";
print("after string reassignment:", tv);

// ========== 14. 函数参数和返回值使用自定义 type ==========
print("\n--- 14. Function with Custom Type ---");
func make_point(x, y) {
    return Point(x, y);
}
func point_distance(p1, p2) {
    dx = p1.x - p2.x;
    dy = p1.y - p2.y;
    return dx * dx + dy * dy;
}
mp = make_point(10, 20);
print("make_point x:", mp.x, "y:", mp.y);
dist = point_distance(Point(0, 0), Point(3, 4));
print("distance squared:", dist);

// ========== 15. 函数参数和返回值使用基本类型标注 ==========
print("\n--- 15. Function with Basic Type Annotations ---");
func <int> add_ints(<int>a, <int>b) {
    return a + b;
}
func <double> add_doubles(<double>a, <double>b) {
    return a + b;
}
func <int8> clamp_byte(<int>v) {
    if(v > 127) return 127;
    if(v < -128) return -128;
    return <int8>v;
}
print("add_ints:", add_ints(100, 200));
print("add_doubles:", add_doubles(1.5, 2.5));
print("clamp_byte(200):", clamp_byte(200));
print("clamp_byte(-200):", clamp_byte(-200));

// ========== 16. 自定义 type 数组与 map 混合遍历 ==========
print("\n--- 16. Custom Type Mixed Traversal ---");
type Rectangle { x: int, y: int, w: int, h: int }
rects = [Rectangle(0, 0, 10, 20), Rectangle(5, 5, 15, 25)];
rect_map = {"r1": Rectangle(1, 1, 5, 5), "r2": Rectangle(2, 2, 8, 8)};
total_area = 0;
for(i = 0; i < len(rects); i = i + 1) {
    total_area = total_area + rects[i].w * rects[i].h;
}
print("rects total area:", total_area);
print("r1 area:", rect_map["r1"].w * rect_map["r1"].h);
print("r2 area:", rect_map["r2"].w * rect_map["r2"].h);

// ========== 17. 深层嵌套：数组的 map 的数组 ==========
print("\n--- 17. Deep Nesting: Array->Map->Array ---");
deep_data = [
    {"values": [1, 2, 3], "label": "first"},
    {"values": [4, 5, 6], "label": "second"}
];
print("deep_data len:", len(deep_data));
print("deep_data[0] label:", deep_data[0]["label"]);
print("deep_data[1] values[2]:", deep_data[1]["values"][2]);
deep_sum = 0;
for(i = 0; i < len(deep_data); i = i + 1) {
    vals = deep_data[i]["values"];
    for(j = 0; j < len(vals); j = j + 1) {
        deep_sum = deep_sum + vals[j];
    }
}
print("deep sum:", deep_sum);

// ========== 18. 类型标注与默认类型在运算中的对比 ==========
print("\n--- 18. Typed vs Default in Operations ---");
// 默认类型（long long）运算
def_a = 1000000;
def_b = 2000000;
print("default multiply:", def_a * def_b);
// int 类型标注运算（可能溢出）
int_a = <int>1000000;
int_b = <int>2000000;
print("int multiply:", int_a * int_b);
// double 运算
dbl_a = <double>1000000.0;
dbl_b = <double>2000000.0;
print("double multiply:", dbl_a * dbl_b);

// ========== 19. 混合类型数组（默认行为） ==========
print("\n--- 19. Mixed Type Array ---");
mixed = [1, "two", 3.0, true, Point(1, 2)];
print("mixed len:", len(mixed));
print("mixed[0]:", mixed[0]);
print("mixed[1]:", mixed[1]);
print("mixed[2]:", mixed[2]);
print("mixed[3]:", mixed[3]);
print("mixed[4] x:", mixed[4].x);

// ========== 20. 自定义 type 作为函数参数并修改 ==========
print("\n--- 20. Modify Custom Type in Function ---");
func move_point(p, dx, dy) {
    p.x = p.x + dx;
    p.y = p.y + dy;
}
mp2 = Point(5, 5);
print("before move x:", mp2.x, "y:", mp2.y);
move_point(mp2, 10, 15);
print("after move x:", mp2.x, "y:", mp2.y);

print("\n=== All Type Comprehensive Tests Passed ===");
