// SSO 压力测试：验证短字符串免堆分配，减少 GC 对象数
print("== SSO 压力测试 ==");

// 1. 短字符串字面量（应全部内联，不产生 GC 对象）
before = gc_count();
for (i = 0; i < 100000; i = i + 1) {
    s = "item_" + i;  // 短字符串拼接，结果 <=22 字节应内联
    tmp = s.len();
}
after = gc_count();
print("短字符串拼接10万次 GC 对象增长: " + (after - before));

// 2. 长字符串拼接（应走堆分配）
before2 = gc_count();
for (i = 0; i < 10000; i = i + 1) {
    s = "这是一个超过二十二字节的长字符串用于测试堆分配_" + i;
    tmp = s.len();
}
after2 = gc_count();
print("长字符串拼接1万次 走堆分配: " + (after2 > before2));

// 3. 边界测试：22字节内联，23字节堆分配
s22 = "1234567890123456789012";  // 22字符
s23 = "12345678901234567890123"; // 23字符
print("22字节字符串: " + s22 + " len=" + s22.len());
print("23字节字符串: " + s23 + " len=" + s23.len());

// 4. 中文 UTF-8 测试：7个中文=21字节内联，8个中文=24字节堆
cn7 = "一二三四五六七";  // 7*3=21字节
cn8 = "一二三四五六七八"; // 8*3=24字节
print("7中文(21字节): " + cn7 + " len=" + cn7.len());
print("8中文(24字节): " + cn8 + " len=" + cn8.len());

// 5. 空字符串和单字符
empty = "";
one = "a";
print("空字符串 len=" + empty.len());
print("单字符: " + one + " len=" + one.len());

// 6. 字符串拼接结果边界：刚好22字节
prefix = "hello_";
suffix = "world1234567890";  // hello_ + world1234567890 = 22
combined = prefix + suffix;
print("拼接22字节: " + combined + " len=" + combined.len());

print("SSO 压力测试完成");
