// 类型系统全面测试 - <ptr>转换 + ()转换 + 普通场景 + FFI场景
print("=== Type System Full Test ===");

// ========== 1. () 类型转换 - 整数类型 ==========
print("\n--- () Cast: Integer Types ---");
x = 1000;
print("(int8)1000 =", (int8)x);
print("(int16)1000 =", (int16)x);
print("(int32)1000 =", (int32)x);
print("(int64)1000 =", (int64)x);
print("(uint8)1000 =", (uint8)x);
print("(uint16)1000 =", (uint16)x);
print("(uint32)1000 =", (uint32)x);
print("(uint64)1000 =", (uint64)x);
print("(short)1000 =", (short)x);
print("(unsigned short)1000 =", (unsigned short)x);
print("(unsigned long)1000 =", (unsigned long)x);
print("(unsigned char)1000 =", (unsigned char)x);
print("(size_t)1000 =", (size_t)x);
print("(ssize_t)1000 =", (ssize_t)x);
print("(long)1000 =", (long)x);
print("(long long)1000 =", (long long)x);

// ========== 2. <ptr>类型转换 - 整数类型 ==========
print("\n--- <ptr>Cast: Integer Types ---");
print("<int8>1000 =", <int8>x);
print("<int16>1000 =", <int16>x);
print("<int32>1000 =", <int32>x);
print("<int64>1000 =", <int64>x);
print("<uint8>1000 =", <uint8>x);
print("<uint16>1000 =", <uint16>x);
print("<uint32>1000 =", <uint32>x);
print("<uint64>1000 =", <uint64>x);
print("<short>1000 =", <short>x);
print("<unsigned short>1000 =", <unsigned short>x);
print("<unsigned long>1000 =", <unsigned long>x);
print("<unsigned char>1000 =", <unsigned char>x);
print("<size_t>1000 =", <size_t>x);
print("<ssize_t>1000 =", <ssize_t>x);
print("<long>1000 =", <long>x);
print("<long long>1000 =", <long long>x);

// ========== 3. () 类型转换 - 浮点类型 ==========
print("\n--- () Cast: Float Types ---");
d = 3.14159265358979;
print("(float)pi =", (float)d);
print("(double)pi =", (double)d);
print("(long double)pi =", (long double)d);

// ========== 4. <ptr>类型转换 - 浮点类型 ==========
print("\n--- <ptr>Cast: Float Types ---");
print("<float>pi =", <float>d);
print("<double>pi =", <double>d);
print("<long double>pi =", <long double>d);

// ========== 5. () 类型转换 - 其他类型 ==========
print("\n--- () Cast: Other Types ---");
p = 12345;
print("(pointer)12345 =", (pointer)p);
print("(handle)12345 =", (handle)p);
v = (void)x;
print("(void)1000 =", v);
b = 1;
print("(bool)1 =", (bool)b);
c = 65;
print("(char)65 =", (char)c);
print("(byte)65 =", (byte)c);

// ========== 6. <ptr>类型转换 - 其他类型 ==========
print("\n--- <ptr>Cast: Other Types ---");
print("<ptr>12345 =", <ptr>p);
print("<pointer>12345 =", <pointer>p);
print("<handle>12345 =", <handle>p);
v2 = <void>x;
print("<void>1000 =", v2);
print("<bool>1 =", <bool>b);
print("<char>65 =", <char>c);
print("<byte>65 =", <byte>c);

// ========== 7. FFI 场景 - 整数类型声明 ==========
print("\n--- FFI: Integer Type Declarations ---");
extern "msvcrt.dll" <int> func atoi(<string>s);
extern "msvcrt.dll" <long> func atol(<string>s);
extern "msvcrt.dll" <long long> func _atoi64(<string>s);
extern "msvcrt.dll" <size_t> func strlen(<string>s);
print("atoi(42) =", atoi("42"));
print("atol(100000) =", atol("100000"));
print("_atoi64(9999999999) =", _atoi64("9999999999"));
print("strlen(hello) =", strlen("hello"));

// ========== 8. FFI 场景 - 无符号整数类型 ==========
print("\n--- FFI: Unsigned Integer Types ---");
extern "msvcrt.dll" <unsigned long> func strtoul(<string>s, <ptr>end, <int>base);
extern "msvcrt.dll" <uint64> func _strtoui64(<string>s, <ptr>end, <int>base);
print("strtoul(255) =", strtoul("255", null, 10));
print("_strtoui64(4294967295) =", _strtoui64("4294967295", null, 10));

// ========== 9. FFI 场景 - 浮点类型 ==========
print("\n--- FFI: Float Types ---");
extern "msvcrt.dll" <double> func atof(<string>s);
extern "msvcrt.dll" <double> func floor(<double>x);
extern "msvcrt.dll" <double> func fabs(<double>x);
print("atof(3.14) =", atof("3.14"));
print("floor(3.7) =", floor(3.7));
print("fabs(-2.5) =", fabs(-2.5));

// ========== 10. FFI 场景 - 字符类型 ==========
print("\n--- FFI: Char Type ---");
extern "msvcrt.dll" <int> func isdigit(<int>c);
extern "msvcrt.dll" <int> func isalpha(<int>c);
print("isdigit(57) != 0 =", isdigit(57) != 0);  // '9' = 57, msvcrt returns bitmask
print("isalpha(97) != 0 =", isalpha(97) != 0);  // 'a' is alpha

// ========== 11. FFI 场景 - 指针类型 ==========
print("\n--- FFI: Pointer Types ---");
extern "msvcrt.dll" <ptr> func malloc(<size_t>size);
extern "msvcrt.dll" <void> func free(<ptr>p);
extern "msvcrt.dll" <ptr> func memset(<ptr>p, <int>value, <size_t>size);
buf = malloc(16);
print("malloc(16) != null =", buf != null);
memset(buf, 0, 16);
print("memset(buf, 0, 16) done");
free(buf);
print("free(buf) done");

// ========== 12. FFI + 类型转换 组合 ==========
print("\n--- FFI + Type Cast Combination ---");
n = atoi("12345");
print("atoi(12345) as int8 =", (int8)n);
print("atoi(12345) as uint8 =", (uint8)n);
print("atoi(12345) as short =", (short)n);
print("atoi(12345) as <int8> =", <int8>n);
d2 = atof("2.71828");
print("atof(2.71828) as float =", (float)d2);
print("atof(2.71828) as <float> =", <float>d2);

print("\n=== All Type System Full Tests Passed ===");
