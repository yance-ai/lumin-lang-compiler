// map_key_types_test.lm —— map 任意类型键 + 计算属性名 + 泛型全场景
print("== 1. int 键 ==");
m1 = {1: "one", 2: "two", 100: "hundred"};
print(m1[1]);
print(m1[100]);
m1[3] = "three";
print(m1[3]);
print(m1.has(2));
print(m1.has(999));

print("== 2. char 键 ==");
m2 = {'a': 1, 'b': 2, 'z': 26};
print(m2['a']);
print(m2['z']);
m2['c'] = 3;
print(m2['c']);

print("== 3. bool 键 ==");
m3 = {true: "yes", false: "no"};
print(m3[true]);
print(m3[false]);

print("== 4. double 键 ==");
m4 = {3.14: "pi", 2.71: "e"};
print(m4[3.14]);
print(m4[2.71]);

print("== 5. 泛型 int 键 ==");
m5 = <int,string>{1: "x", 2: "y"};
print(m5[1]);
print(m5[2]);

print("== 6. 泛型 char 键 ==");
m6 = <char,int>{'x': 10, 'y': 20};
print(m6['x']);
print(m6['y']);

print("== 7. 计算属性名 [expr]: value ==");
key = "dynamic";
m7 = {[key]: 100, [1+2]: "three", ['a'+'b']: "ab"};
print(m7["dynamic"]);
print(m7[3]);
print(m7["ab"]);

print("== 8. 自定义 type 键（深比较） ==");
type Point { x: int, y: int }
p1 = {x:1, y:2};
p2 = {x:3, y:4};
m8 = {[p1]: "A", [p2]: "B"};
print(m8[p1]);
print(m8[{x:1, y:2}]);
print(m8[p2]);
print(m8[{x:9, y:9}]);

print("== 9. 混合类型键 ==");
m9 = {"str": 1, 42: "int", 'c': true, 3.14: "pi"};
print(m9["str"]);
print(m9[42]);
print(m9['c']);
print(m9[3.14]);

print("== 10. int 键删除 ==");
m10 = {1: "a", 2: "b", 3: "c"};
m10 = m10.del(2);
print(m10[1]);
print(m10[2]);
print(m10[3]);

print("== 11. 泛型自定义 type 值 ==");
type Pixel { r: uint8, g: uint8, b: uint8 }
m11 = <string,Pixel>{"red": {r:255,g:0,b:0}};
print(m11["red"].r);
print(m11["red"].__classname__);

print("== 12. keys() 返回任意类型键数组 ==");
m12 = {1: "a", 2: "b"};
ks = m12.keys();
print(ks[0]);
print(ks[1]);
print(ks.len());

print("== 13. map 嵌套任意键 ==");
m13 = {1: {"a": 1}, 2: {"b": 2}};
print(m13[1]["a"]);
print(m13[2]["b"]);

print("== 14. byte 键 ==");
m14 = {65: "A", 66: "B"};
print(m14[65]);
print(m14[66]);

print("ALL DONE");
