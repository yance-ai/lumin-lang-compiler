// thread_container_test.lm —— 多线程容器并发：数组 / map / type 构造对象
// 语义说明：全局变量赋值是线程私有的（各线程符号表快照），但容器堆对象
//   （数组元素 items / map 键值 / type 对象属性）跨线程共享——
//   并发写用 预分配数组索引写 + map.set() 原地 + 锁保护（与 C 一致，
//   无锁数据竞争是未定义行为）

print("== 多线程并发数组索引写（锁保护） ==");
N = 60;
M = 20;
arr = range(N * M);            // 预分配 1200 槽（元素共享）
ma = mutex();
func arr_worker(i) {
    for (j = 0; j < M; j = j + 1) {
        lock(ma);
        arr[i * M + j] = i * 100 + j;   // 索引写原地（跨线程共享 items）
        unlock(ma);
    }
}
ts = [];
for (i = 0; i < N; i = i + 1) { ts = ts.add(thread(arr_worker, i)); }
for (i = 0; i < N; i = i + 1) { thread_join(ts[i]); }
print(len(arr));               // 1200
print(arr[0]);                 // 0
print(arr[1199]);              // 5919（59*100+19）
ok = true;
for (k = 0; k < N * M; k = k + 1) {
    if (arr[k] != (int)(k / M) * 100 + (k % M)) { ok = false; }   // / 是浮点除法，强转整数
}
print(ok);                     // true（全部槽位写入正确）

print("== 多线程并发 map set（锁保护） ==");
m = {};
mm = mutex();
func map_worker(i) {
    lock(mm);
    m.set("k" + i, i);         // 原地设键（map 指针共享）
    unlock(mm);
}
ts2 = [];
for (i = 0; i < N; i = i + 1) { ts2 = ts2.add(thread(map_worker, i)); }
for (i = 0; i < N; i = i + 1) { thread_join(ts2[i]); }
print(len(m.keys()));          // 60
print(m.get("k7"));            // 7
print(m.get("k59"));           // 59
sum = 0;
for (i = 0; i < N; i = i + 1) { sum = sum + m.get("k" + i); }
print(sum);                    // 1770（0+1+...+59）

print("== 多线程并发 type 构造（锁保护） ==");
type Person { name: string, age: int }
people = range(N);             // 预分配槽位（元素共享）
mp = mutex();
func person_worker(i) {
    lock(mp);
    people[i] = Person("t" + i, i);   // 索引写（type 构造 map）
    unlock(mp);
}
ts3 = [];
for (i = 0; i < N; i = i + 1) { ts3 = ts3.add(thread(person_worker, i)); }
for (i = 0; i < N; i = i + 1) { thread_join(ts3[i]); }
print(len(people));            // 60
print(people[0].__mapname__);  // Person（type 构造注入）
p0 = people[0];
print(p0.__mapname__ == "Person");  // true
ok = true;
for (i = 0; i < len(people); i = i + 1) {
    if (people[i].__mapname__ != "Person") { ok = false; }
    if (people[i].age != i) { ok = false; }
    if (people[i].name != "t" + i) { ok = false; }
}
print(ok);                     // true（全部类名/属性正确）

print("== 多线程并发改 type 对象属性（锁保护） ==");
shared = Person("shared", 0);
ms = mutex();
func incr_worker() {
    for (j = 0; j < 100; j = j + 1) {
        lock(ms);
        shared.set("age", shared.age + 1);
        unlock(ms);
    }
}
ts4 = [];
for (i = 0; i < 20; i = i + 1) { ts4 = ts4.add(thread(incr_worker)); }
for (i = 0; i < 20; i = i + 1) { thread_join(ts4[i]); }
print(shared.age);             // 2000（20 线程 × 100 次）
print(shared.__mapname__);   // Person（属性变更不影响类名）

print("== 多线程并发读（map 键值确定性验证） ==");
mr = mutex();
func reader(i) {
    lock(mr);
    r1 = m.get("k" + i);
    unlock(mr);
    if (r1 != i) { print("读不一致 " + i); }
}
ts5 = [];
for (i = 0; i < 30; i = i + 1) { ts5 = ts5.add(thread(reader, i)); }
for (i = 0; i < 30; i = i + 1) { thread_join(ts5[i]); }
print("读检查完成");           // 若前面无"读不一致"即全部一致

print("== 多线程并发 map set 新键 + 数组并发读 ==");
mn = mutex();
func add_worker(i) {
    lock(mn);
    m.set("n" + i, i * 10);    // 原地加新键
    r2 = arr[0];               // 并发读数组
    unlock(mn);
    if (r2 != 0) { print("数组读异常 " + i); }
}
ts6 = [];
for (i = 0; i < 20; i = i + 1) { ts6 = ts6.add(thread(add_worker, i)); }
for (i = 0; i < 20; i = i + 1) { thread_join(ts6[i]); }
print(len(m.keys()));          // 80（60 键 + 20 新键）
print(m.get("n9"));            // 90
