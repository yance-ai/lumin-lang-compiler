// do-while 循环测试
print("=== do-while basic ===");
i = 0;
do {
    print(i);
    i = i + 1;
} while (i < 5);

print("=== do-while break ===");
j = 0;
do {
    if (j == 3) break;
    print(j);
    j = j + 1;
} while (j < 10);

print("=== do-while continue ===");
k = 0;
do {
    k = k + 1;
    if (k == 3) continue;
    print(k);
} while (k < 5);

print("=== do-while nested ===");
m = 0;
do {
    n = 0;
    do {
        print(m * 10 + n);
        n = n + 1;
    } while (n < 3);
    m = m + 1;
} while (m < 2);

print("=== do-while condition false first ===");
x = 100;
do {
    print("should print once");
} while (x < 5);

print("=== all tests done ===");
