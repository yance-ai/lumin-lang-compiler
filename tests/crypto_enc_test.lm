// crypto_enc_test.lm —— 字符串编码/哈希方法链：encode/decode/encodeURL/decodeURL/md5/encodeBase64/decodeBase64
print("== 1. encode/decode 双向（UTF-8/GBK） ==");
b = "中文".encode();
print(len(b));                      // 6（UTF-8 中文 3 字节 × 2）
print(b.decode());                  // 中文
bg = "中文".encode("gbk");
print(len(bg));                     // 4（GBK 中文 2 字节 × 2）
print(bg.decode("gbk"));            // 中文
print("abc".encode().decode());     // abc
print("中文English混合".encode("gbk").decode("gbk")); // 中文English混合
print("== 2. encodeURL/decodeURL ==");
print("a b&c=d".encodeURL());       // a%20b%26c%3Dd
print("a%20b%26c%3Dd".decodeURL()); // a b&c=d
print("中文".encodeURL());          // 中文（高字节原样输出）
print("hello+world".decodeURL());   // hello world（+ → 空格）
print("name=张三&age=25".encodeURL().decodeURL()); // name=张三&age=25
print("== 3. md5（标准向量验证） ==");
print("abc".md5());                 // 900150983cd24fb0d6963f7d28e17f72
print("".md5());                    // d41d8cd98f00b204e9800998ecf8427e
print("hello world".md5());         // 5eb63bbbe01eeed093cb22bb8f5acdc3
print("The quick brown fox jumps over the lazy dog".md5()); // 9e107d9d372bb6826bd81d3542a419d6
print("secret".md5().len());        // 32
print("== 4. base64 编码/解码 ==");
print("abc".encodeBase64());        // YWJj
print("YWJj".decodeBase64());       // abc
print("hello".encodeBase64());      // aGVsbG8=
print("aGVsbG8=".decodeBase64());   // hello
print("".encodeBase64());           // 空串
print("中文".encodeBase64().decodeBase64()); // 中文（往返）
print("Man".encodeBase64());        // TWFu
print("TWFu".decodeBase64());       // Man
print("== 5. 方法链组合 ==");
print("中文".encode().decode());              // 中文
print("a b".encodeURL().decodeURL());         // a b
print("中文".encodeBase64().decodeBase64());  // 中文
print("password123".md5() == "482c811da5d5b4bc6d497ffa98491e38"); // true
print("data".encodeBase64().decodeBase64() == "data"); // true
print("== 6. 长文本 + 多线程 md5 ==");
longtxt = "";
for (i = 0; i < 50; i = i + 1) { longtxt = longtxt + "中文text"; }
print(longtxt.md5().len());         // 32
print(longtxt.encodeBase64().decodeBase64() == longtxt); // true
results = range(8);
mut = mutex();
func md5_worker(tid) {
    h = ("thread" + tid).md5();
    lock(mut);
    results[tid] = len(h);
    unlock(mut);
    return h;
}
ts = [];
for (t = 0; t < 8; t = t + 1) { ts = ts.add(thread(md5_worker, t)); }
for (i = 0; i < len(ts); i = i + 1) { thread_join(ts[i]); }
all32 = true;
for (i = 0; i < 8; i = i + 1) { if (results[i] != 32) { all32 = false; } }
print(all32);                       // true
print("== done ==");
