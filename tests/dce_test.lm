// DCE 死代码消除测试
// 验证：return 后不可达代码、if(false) 分支、常量条件跳转 被正确消除
// 同时验证语义不变（消除后输出与未优化一致）

func test_after_return() {
    print("before return");
    return;
    print("this should be eliminated by DCE");
    print("this too");
}

func test_if_false() {
    if (false) {
        print("dead branch");
    } else {
        print("alive branch");
    }
}

func test_if_true() {
    if (true) {
        print("always taken");
    } else {
        print("never taken");
    }
}

func test_constant_cond() {
    x = 1;
    if (x > 0) {
        print("x positive");
    }
    if (x < 0) {
        print("x negative - should be DCEd");
    }
}

func test_while_false() {
    while (false) {
        print("dead loop");
    }
    print("after dead loop");
}

func test_nested() {
    if (true) {
        if (false) {
            print("nested dead");
        }
        print("nested alive");
    }
}

// 主测试
test_after_return();
test_if_false();
test_if_true();
test_constant_cond();
test_while_false();
test_nested();
print("dce_test done");
