// json_test.lm —— 数组/map JSON 序列化与反序列化全场景（含任意类型键）
print("== 1. 基本数组序列化 ==");
arr1 = [1, 2, 3, 4, 5];
print(stringify(arr1));
print(arr1.stringify());

print("== 2. 混合类型数组 ==");
arr2 = [1, "hello", true, 3.14, null, 'c'];
print(stringify(arr2));

print("== 3. 嵌套数组 ==");
arr3 = [[1, 2], [3, 4], [5, [6, 7]]];
print(stringify(arr3));

print("== 4. 空数组 ==");
print(stringify([]));

print("== 5. string 键 map 序列化 ==");
m1 = {"name": "lumyr", "version": 1, "active": true};
print(stringify(m1));
print(m1.stringify());

print("== 6. int 键 map 序列化（键自动转字符串） ==");
m2 = {1: "one", 2: "two", 100: "hundred"};
print(stringify(m2));

print("== 7. char 键 map 序列化 ==");
m3 = {'a': 1, 'b': 2};
print(stringify(m3));

print("== 8. bool 键 map 序列化 ==");
m4 = {true: "yes", false: "no"};
print(stringify(m4));

print("== 9. double 键 map 序列化 ==");
m5 = {3.14: "pi", 2.71: "e"};
print(stringify(m5));

print("== 10. 混合类型键 map ==");
m6 = {"str": 1, 42: "int", 'c': true, 3.14: "pi", false: "no"};
print(stringify(m6));

print("== 11. 嵌套 map ==");
m7 = {"user": {"name": "alice", "age": 30}, "scores": [90, 85, 95]};
print(stringify(m7));

print("== 12. map 包 array，array 包 map ==");
m8 = {"items": [{"id": 1, "val": "a"}, {"id": 2, "val": "b"}]};
print(stringify(m8));
arr4 = [{"x": 1}, {"y": 2}];
print(stringify(arr4));

print("== 13. 空 map ==");
print(stringify({}));

print("== 14. 自定义 type 对象序列化 ==");
type Person { name: string, age: int }
p = {name: "bob", age: 25};
print(stringify(p));

print("== 15. 含 null 值的 map ==");
m9 = {"a": 1, "b": null, "c": "hello"};
print(stringify(m9));

print("== 16. 字符串值序列化 ==");
m10 = {"simple": "hello world", "empty": "", "unicode": "中文测试"};
print(stringify(m10));

print("== 17. JSON 反序列化：基本对象 ==");
src1 = {"name": "lumyr", "version": 1, "active": true};
j1 = json(stringify(src1));
print(j1["name"]);
print(j1["version"]);
print(j1["active"]);

print("== 18. JSON 反序列化：数组 ==");
src2 = [1, 2, 3, "four", true, null];
j2 = json(stringify(src2));
print(j2[0]);
print(j2[3]);
print(j2[4]);
print(j2[5]);

print("== 19. JSON 反序列化：嵌套 ==");
src3 = {"user": {"name": "alice", "age": 30}, "scores": [90, 85]};
j3 = json(stringify(src3));
print(j3["user"]["name"]);
print(j3["user"]["age"]);
print(j3["scores"][0]);

print("== 20. 往返测试：序列化→解析→序列化 ==");
original = {"a": 1, "b": [2, 3], "c": {"d": "hello"}};
s1 = stringify(original);
parsed = json(s1);
s2 = stringify(parsed);
print(s1 == s2);

print("== 21. 数组往返 ==");
arr5 = [1, "two", true, [3, 4], {"five": 5}];
sa = stringify(arr5);
pa = json(sa);
print(stringify(pa) == sa);

print("== 22. int 键 map 往返（键变成字符串） ==");
m11 = {1: "one", 2: "two"};
sm = stringify(m11);
pm = json(sm);
print(pm["1"]);
print(pm["2"]);

print("== 23. UTF-8 中文序列化 ==");
m12 = {"名称": "照明", "描述": "编译器"};
print(stringify(m12));
print(stringify(m12, "UTF-8"));

print("== 24. 中文往返 ==");
sc = stringify(m12);
pc = json(sc);
print(pc["名称"]);

print("== 25. 空字符串/零值 ==");
m13 = {"empty": "", "zero": 0, "false": false, "nul": null};
print(stringify(m13));

print("== 26. 大数组序列化 ==");
big = [];
for(i = 0; i < 100; i++) big = big.add(i);
sb = stringify(big);
print(sb.len() > 0);
pb = json(sb);
print(pb.len());
print(pb[99]);

print("== 27. 深层嵌套 ==");
deep = {"a": {"b": {"c": {"d": [1, 2, {"e": "deep"}]}}}};
print(stringify(deep));
pd = json(stringify(deep));
print(pd["a"]["b"]["c"]["d"][2]["e"]);

print("== 28. 泛型数组序列化 ==");
ga = <int8>[200, 128, 50];
print(stringify(ga));

print("== 29. 泛型 map 序列化 ==");
gm = <string,int8>{"a": 200, "b": 128};
print(stringify(gm));

print("== 30. json() 方法调用 ==");
src30 = {"method": "test", "code": 200};
js = stringify(src30);
print(js.json()["method"]);
print(js.json()["code"]);

print("== 31. char 键往返 ==");
m14 = {'a': 1, 'b': 2};
sc14 = stringify(m14);
print(sc14);
pc14 = json(sc14);
print(pc14["a"]);
print(pc14["b"]);

print("== 32. bool 键往返 ==");
m15 = {true: "yes", false: "no"};
sc15 = stringify(m15);
print(sc15);
pc15 = json(sc15);
print(pc15["true"]);
print(pc15["false"]);

print("== 33. double 键往返 ==");
m16 = {3.14: "pi", 2.71: "e"};
sc16 = stringify(m16);
print(sc16);
pc16 = json(sc16);
print(pc16["3.14"]);
print(pc16["2.71"]);

print("ALL DONE");
