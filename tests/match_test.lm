// match_test.lm —— match/case 模式匹配基础测试
// match 作为 switch 的别名，支持字面量匹配和 default 通配符

x = 2;
match (x) {
    case 1:
        print("one");
        break;
    case 2:
        print("two");
        break;
    case 3:
        print("three");
        break;
    default:
        print("other");
}

// 字符串匹配
s = "hello";
match (s) {
    case "hello":
        print("greeting");
        break;
    case "bye":
        print("farewell");
        break;
    default:
        print("unknown");
}

// 无 break 的 fallthrough（C 风格）
n = 1;
match (n) {
    case 1:
        print("case1");
    case 2:
        print("case2");
        break;
    default:
        print("default");
}

print("ALL MATCH TESTS DONE");
