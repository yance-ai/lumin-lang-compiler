// charset_enc_test.lm —— 字符编码参数支持（qs/json/bytes/stringify 可选 UTF-8/GBK 等编码，默认 UTF-8）
// 第 1 节：bytes/str 双向（UTF-8 中文 3 字节、GBK 中文 2 字节）
print("== 1. bytes/str 双向 ==");
b = "中文".bytes();
print(len(b));                       // 6
print(b[0]);                         // 228 (E4)
print(str(b));                       // 中文
bg = "中文".bytes("gbk");
print(len(bg));                      // 4
print(bg[0]);                        // 214 (D6)
print(str(bg, "gbk"));               // 中文
print(str("中文".bytes("gbk"), "gbk")); // 中文
print("abc".bytes().len());          // 3
print(str("abc".bytes()));           // abc
print(str("a".bytes("ascii")));      // a
print("== 2. 编码切换一致性 ==");
s = "中文English混合123";
bu = s.bytes();                      // UTF-8
bg = s.bytes("gbk");                 // GBK
print(len(bu) > len(bg));            // true（UTF-8 中文占 3 字节，GBK 占 2）
print(str(bu));                      // s
print(str(bg, "gbk"));               // s
print(str(s.bytes("gb18030"), "gb18030")); // s
print(str("hello".bytes("big5"), "big5")); // hello（big5 无简体，ASCII 原样）
print("== 3. qs 编码参数 ==");
m = {"name": "张三", "age": 25, "ok": true};
print(qs(m));                        // name=%E5%BC%A0%E4%B8%89&age=25&ok=true
print(qs(m, "gbk"));                 // name=%D5%C5%C8%FD&age=25&ok=true
print(qs("name=%D5%C5%C8%FD&age=25", "gbk").name); // 张三
r = qs("name=%E5%BC%A0%E4%B8%89&age=25");
print(r.age);                        // 25
print(r.name);                       // 张三
print(qs({"k": "v"}));               // k=v
print(qs({"k": "v"}, "gbk"));        // k=v
print("== 4. json/stringify 编码参数 ==");
o = {"name": "张三", "tags": ["a", "中文"]};
j = stringify(o);                    // UTF-8
print(json(j).name);                 // 张三
print(json(j).tags[1]);              // 中文
jg = stringify(o, "gbk");
print(json(jg, "gbk").name);         // 张三
print(json(jg, "gbk").tags[1]);      // 中文
print(stringify({"n": 1}));          // {"n":1}
print(json(stringify({"n": 1})).n);  // 1
print(json(stringify({"a": [1, 2, 3]})).a[2]); // 3print("== 5. 多层嵌套 + 方法链 ==");
data = {"user": {"name": "李四"}, "list": [{"id": 1, "name": "王五"}, {"id": 2, "name": "赵六"}]};
print(stringify(data));
print(json(stringify(data)).user.name);     // 李四
print(json(stringify(data)).list[1].name);  // 赵六
print(json(stringify(data, "gbk"), "gbk").list[0].name); // 王五（GBK 全程）
print("中文".bytes().str());                 // 中文（链式）
print("中文".bytes("gbk").str("gbk"));       // 中文（链式）
print("== 6. 长文本 + 多字节混合 ==");
longtxt = "";
for (i = 0; i < 20; i = i + 1) { longtxt = longtxt + "中文text"; }
lb = longtxt.bytes();
print(len(lb));                      // 20×(6+4)=200
print(str(lb) == longtxt);           // true
lbg = longtxt.bytes("gbk");
print(len(lbg));                     // 20×(4+4)=160
print(str(lbg, "gbk") == longtxt);   // true
print(stringify({"long": longtxt}) != "");
print("== 7. 并发字节转换 ==");
gs = range(10);                      // 预分配槽（索引写跨线程共享 items）
mut = mutex();
func enc_worker(tid) {
    total = 0;
    for (i = 0; i < 100; i = i + 1) {
        tb = ("第" + i).bytes("gbk");
        total = total + len(str(tb, "gbk"));
    }
    lock(mut);
    gs[tid] = total;                 // 索引写原地共享
    unlock(mut);
    return total;
}
ts = [];
for (t = 0; t < 10; t = t + 1) {
    ts = ts.add(thread(enc_worker, t));
}
for (i = 0; i < len(ts); i = i + 1) { thread_join(ts[i]); }
print(len(gs));                      // 10
print(gs[0] > 0 && gs[9] > 0);       // true
print(len(gs) == 10);
print("== done ==");
