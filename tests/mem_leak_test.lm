// 编译通道内存泄漏验证测试
// 长循环创建临时对象，不保留引用，观察 gc_count/gc_bytes 趋势
// VM 通道：自动 GC 应回收，gc_bytes 稳定
// 编译通道（修复前）：自动 GC 永不触发，gc_bytes 持续增长

func make_temp(i) {
    s = "temp_string_" + i;
    a = [1, 2, 3, i];
    m = {"key": i, "val": s};
    return len(s) + len(a) + len(m);
}

N = 200000;
start_bytes = gc_bytes();
start_count = gc_count();
print("=== 初始: gc_bytes=" + start_bytes + " gc_count=" + start_count + " ===");

sum = 0;
for (i = 0; i < N; i = i + 1) {
    sum = sum + make_temp(i);
    if (i % 50000 == 49999) {
        b = gc_bytes();
        c = gc_count();
        print("iter " + (i+1) + ": gc_bytes=" + b + " gc_count=" + c + " delta=" + (b - start_bytes));
    }
}

end_bytes = gc_bytes();
end_count = gc_count();
print("=== 结束: gc_bytes=" + end_bytes + " gc_count=" + end_count + " ===");
print("=== 净增长: bytes=" + (end_bytes - start_bytes) + " count=" + (end_count - start_count) + " ===");
print("sum=" + sum);
