// const fn 编译期计算测试

// 无参数 const fn
const func get_const() {
    return 42;
}

print("=== Test 1: no-arg const fn ===");
print(get_const());

// 有参数 const fn
const func square(x) {
    return x * x;
}

print("=== Test 2: const fn with args ===");
print(square(5));
print(square(10));

// 嵌套 const fn 调用
const func add(a, b) {
    return a + b;
}

print("=== Test 3: nested const fn ===");
print(add(square(3), square(4)));

// 字符串 const fn
const func greet(name) {
    return "Hello, " + name;
}

print("=== Test 4: string const fn ===");
print(greet("World"));

// 非 const 函数（正常调用，不编译期求值）
func normal_func(x) {
    return x * 2;
}

print("=== Test 5: normal function (not const) ===");
print(normal_func(21));

print("=== All const fn tests passed ===");
