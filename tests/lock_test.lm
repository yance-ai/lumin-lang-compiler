// ===== 锁机制测试：互斥锁 / 递归互斥锁 / 读写锁 / 自旋锁 =====
// 语义：mutex()/rmutex()/rwlock()/spinlock() 创建锁返回 id；
//       lock(id)/unlock(id) 通用；trylock(id) 非阻塞尝试（互斥/递归/自旋）；
//       rdlock(id)/wrlock(id) 仅读写锁。所有 print 确定性，双通道可逐行 diff。

// 1. 互斥锁基础 + trylock
m = mutex();
lock(m);
print("locked-trylock: " + trylock(m));        // false（已持有，非递归）
unlock(m);
print("trylock-after-unlock: " + trylock(m));  // true
unlock(m);
print("mutex-basic: 1");

// 2. 递归互斥锁：同线程重复加锁不阻塞
r = rmutex();
lock(r);
lock(r);              // 递归锁可重入
unlock(r);
unlock(r);
print("rmutex-reentrant: 1");

// 3. 读写锁：读锁共享可重入 / 写锁独占
rw = rwlock();
rdlock(rw);
rdlock(rw);           // 读锁可重入（共享）
unlock(rw);
unlock(rw);
wrlock(rw);
print("rw-wrlock: 1");
unlock(rw);
print("rwlock-basic: 1");

// 4. 自旋锁基础
sp = spinlock();
lock(sp);
print("spin-locked-trylock: " + trylock(sp));  // false
unlock(sp);
print("spin-trylock: " + trylock(sp));         // true
unlock(sp);

// 5. 互斥锁保护共享计数（4 线程 × 10000 → 精确 40000）
g = [0];
gm = mutex();
func inc_guarded() {
    for (i = 0; i < 10000; i = i + 1) {
        lock(gm);
        g[0] = g[0] + 1;
        unlock(gm);
    }
}
ta = thread(inc_guarded); tb = thread(inc_guarded);
tc = thread(inc_guarded); td = thread(inc_guarded);
thread_join(ta); thread_join(tb); thread_join(tc); thread_join(td);
print("mutex-counter: " + g[0]);               // 40000

// 6. 递归锁：外层持锁 → 内层函数再锁（不阻塞）
gr = [0];
rm = rmutex();
func inner_inc() {
    lock(rm);
    gr[0] = gr[0] + 1;
    unlock(rm);
}
func outer_inc() {
    lock(rm);          // 外层持锁
    inner_inc();       // 内层再锁（递归锁不阻塞）
    unlock(rm);
}
t1 = thread(outer_inc); t2 = thread(outer_inc);
thread_join(t1); thread_join(t2);
print("rmutex-counter: " + gr[0]);             // 2

// 7. 读写锁：写锁保护计数（独占，2 线程 × 5000 → 精确 10000）
gw = [0];
rwm = rwlock();
func writer_inc() {
    for (i = 0; i < 5000; i = i + 1) {
        wrlock(rwm);
        gw[0] = gw[0] + 1;
        unlock(rwm);
    }
}
w1 = thread(writer_inc); w2 = thread(writer_inc);
thread_join(w1); thread_join(w2);
print("rwlock-writer: " + gw[0]);              // 10000

// 8. 自旋锁保护计数（2 线程 × 5000 → 精确 10000）
gs = [0];
spm = spinlock();
func spin_inc() {
    for (i = 0; i < 5000; i = i + 1) {
        lock(spm);
        gs[0] = gs[0] + 1;
        unlock(spm);
    }
}
s1 = thread(spin_inc); s2 = thread(spin_inc);
thread_join(s1); thread_join(s2);
print("spin-counter: " + gs[0]);               // 10000

// 9. 错误场景：无效锁 id / 类型错配（try/catch 捕获 runtime_error）
try {
    lock(99999);
} catch (e) {
    print("err-invalid-id: caught");
}
try {
    rdlock(m);         // m 是互斥锁 → rdlock 类型错配
} catch (e) {
    print("err-rdlock-on-mutex: caught");
}
try {
    lock(rw);          // rw 是读写锁 → lock 提示用 rd/wr
} catch (e) {
    print("err-lock-on-rwlock: caught");
}
print("lock-test-done");
