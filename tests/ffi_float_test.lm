extern "msvcrt.dll" <double> func floor(<double>x);
extern "msvcrt.dll" <double> func fabs(<double>x);
extern "msvcrt.dll" <double> func pow(<double>base, <double>exp);
extern "msvcrt.dll" <double> func sqrt(<double>x);
extern "msvcrt.dll" <double> func ceil(<double>x);

print("=== FFI Float Parameter Test ===");

x = 3.7;
y = floor(x);
print("floor(3.7) =", y);

z = fabs(-3.14);
print("fabs(-3.14) =", z);

p = pow(2.0, 10.0);
print("pow(2.0, 10.0) =", p);

s = sqrt(144.0);
print("sqrt(144.0) =", s);

c = ceil(3.2);
print("ceil(3.2) =", c);

print("\n=== All Float Parameter Tests Passed ===");
