// 注解/属性测试

@log
@deprecated("use new_func instead")
func old_func() {
    print("old_func called");
}

func new_func() {
    print("new_func called");
}

@test
func add(a, b) {
    return a + b;
}

print("=== Test 1: call annotated function ===");
old_func();

print("=== Test 2: call annotated function with args ===");
print(add(10, 20));

print("=== All annotation tests passed ===");
