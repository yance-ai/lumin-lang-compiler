// qs_flat_map_test.lm —— flat 扁平化 / map 字典回调 / qs 查询字符串 双向
print("== 1. flat 数组扁平化 ==");
a = [1, [2, 3], [[4]]];
f0 = a.flat(0);                 // 不展开：len 3（元素保持）
print(len(f0));                 // 3
print(f0[0]);                   // 1
f1 = a.flat();                  // 深度 1：展开一层 → [1,2,3,[4]]
print(len(f1));                 // 4
print(f1[0]);                   // 1
print(f1[1]);                   // 2
print(f1[2]);                   // 3
print(f1[3].len());             // 1（[4] 未再展开）
print(f1[3][0]);                // 4
f2 = a.flat(2);                 // 深度 2：全展开 [1,2,3,4]
print(len(f2));                 // 4
print(f2[3]);                   // 4
fn = a.flat(-1);                // 无限深度
print(len(fn));                 // 4
print(fn[3]);                   // 4
b = [1, [2, [3, [4]]]];
fb = b.flat(1);                 // [1, 2, [3,[4]]]
print(len(fb));                 // 3
print(fb[2].len());             // 2
fb2 = b.flat(2);                // [1, 2, 3, [4]]
print(len(fb2));                // 4
print(fb2[3].len());            // 1
deep = [1, [2, [3, [4, [5]]]]];
print(deep.flat(-1).len());     // 5
print(deep.flat(-1)[4]);        // 5
mix = [[1, 2], "s", [3.5, [true]]];
fm = mix.flat(2);
print(len(fm));                 // 5（1,2,s,3.5,true）
print(fm[0]);                   // 1
print(fm[2]);                   // s
print(fm[4]);                   // true

print("== 2. flat 字典（值数组展平） ==");
mf = {"x": [1, 2], "y": [3, [4]]};
print(mf.flat(2).len());        // 4（1,2,3,4）
print(mf.flat(2)[2]);           // 3
print(mf.flat(-1).len());       // 4
print(mf.flat(-1)[3]);          // 4

print("== 3. 数组 map（函数值回调） ==");
func dbl(x) { return x * 2; }
r = [1, 2, 3, 4].map(dbl);
print(len(r));                  // 4
print(r[0]);                    // 2
print(r[3]);                    // 8
func sq(x) { return x * x; }
print([1, 2, 3].map(sq).join(","));  // 1,4,9
// 链式：flat 后 map
nested = [[1, 2], [3]];
rn = nested.flat(2).map(dbl);
print(len(rn));                 // 3
print(rn[2]);                   // 6
// map 结果继续 map
rr = [1, 2].map(dbl).map(sq);
print(rr[0]);                   // 4
print(rr[1]);                   // 16

print("== 4. 字典 map（fn(value, key) → 新字典） ==");
mm = {"a": 1, "b": 2, "c": 3};
func kv(v, k) { return k + "=" + v; }
print(mm.map(kv).qs());         // a=a%3D1&b=b%3D2&c=c%3D3
func inc_v(v, k) { return v + 100; }
print(mm.map(inc_v).qs());      // a=101&b=102&c=103
func len_s(v, k) { return len(k); }
print(mm.map(len_s).qs());      // a=1&b=1&c=1

print("== 5. qs 序列化（stringify） ==");
m1 = {"name": "john", "age": 30};
print(qs(m1));                  // name=john&age=30
m2 = {"user": {"name": "john", "age": 30}};
print(qs(m2));                  // user[name]=john&user[age]=30
m3 = {"tags": ["a", "b"]};
print(qs(m3));                  // tags[0]=a&tags[1]=b
m4 = {"user": {"name": "张三", "tags": ["a", "b"]}, "n": 5};
print(qs(m4));                  // user[name]=%E5%BC%A0%E4%B8%89&user[tags][0]=a&user[tags][1]=b&n=5
print(qs({"a": [1, {"b": 2}]}));  // a[0]=1&a[1][b]=2
print(qs({}));                  // 空字典 → 空串

print("== 6. qs 解析（parse） ==");
r1 = qs("name=john&age=30");
print(r1.name);                 // john
print(r1.age);                  // 30
r2 = qs("user[name]=zhang&user[age]=30");
print(r2.user.name);            // zhang
print(r2.user.age);             // 30
r3 = qs("tags[0]=a&tags[1]=b");
print(r3.tags[0]);              // a
print(r3.tags[1]);              // b
r4 = qs("user[name]=zhang&tags[0]=a&tags[1]=b");
print(r4.user.name);            // zhang
print(r4.tags.len());           // 2
r5 = qs("a[0][x]=1&a[0][y]=2&b=3");
print(r5.a[0].x);               // 1
print(r5.a[0].y);               // 2
print(r5.b);                    // 3
r6 = qs("name=%E5%BC%A0%E4%B8%89&k=hello+world");
print(r6.name);                 // 张三
print(r6.k);                    // hello world

print("== 7. qs 双向往返 ==");
orig = {"user": {"name": "john", "age": 30}, "tags": ["a", "b"]};
back = qs(qs(orig));
print(back.user.name);          // john
print(back.user.age);           // 30
print(back.tags[0]);            // a
print(back.tags[1]);            // b
print(qs(qs({"x": 1})).x);      // 1

print("== 8. 综合链式 ==");
func even(x) { return x % 2 == 0; }
data = [[1, 2], [3, 4], [5, 6]];
rd = data.flat(2).map(dbl);
print(rd.join(","));            // 2,4,6,8,10,12
func big(x) { return x > 5; }
rb = data.flat(2).map(dbl).filter(big);
print(rb.join(","));            // 6,8,10,12
func sum2(a, b) { return a + b; }
print(data.flat(2).reduce(sum2, 0));  // 21
person = {"name": "李四", "info": {"age": 25, "hobby": ["x", "y"]}};
p2 = qs(qs(person));
print(p2.name);                 // 李四
print(p2.info.age);             // 25
print(p2.info.hobby[1]);        // y
