// generator_full_test.lm —— 生成器全功能测试（VM + 编译双通道）
print("== 1. 基本生成器 ==");
gen func range1(n) {
    i = 0;
    while (i < n) {
        yield i;
        i = i + 1;
    }
}
g = range1(3);
print(next(g));  // 0
print(next(g));  // 1
print(next(g));  // 2
print(next(g));  // null

print("== 2. for-each 遍历生成器 ==");
for x in range1(5) {
    print(x);  // 0,1,2,3,4
}

print("== 3. 生成器 map ==");
func dbl(x) { return x * 2; }
for x in range1(4).map(dbl) {
    print(x);  // 0,2,4,6
}

print("== 4. 生成器 filter ==");
func even(x) { return x % 2 == 0; }
for x in range1(10).filter(even) {
    print(x);  // 0,2,4,6,8
}

print("== 5. 生成器 skip ==");
for x in range1(6).skip(2) {
    print(x);  // 2,3,4,5
}

print("== 6. 生成器 take ==");
for x in range1(100).take(3) {
    print(x);  // 0,1,2
}

print("== 7. 生成器 chain ==");
for x in range1(2).chain(range1(3)) {
    print(x);  // 0,1,0,1,2
}

print("== 8. 生成器 enumerate ==");
for x in range1(3).enumerate() {
    print(x[0]);
    print(x[1]);
}

print("== 9. 组合链式调用 ==");
func sq(x) { return x * x; }
for x in range1(10).filter(even).map(sq).skip(1).take(2) {
    print(x);  // 4,16
}

print("== 10. 生成器 send/receive ==");
gen func accum(n) {
    sum = 0;
    i = 0;
    while (i < n) {
        v = receive();
        if (v != null) {
            sum = sum + v;
        }
        yield sum;
        i = i + 1;
    }
}
a = accum(3);
print(next(a));   // 0（第一次 next，receive 返回 null）
print(send(a, 5)); // 5（send 5，sum=5）
print(send(a, 7)); // 12（send 7，sum=12）
print(next(a));   // null（生成器已结束）

print("== 11. 生成器 close ==");
g2 = range1(100);
print(next(g2));  // 0
close(g2);
print(next(g2));  // null

print("== 12. 生成器嵌套 ==");
gen func nested() {
    yield 1;
    for x in range1(2) {
        yield x + 10;
    }
    yield 100;
}
for x in nested() {
    print(x);  // 1,10,11,100
}

print("done");
