// json_type_thread_test.lm —— 自定义 type JSON 全场景 + 多线程并发
print("== 1. 自定义 type 作为 map 键（序列化） ==");
type Point { x: int, y: int }
p1 = {x:1, y:2};
p2 = {x:3, y:4};
m1 = {[p1]: "A", [p2]: "B"};
print(stringify(m1));

print("== 2. 自定义 type 作为键（访问） ==");
print(m1[p1]);
print(m1[{x:1, y:2}]);
print(m1[p2]);

print("== 3. 自定义 type 作为值 ==");
type Person { name: string, age: int }
m2 = {"alice": {name: "Alice", age: 30}, "bob": {name: "Bob", age: 25}};
print(stringify(m2));
print(m2["alice"].name);
print(m2["bob"].age);

print("== 4. 自定义 type 嵌套自定义 type ==");
type Address { city: string, zip: int }
type User { name: string, addr: Address }
u1 = {name: "carol", addr: {city: "Beijing", zip: 100000}};
print(stringify(u1));
print(u1.addr.city);
print(u1.addr.zip);

print("== 5. 自定义 type 数组 ==");
arr1 = [{x:1, y:2}, {x:3, y:4}, {x:5, y:6}];
print(stringify(arr1));
print(arr1[1].x);

print("== 6. 自定义 type 数组作为 map 值 ==");
m3 = {"points": [{x:1, y:2}, {x:3, y:4}]};
print(stringify(m3));
print(m3["points"][0].x);

print("== 7. map 键为自定义 type，值为自定义 type ==");
m4 = {[p1]: {name: "origin"}, [p2]: {name: "far"}};
print(stringify(m4));

print("== 8. 自定义 type 往返（序列化→解析） ==");
src = {name: "dave", age: 40};
s = stringify(src);
parsed = json(s);
print(parsed["name"]);
print(parsed["age"]);
print(stringify(parsed) == s);

print("== 9. 自定义 type 数组往返 ==");
arr2 = [{x:1, y:2}, {x:3, y:4}];
sa = stringify(arr2);
pa = json(sa);
print(pa[0].x);
print(pa[1].y);
print(stringify(pa) == sa);

print("== 10. 自定义 type 键往返（键变 JSON 字符串） ==");
m5 = {[p1]: "first"};
sm = stringify(m5);
pm = json(sm);
keyStr = stringify(p1);
print(pm[keyStr]);

print("== 11. 多 type 混合 ==");
type Color { r: int, g: int, b: int }
type Pixel { pos: Point, color: Color }
pix = {pos: {x:10, y:20}, color: {r:255, g:128, b:0}};
print(stringify(pix));
print(pix.pos.x);
print(pix.color.r);

print("== 12. type 实例序列化（含 __mapname__） ==");
pt = Point(x=10, y=20);
print(pt.__mapname__);
spt = stringify(pt);
print(spt);
ppt = json(spt);
print(ppt["x"]);
print(ppt["__mapname__"]);

print("== 13. 多线程：并发序列化 ==");
func worker(id) {
    result = 0;
    for(i = 0; i < 500; i++) {
        obj = {"id": id, "idx": i, "data": [1, 2, 3]};
        s = stringify(obj);
        if(s.len() > 0) result = result + 1;
    }
    return result;
}
t1 = thread(worker, 1);
t2 = thread(worker, 2);
t3 = thread(worker, 3);
r1 = thread_join(t1);
r2 = thread_join(t2);
r3 = thread_join(t3);
print(r1);
print(r2);
print(r3);
print(r1 == 500 && r2 == 500 && r3 == 500);

print("== 14. 多线程：并发序列化+解析往返 ==");
func roundtrip(id) {
    ok = 0;
    for(i = 0; i < 300; i++) {
        obj = {"id": id, "i": i, "nested": {"a": i, "b": [i, i+1]}};
        s = stringify(obj);
        p = json(s);
        if(p["id"] == id && p["i"] == i && p["nested"]["a"] == i) ok = ok + 1;
    }
    return ok;
}
rt1 = thread(roundtrip, 10);
rt2 = thread(roundtrip, 20);
rt3 = thread(roundtrip, 30);
rr1 = thread_join(rt1);
rr2 = thread_join(rt2);
rr3 = thread_join(rt3);
print(rr1);
print(rr2);
print(rr3);
print(rr1 == 300 && rr2 == 300 && rr3 == 300);

print("== 15. 多线程：自定义 type 并发序列化 ==");
func type_worker(id) {
    ok = 0;
    for(i = 0; i < 200; i++) {
        pt = {x: id * 100 + i, y: i};
        s = stringify(pt);
        p = json(s);
        if(p["x"] == id * 100 + i && p["y"] == i) ok = ok + 1;
    }
    return ok;
}
tw1 = thread(type_worker, 1);
tw2 = thread(type_worker, 2);
tw3 = thread(type_worker, 3);
tr1 = thread_join(tw1);
tr2 = thread_join(tw2);
tr3 = thread_join(tw3);
print(tr1);
print(tr2);
print(tr3);
print(tr1 == 200 && tr2 == 200 && tr3 == 200);

print("== 16. 多线程：map 任意键并发序列化 ==");
func key_worker(id) {
    ok = 0;
    for(i = 0; i < 200; i++) {
        m = {[id]: i, [i]: "val", "mixed": {x: i}};
        s = stringify(m);
        if(s.len() > 0) ok = ok + 1;
    }
    return ok;
}
kw1 = thread(key_worker, 1);
kw2 = thread(key_worker, 2);
kr1 = thread_join(kw1);
kr2 = thread_join(kw2);
print(kr1);
print(kr2);
print(kr1 == 200 && kr2 == 200);

print("ALL DONE");
