func test() {
    for (i = 0; i < 20000; i = i + 1) {
        s = "long_string_" + i + "_padding";
        a = [1, 2, 3, i, i + 1, i + 2];
        m = {"key": i, "val": s};
    }
    print("after loop: count=" + gc_count() + " bytes=" + gc_bytes() + "\n");
    gc_collect();
    print("after gc1 (s/a/m alive): count=" + gc_count() + " bytes=" + gc_bytes() + "\n");
    s = null; a = null; m = null;
    gc_collect();
    print("after gc2 (nulled): count=" + gc_count() + " bytes=" + gc_bytes() + "\n");
}
test();
