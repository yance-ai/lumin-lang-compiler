// string_test.lm —— null 字面量 + 混合类型数组 + 字符串函数族
// 预期输出（双通道一致）：
//   null / is null / 4 / null / HELLO WORLD / hello world
//   3 / a / c / hello / 5 / 1 / true

// ---- null 字面量 ----
x = null;
print(x);
if (x == null) { print("is null"); }
if (null == null) { print("null == null"); }

// ---- 混合类型数组（数字/字符串/bool/char/null/double）----
a = [1, "hi", null, true, 'c', 3.5];
print(len(a));
print(a[2]);          // null 元素
print(a[1]);          // 字符串元素
print(a[4]);          // char 元素

// ---- 数组元素写入混合值 ----
a[0] = "one";
print(a[0]);
a[1] = 99;
print(a[1]);

// ---- 字符串函数族 ----
s = "Hello World";
print(toupper(s));
print(tolower(s));
print(substr(s, 0, 5));       // "Hello"
print(len(s));                // 11 -> "Hello World" 是 11 字符

// ---- split ----
parts = split("a,b,c", ",");
print(len(parts));
print(parts[0]);
print(parts[2]);

// ---- 多维数组 ----
m = [[1, 2], [3, 4]];
print(m[0][1]);   // 2
print(m[1][0]);   // 3
print(len(m));    // 2
m[1][1] = 99;     // 多维写
print(m[1][1]);   // 99
cube = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]];
print(cube[1][0][1]);   // 6（三维）

// ---- del / insert（引用语义：原地修改）----
a = [1, 2, 3, 4];
a = del(a, 1);
print(len(a));    // 3
print(a[0]);      // 1
print(a[2]);      // 4
b = insert(a, 2, 99);
print(len(b));    // 4
print(b[2]);      // 99
b = insert(b, 0, "head");
print(b[0]);      // head
b = insert(b, len(b), "tail");
print(b[len(b)-1]);   // tail
c = [[1,2],[3,4]];
c = del(c, 0);
print(len(c));    // 1
print(c[0][0]);   // 3

// ---- 数学与极值内置 ----
print(floor(3.7));    // 3
print(floor(-3.7));   // -4（向下取整）
print(ceil(3.2));     // 4
print(ceil(-3.2));    // -3
print(abs(-5));       // 5（保持 int）
print(abs(-2.5));     // 2.5（保持 double）
print(sqrt(16));      // 4
print(max(3, 7, 2));  // 7（变参）
print(min(8, 3, 5));  // 3
print(max("apple", "banana"));  // banana（字符串比较）

// ---- join / contains ----
print(join(["a", "b", "c"], ","));  // a,b,c
print(join([1, 2, 3], "-"));        // 1-2-3（数字自动转字符串）
print(contains("hello world", "world"));  // true
print(contains("hello", "xyz"));          // false
print(contains([1, 2, 3], 2));            // true
print(contains(["a", "b"], "c"));         // false

// ---- repeat / replace / sum / avg ----
print(repeat("ab", 3));          // ababab
print(repeat("-", 10));          // ----------
print(replace("hello world hello", "hello", "hi"));  // hi world hi
print(replace("aaa", "a", "bb"));       // bbbbbb
print(sum([1, 2, 3]));           // 6（全 int → int）
print(sum([1.5, 2.5]));          // 4（全 double → double）
print(sum([1, 2.5]));            // 3.5（混合 → double）
print(avg([1, 2, 3, 4]));        // 2.5
print(avg([2, 4]));              // 3

// ---- 负数 int / sort / reverse / range 步长 / format / 拼接 ----
print(type(-1));            // int（修复：负数字面量是 int）
print(type(-3.5));          // double
print(-1 + 0);              // -1
print(join(sort([5, 2, 9, 1]), ","));      // 1,2,5,9（数字升序）
print(join(sort(["banana", "apple", "cherry"]), ","));  // apple,banana,cherry（字典序）
print(join(reverse([1, 2, 3]), ","));      // 3,2,1
print(join(range(2, 6), ""));              // 2345
print(join(range(0, 10, 3), ""));          // 0369
print(join(range(5, 0, -1), ""));          // 54321（负步长）
print(format("x={} y={} z={}", 1, "two", 3.5));  // x=1 y=two z=3.5
print(format("{{}} 转义 {}", 99));         // {} 转义 99
print("n=" + 5);            // n=5（字符串拼接自动转）
print("b=" + true);         // b=true
