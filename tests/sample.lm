d = 10;
if(d>5) print(true); elseif(d<5) print(false); else print(0);

e = 20;
if(e>100) {
    print(true);
    e = 999;
} elseif(e < 50) {
    print(false);
} else {
    print(111);
}

f = 20.0;
if(f > 15) {
    print(f);
    if(f>5) print(true);
    if(f>50){
    print(50+true);
    }else{
    print(50+false);
    }
}
if(f>5) print(true);

g=0;
while(g<5){
    print("while-"+g);
    g=g+1;
}

for(j=0;j<3;j=j+1){
    print("for-"+j);
}
for(j=0.0;j<3;j=j+0.1){
    print("for-"+j);
}
for(ch='a'; ch <= 'z'; ch = ch + 1) {
    print("a-z:"+ch);
}

for(ch='A'; ch <= 'Z'; ch = ch + 1) {
    print("A-Z:"+ch);
}
print("test-");
print((ASCII)'A');
for(ch='A'; ch <= 'z'; ch ++) {
    print("A-z:"+ch+"(int)"+(int)ch+(ASCII)ch);
    print("A-z2:"+ch+"(int)"+(int)ch+"ASCII-"+(ASCII)ch);
    print("ASCII=>"+(ASCII)ch);
}
for(ch='z'; ch >= 90; ch --) {
    print("z-A:"+ch+(int)ch+((ch>100)?true:false));
}
h = 'Z';
print("Z:"+(int)h);
print("Z>95:"+(h>95?'Z':(int)'A'));
print("Z>100:"+(h>100?"yes":"no"));
print("Z==95:"+(h==90?"yes":"no"));

a = "111";
switch(a) {
case 1:
    print("case 1 执行");
    break;
case 2.1:
    print("case 2.1 命中！");
    x = 100;
    print(x);
    break;
case "111":
    print("case3");
    return;
 case 'z':
        print("casez");
        return;
default:
    print("走到default分支");
}

print("switch结束，继续往下跑");

b = 4;
switch(b) {
case 10: {
    print("不会跑");
    break;
}
default:
    print("b走default");
}

print("程序末尾");
