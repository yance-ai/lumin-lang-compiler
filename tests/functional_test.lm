// functional_test.lm —— 高阶函数（map/filter/reduce + 函数作为值）+ 字符串函数
// 预期输出按行标注

// ---- 函数作为值 ----
func dbl(x) { return x * 2; }
g = dbl;                  // 函数赋值给变量
print(g(5));              // 10（动态调用）
print(type(g));           // func

// ---- map ----
a = [1, 2, 3, 4];
print(join(map(a, dbl), ","));        // 2,4,6,8
func inc(x) { return x + 1; }
print(join(map(a, inc), ","));        // 2,3,4,5
print(map(a, dbl)[1]);                // 4（高阶结果下标）
print(join(map(a, g), ","));          // 2,4,6,8（变量函数作高阶参数）

// ---- filter ----
func is_even(x) { return x % 2 == 0; }
print(join(filter(a, is_even), ",")); // 2,4
func big(x) { return x > 2; }
print(join(filter(a, big), ","));     // 3,4

// ---- reduce ----
func add_all(x, y) { return x + y; }
print(reduce(a, add_all, 0));         // 10
print(reduce(a, add_all, 100));       // 110

// ---- 字符串函数 ----
print(strip("  hello  "));            // hello
print(startswith("hello", "he"));     // true
print(startswith("hello", "x"));      // false
print(endswith("hello", "lo"));       // true
print(endswith("hello", "x"));        // false
