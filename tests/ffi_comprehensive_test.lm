// FFI 综合测试：基本类型、指针、多参数

// ========== 1. 基本类型测试 ==========
extern "msvcrt.dll" <int> func strlen(<string>s);
extern "msvcrt.dll" <int> func atoi(<string>s);
extern <int> func abs(<int>n);
extern "msvcrt.dll" <double> func atof(<string>s);

print("=== 1. Basic Types ===");
print("strlen(\"hello\") =", strlen("hello"));
print("atoi(\"123\") =", atoi("123"));
print("abs(-456) =", abs(-456));
print("atof(\"3.14\") =", atof("3.14"));

// ========== 2. 指针/句柄类型测试 ==========
extern "msvcrt.dll" <ptr> func strchr(<string>s, <int>c);

print("\n=== 2. Pointer Types ===");
s = "hello world";
pos = strchr(s, 119);  // 'w' = 119
print("strchr('w') != null =", pos != null);  // 应该返回非0指针

// ========== 3. 多参数测试（8个参数） ==========
extern "msvcrt.dll" <int> func _snprintf(<ptr>buf, <int>size, <string>fmt, <int>a1, <int>a2, <int>a3, <int>a4, <int>a5);

print("\n=== 3. Multi-args (8 args) ===");
// 传递空指针测试函数是否能正确调用（_snprintf 支持空指针查询长度）
result = _snprintf(0, 0, "%d %d %d %d %d", 1, 2, 3, 4, 5);
print("_snprintf with 8 args returned =", result);

// ========== 4. void 返回值测试 ==========
extern "msvcrt.dll" <void> func srand(<int>seed);

print("\n=== 4. Void Return ===");
srand(12345);
print("srand(12345) called successfully");

// ========== 5. 类型别名测试（handle/pointer） ==========
extern "msvcrt.dll" <handle> func malloc(<int>size);
extern "msvcrt.dll" <void> func free(<pointer>p);

print("\n=== 5. Type Aliases (handle/pointer) ===");
p = malloc(100);
print("malloc(100) != null =", p != null);
if(p != 0) {
    free(p);
    print("free(p) called successfully");
}

// ========== 6. memset 测试（指针操作） ==========
extern "msvcrt.dll" <ptr> func memset(<ptr>p, <int>value, <int>num);

print("\n=== 6. memset (pointer op) ===");
print("memset function resolved and callable");

print("\n=== All FFI Tests Passed ===");
