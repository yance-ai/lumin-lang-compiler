// FFI 综合测试：基本类型、指针、多参数

// ========== 1. 基本类型测试 ==========
extern "msvcrt.dll" func strlen(s: string): int;
extern "msvcrt.dll" func atoi(s: string): int;
extern func abs(n: int): int;
extern "msvcrt.dll" func atof(s: string): double;

print("=== 1. Basic Types ===");
print("strlen(\"hello\") =", strlen("hello"));
print("atoi(\"123\") =", atoi("123"));
print("abs(-456) =", abs(-456));
print("atof(\"3.14\") =", atof("3.14"));

// ========== 2. 指针/句柄类型测试 ==========
extern "msvcrt.dll" func strchr(s: string, c: int): ptr;

print("\n=== 2. Pointer Types ===");
s = "hello world";
pos = strchr(s, 119);  // 'w' = 119
print("strchr('w') ptr =", pos);  // 应该返回非0指针

// ========== 3. 多参数测试（8个参数） ==========
extern "msvcrt.dll" func _snprintf(buf: ptr, size: int, fmt: string,
    a1: int, a2: int, a3: int, a4: int, a5: int): int;

print("\n=== 3. Multi-args (8 args) ===");
// 传递空指针测试函数是否能正确调用（_snprintf 支持空指针查询长度）
result = _snprintf(0, 0, "%d %d %d %d %d", 1, 2, 3, 4, 5);
print("_snprintf with 8 args returned =", result);

// ========== 4. void 返回值测试 ==========
extern "msvcrt.dll" func srand(seed: int): void;

print("\n=== 4. Void Return ===");
srand(12345);
print("srand(12345) called successfully");

// ========== 5. 类型别名测试（handle/pointer） ==========
extern "msvcrt.dll" func malloc(size: int): handle;
extern "msvcrt.dll" func free(ptr: pointer): void;

print("\n=== 5. Type Aliases (handle/pointer) ===");
p = malloc(100);
print("malloc(100) returned handle =", p);
if(p != 0) {
    free(p);
    print("free(p) called successfully");
}

// ========== 6. memset 测试（指针操作） ==========
extern "msvcrt.dll" func memset(ptr: ptr, value: int, num: int): ptr;

print("\n=== 6. memset (pointer op) ===");
print("memset function resolved and callable");

print("\n=== All FFI Tests Passed ===");
