// closure_test.lm —— 闭包局部变量捕获（引用语义）测试
//
// 运行：./bin/lumyr tests/closure_test.lm
// 预期逐行输出见文末注释。编译通道（-c）暂不支持闭包捕获，故仅 VM 通道验证。

// 1. 基本闭包捕获：make_counter 返回独立计数器
func make_counter() {
    count = 0;
    return func() {
        count = count + 1;
        return count;
    };
}
c1 = make_counter();
c2 = make_counter();
print(c1());   // 1
print(c1());   // 2
print(c2());   // 1
print(c1());   // 3

// 2. 闭包修改捕获变量后外层可见（双向引用）
func mkgetter() {
    x = 10;
    getter = func() { return x; };
    setter = func(v) { x = v; };
    return [getter, setter];
}
gs = mkgetter();
print(gs[0]());  // 10
gs[1](20);
print(gs[0]());  // 20

// 3. 闭包作为参数传递（高阶函数）
func apply(f, n) { return f(n); }
dbl = func(x) { return x * 2; };
print(apply(dbl, 21));  // 42

// 4. 嵌套闭包：内层 lambda 捕获外层 lambda 的变量
func outer() {
    a = 100;
    return func() {
        b = a + 1;
        return func() { return a + b; };
    };
}
f = outer();
g = f();
print(g());  // 201

// 5. 闭包与循环：引用语义，所有闭包共享同一循环变量（经典陷阱）
func make_adders() {
    fs = [];
    for(i = 0; i < 3; i = i + 1) {
        adder = func(x) { return x + i; };
        fs = add(fs, adder);
    }
    return fs;
}
adds = make_adders();
print(adds[0](0));  // 3（循环结束 i=3，全部共享）
print(adds[1](0));  // 3
print(adds[2](0));  // 3

// 6. 闭包中调用其他函数 + 多变量捕获
func helper(v) { return v * v; }
func mkpair(a, b) {
    return func() { return helper(a) + helper(b); };
}
p = mkpair(3, 4);
print(p());  // 25
